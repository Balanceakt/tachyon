@@ -0,0 +1,46 @@
+package dev.tachyon.api;
+
+import com.google.common.base.Preconditions;
+import org.jetbrains.annotations.ApiStatus;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Einstiegspunkt der Tachyon-API.
+ * <p>
+ * Pruefen, ob der Server Tachyon ist: {@link #isAvailable()}.
+ */
+public final class TachyonAPI {
+
+    private static TachyonWorlds worlds;
+
+    private TachyonAPI() {
+    }
+
+    /**
+     * @return true, wenn der Server Tachyon ist und die API bereitsteht
+     */
+    public static boolean isAvailable() {
+        return worlds != null;
+    }
+
+    /**
+     * @return der World-Manager
+     * @throws IllegalStateException wenn der Server nicht Tachyon ist
+     */
+    @NotNull
+    public static TachyonWorlds worlds() {
+        Preconditions.checkState(worlds != null, "Tachyon-API nicht verfuegbar (laeuft der Server mit Tachyon?)");
+        return worlds;
+    }
+
+    /**
+     * Wird vom Server beim Start gesetzt. Nicht von Plugins aufrufen.
+     *
+     * @param implementation Implementierung des World-Managers
+     */
+    @ApiStatus.Internal
+    public static void setWorlds(@Nullable TachyonWorlds implementation) {
+        worlds = implementation;
+    }
+}
