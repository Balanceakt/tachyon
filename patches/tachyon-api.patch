+    private static PluginDescriptionFile awaitDescription(@Nullable java.util.concurrent.CompletableFuture<PluginDescriptionFile> future, @NotNull PluginLoader loader, @NotNull File file) throws InvalidDescriptionException {
+        if (future == null) {
+            return loader.getPluginDescription(file);
+        }
+        try {
+            return future.join();
+        } catch (java.util.concurrent.CompletionException ex) {
+            if (ex.getCause() instanceof InvalidDescriptionException ide) {
+                throw ide;
+            }
+            if (ex.getCause() instanceof RuntimeException re) {
+                throw re;
+            }
+            throw ex;
+        }
+    }
