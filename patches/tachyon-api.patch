@@ -0,0 +1,46 @@
+package dev.tachyon.api;
+
+import org.bukkit.World;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.world.WorldEvent;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * Wird ausgeloest, sobald eine vom Tachyon World-Manager erstellte oder geladene Welt
+ * bereit ist, also der Spawnbereich fertig generiert wurde.
+ */
+public class TachyonWorldReadyEvent extends WorldEvent {
+
+    private static final HandlerList HANDLERS = new HandlerList();
+    private final boolean created;
+
+    /**
+     * @param world die Welt
+     * @param created true, wenn die Welt neu erstellt (und nicht nur geladen) wurde
+     */
+    public TachyonWorldReadyEvent(@NotNull World world, boolean created) {
+        super(world);
+        this.created = created;
+    }
+
+    /**
+     * @return true, wenn die Welt neu erstellt wurde
+     */
+    public boolean isCreated() {
+        return created;
+    }
+
+    @NotNull
+    @Override
+    public HandlerList getHandlers() {
+        return HANDLERS;
+    }
+
+    /**
+     * @return Handler-Liste dieses Events
+     */
+    @NotNull
+    public static HandlerList getHandlerList() {
+        return HANDLERS;
+    }
+}
diff --git a/src/main/java/dev/tachyon/api/TachyonWorlds.java b/src/main/java/dev/tachyon/api/TachyonWorlds.java
new file mode 100644
index 00000000..e127fbc1
