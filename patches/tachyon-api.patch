@@ -0,0 +1,120 @@
+package dev.tachyon.api;
+
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import org.bukkit.World;
+import org.bukkit.entity.Player;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Der eingebaute World-Manager von Tachyon fuer Plugins.
+ * <p>
+ * Alle Methoden muessen auf dem Server-Thread aufgerufen werden. Welten werden ohne
+ * Server-Haenger erstellt: Die Futures werden auf dem Server-Thread abgeschlossen,
+ * sobald der Spawnbereich generiert ist.
+ *
+ * <pre>{@code
+ * TachyonWorlds worlds = TachyonAPI.worlds();
+ * worlds.createWorld(WorldOptions.builder("arena").type(WorldOptions.Type.VOID).build())
+ *       .thenAccept(world -> player.teleport(world.getSpawnLocation()));
+ * }</pre>
+ */
+public interface TachyonWorlds {
+
+    /**
+     * Erstellt eine neue Welt (oder laedt sie, falls der Ordner schon existiert).
+     *
+     * @param options Einstellungen der Welt
+     * @return wird mit der Welt abgeschlossen, sobald sie bereit ist
+     */
+    @NotNull
+    CompletableFuture<World> createWorld(@NotNull WorldOptions options);
+
+    /**
+     * Laedt einen vorhandenen Weltordner.
+     *
+     * @param name Name des Weltordners
+     * @return wird mit der Welt abgeschlossen, sobald sie bereit ist
+     */
+    @NotNull
+    CompletableFuture<World> loadWorld(@NotNull String name);
+
+    /**
+     * Entlaedt eine Welt. Spieler darin werden zum Spawn der Hauptwelt gebracht.
+     *
+     * @param name Name der Welt
+     * @param save vorher speichern
+     * @return true bei Erfolg
+     */
+    boolean unloadWorld(@NotNull String name, boolean save);
+
+    /**
+     * Entlaedt eine Welt und loescht ihren Ordner im Hintergrund.
+     *
+     * @param name Name der Welt
+     * @return wird abgeschlossen, sobald der Ordner geloescht ist
+     */
+    @NotNull
+    CompletableFuture<Void> deleteWorld(@NotNull String name);
+
+    /**
+     * Kopiert eine (entladene) Welt im Hintergrund und laedt die Kopie.
+     *
+     * @param source Name der Quellwelt
+     * @param target Name der neuen Welt
+     * @return wird mit der neuen Welt abgeschlossen, sobald sie bereit ist
+     */
+    @NotNull
+    CompletableFuture<World> cloneWorld(@NotNull String source, @NotNull String target);
+
+    /**
+     * @param world eine geladene Welt
+     * @return true, wenn der Spawnbereich fertig generiert ist
+     */
+    boolean isReady(@NotNull World world);
+
+    /**
+     * @param world eine geladene Welt
+     * @return wird abgeschlossen, sobald die Welt bereit ist (sofort, wenn sie es schon ist)
+     */
+    @NotNull
+    CompletableFuture<World> whenReady(@NotNull World world);
+
+    /**
+     * Teleportiert einen Spieler zum Spawn der Welt, sobald sie bereit ist.
+     *
+     * @param player Spieler
+     * @param world Zielwelt
+     */
+    void teleportWhenReady(@NotNull Player player, @NotNull World world);
+
+    /**
+     * Startet die Vorgenerierung um den Spawn. Sie pausiert automatisch bei Lag.
+     *
+     * @param world Welt
+     * @param radiusBlocks Radius in Bloecken
+     * @return null bei Erfolg, sonst eine Fehlermeldung
+     */
+    @Nullable
+    String startPregen(@NotNull World world, int radiusBlocks);
+
+    /**
+     * Stoppt eine laufende Vorgenerierung.
+     *
+     * @return true, wenn eine lief
+     */
+    boolean stopPregen();
+
+    /**
+     * @return Namen aller Welten, die der World-Manager verwaltet (tachyon.yml)
+     */
+    @NotNull
+    Set<String> getManagedWorlds();
+
+    /**
+     * @param name Name der Welt
+     * @param autoload beim Serverstart automatisch laden
+     */
+    void setAutoload(@NotNull String name, boolean autoload);
+}
