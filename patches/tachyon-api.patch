@@ -0,0 +1,134 @@
+package dev.tachyon.api;
+
+import com.google.common.base.Preconditions;
+import org.bukkit.World;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Einstellungen fuer eine neue Welt im Tachyon World-Manager.
+ *
+ * @param name Name des Weltordners (A-Z, a-z, 0-9, _ und -)
+ * @param environment Umgebung (Oberwelt, Nether, End)
+ * @param type Art der Generierung
+ * @param seed Seed oder null fuer zufaellig
+ * @param structures Strukturen (Doerfer usw.) generieren
+ * @param autoload beim Serverstart automatisch laden
+ */
+public record WorldOptions(@NotNull String name, @NotNull World.Environment environment, @NotNull Type type, @Nullable Long seed, boolean structures, boolean autoload) {
+
+    /**
+     * Art der Generierung.
+     */
+    public enum Type {
+        /** Normale Welt. */
+        NORMAL,
+        /** Flachland. */
+        FLAT,
+        /** Zerkluftet. */
+        AMPLIFIED,
+        /** Grosse Biome. */
+        LARGE_BIOMES,
+        /** Leere Welt mit einem Block unter dem Spawn. */
+        VOID
+    }
+
+    /**
+     * Prueft die Werte.
+     *
+     * @param name Name des Weltordners
+     * @param environment Umgebung
+     * @param type Art der Generierung
+     * @param seed Seed oder null
+     * @param structures Strukturen generieren
+     * @param autoload beim Start laden
+     */
+    public WorldOptions {
+        Preconditions.checkArgument(name != null && name.matches("[A-Za-z0-9_\\-]{1,64}"), "Ungueltiger Weltname: %s", name);
+        Preconditions.checkArgument(environment != null, "environment");
+        Preconditions.checkArgument(type != null, "type");
+    }
+
+    /**
+     * @param name Name des Weltordners
+     * @return neuer Builder mit Standardwerten (Oberwelt, normal, zufaelliger Seed, Strukturen, Autoload)
+     */
+    @NotNull
+    public static Builder builder(@NotNull String name) {
+        return new Builder(name);
+    }
+
+    /**
+     * Builder fuer {@link WorldOptions}.
+     */
+    public static final class Builder {
+        private final String name;
+        private World.Environment environment = World.Environment.NORMAL;
+        private Type type = Type.NORMAL;
+        private Long seed;
+        private boolean structures = true;
+        private boolean autoload = true;
+
+        private Builder(@NotNull String name) {
+            this.name = name;
+        }
+
+        /**
+         * @param environment Umgebung
+         * @return dieser Builder
+         */
+        @NotNull
+        public Builder environment(@NotNull World.Environment environment) {
+            this.environment = environment;
+            return this;
+        }
+
+        /**
+         * @param type Art der Generierung
+         * @return dieser Builder
+         */
+        @NotNull
+        public Builder type(@NotNull Type type) {
+            this.type = type;
+            return this;
+        }
+
+        /**
+         * @param seed Seed oder null fuer zufaellig
+         * @return dieser Builder
+         */
+        @NotNull
+        public Builder seed(@Nullable Long seed) {
+            this.seed = seed;
+            return this;
+        }
+
+        /**
+         * @param structures Strukturen generieren
+         * @return dieser Builder
+         */
+        @NotNull
+        public Builder structures(boolean structures) {
+            this.structures = structures;
+            return this;
+        }
+
+        /**
+         * @param autoload beim Serverstart automatisch laden
+         * @return dieser Builder
+         */
+        @NotNull
+        public Builder autoload(boolean autoload) {
+            this.autoload = autoload;
+            return this;
+        }
+
+        /**
+         * @return fertige Einstellungen
+         */
+        @NotNull
+        public WorldOptions build() {
+            return new WorldOptions(name, environment, type, seed, structures, autoload);
+        }
+    }
+}
