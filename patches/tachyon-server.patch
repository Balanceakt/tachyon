+    /** @return Fehlermeldung oder null bei Erfolg */
+    public String unload(String name, boolean save) {
+        World world = Bukkit.getWorld(name);
+        if (world == null) {
+            return t("wm.err.not_loaded", name);
+        }
+        World main = Bukkit.getWorlds().get(0);
+        if (world.equals(main)) {
+            return t("wm.err.main_world");
+        }
+        for (Player p : world.getPlayers()) {
+            p.teleport(safeSpawn(main));
+            p.sendMessage("\u00A7e" + t("wm.msg.unload_teleport", name));
+        }
+        if (!Bukkit.unloadWorld(world, save)) {
+            return t("wm.err.unload_failed", name);
+        }
+        states.remove(name.toLowerCase(Locale.ROOT));
+        return null;
+    }
+
+    public boolean isProtected(String name) {
+        String main = Bukkit.getWorlds().get(0).getName();
+        return name.equalsIgnoreCase(main) || name.equalsIgnoreCase(main + "_nether") || name.equalsIgnoreCase(main + "_the_end");
+    }
+
+    public void delete(String name, Consumer<String> onDone, Consumer<String> onError) {
+        if (isProtected(name)) {
+            onError.accept(t("wm.err.protected"));
+            return;
+        }
+        if (Bukkit.getWorld(name) != null) {
+            String err = unload(name, false);
+            if (err != null) {
+                onError.accept(err);
+                return;
+            }
+        }
+        File folder = worldFolder(name);
+        config.set("worlds." + name, null);
+        saveConfig();
+        if (!folder.exists()) {
+            onDone.accept(t("wm.msg.removed", name));
+            return;
+        }
+        io.execute(() -> {
+            try {
+                deleteRecursive(folder.toPath());
+                mainQueue.add(() -> onDone.accept(t("wm.msg.deleted", name)));
+            } catch (IOException e) {
+                mainQueue.add(() -> onError.accept(t("wm.err.delete_failed", e.getMessage())));
+            }
+        });
+    }
+
+    public void cloneWorld(String source, String target, Consumer<World> onReady, Consumer<String> onError) {
+        if (!VALID_NAME.matcher(target).matches()) {
+            onError.accept(t("wm.err.invalid_target"));
+            return;
+        }
+        if (!worldExistsOnDisk(source)) {
+            onError.accept(t("wm.err.source_missing", source));
+            return;
+        }
+        if (Bukkit.getWorld(source) != null) {
+            onError.accept(t("wm.err.source_loaded", source, source));
+            return;
+        }
+        if (worldFolder(target).exists()) {
+            onError.accept(t("wm.err.target_exists", target));
+            return;
+        }
+        WorldSpec srcSpec = storedSpec(source);
+        WorldSpec spec = srcSpec != null ? srcSpec.withName(target) : new WorldSpec(target, World.Environment.NORMAL, WorldSpec.Type.NORMAL, null, true);
+        Path from = worldFolder(source).toPath();
+        Path to = worldFolder(target).toPath();
+        io.execute(() -> {
+            try {
+                copyRecursive(from, to);
+                mainQueue.add(() -> {
+                    config.set("worlds." + target + ".spawn-resolved", true);
+                    loadOrCreate(spec, true, onReady, onError);
+                });
+            } catch (IOException e) {
+                mainQueue.add(() -> onError.accept(t("wm.err.copy_failed", e.getMessage())));
+            }
+        });
+    }
+
+    private static void deleteRecursive(Path root) throws IOException {
+        Files.walkFileTree(root, new SimpleFileVisitor<>() {
+            @Override
+            public FileVisitResult visitFile(Path file, BasicFileAttributes attrs) throws IOException {
+                Files.delete(file);
+                return FileVisitResult.CONTINUE;
+            }
+
+            @Override
+            public FileVisitResult postVisitDirectory(Path dir, IOException exc) throws IOException {
+                Files.delete(dir);
+                return FileVisitResult.CONTINUE;
+            }
+        });
+    }
+
+    private static void copyRecursive(Path from, Path to) throws IOException {
+        Files.walkFileTree(from, new SimpleFileVisitor<>() {
+            @Override
+            public FileVisitResult preVisitDirectory(Path dir, BasicFileAttributes attrs) throws IOException {
+                Files.createDirectories(to.resolve(from.relativize(dir)));
+                return FileVisitResult.CONTINUE;
+            }
+
+            @Override
+            public FileVisitResult visitFile(Path file, BasicFileAttributes attrs) throws IOException {
+                String n = file.getFileName().toString();
+                if (n.equals("session.lock") || n.equals("uid.dat")) {
+                    return FileVisitResult.CONTINUE; // neue Welt bekommt eigene UID / eigenes Lock
+                }
+                Files.copy(file, to.resolve(from.relativize(file)), StandardCopyOption.COPY_ATTRIBUTES);
+                return FileVisitResult.CONTINUE;
+            }
+        });
+    }
+
+    /** Alle Weltordner (mit level.dat) im Server-Verzeichnis. */
+    public List<String> worldFoldersOnDisk() {
+        List<String> out = new ArrayList<>();
+        File[] files = Bukkit.getWorldContainer().listFiles(File::isDirectory);
+        if (files != null) {
+            for (File f : files) {
+                if (new File(f, "level.dat").isFile()) {
+                    out.add(f.getName());
+                }
+            }
+        }
+        Collections.sort(out);
+        return out;
+    }
+
+    // ------------------------------------------------------------------ Pregenerator
+
+    /** @return Fehlermeldung oder null */
+    public String startPregen(World world, int radiusBlocks, Consumer<String> progress) {
+        if (pregen != null) {
+            return t("wm.pregen.running", pregen.world.getName());
+        }
+        int radius = Math.max(1, radiusBlocks >> 4);
+        Location c = world.getSpawnLocation();
+        pregen = new PregenTask(world, new ChunkPos(c.getBlockX() >> 4, c.getBlockZ() >> 4), radius, progress);
+        logger.info("[WorldManager] " + t("wm.pregen.started.log", world.getName(), radiusBlocks, pregen.total));
+        return null;
+    }
+
+    public String stopPregen() {
+        if (pregen == null) {
+            return null;
+        }
+        String status = pregen.status();
+        pregen.cancelled = true;
+        TachyonConsole.liveDone("pregen");
+        pregen = null;
+        return status;
+    }
+
+    public String pregenStatus() {
+        return pregen == null ? null : pregen.status();
+    }
+
+    private final class PregenTask {
+        final World world;
+        final ServerLevel level;
+        final ChunkPos center;
+        final int radius;
+        final long total;
+        final Consumer<String> progress;
+        final long startNanos = System.nanoTime();
+        int ring;
+        int ringIndex;
+        List<ChunkPos> ringPositions;
+        int inFlight;
+        long done;
+        int lastReportedPercent = -1;
+        int liveTick;
+        long pausedTicks;
+        boolean cancelled;
+
+        PregenTask(World world, ChunkPos center, int radius, Consumer<String> progress) {
+            this.world = world;
+            this.level = ((CraftWorld) world).getHandle();
+            this.center = center;
+            this.radius = radius;
+            this.total = (long) (radius * 2 + 1) * (radius * 2 + 1);
+            this.progress = progress;
+            this.ringPositions = List.of(center);
+        }
+
+        /** Naechster Chunk in Ringen um das Zentrum (ohne riesige Liste im Speicher). */
+        private ChunkPos next() {
+            while (ringIndex >= ringPositions.size()) {
+                ring++;
+                if (ring > radius) {
+                    return null;
+                }
+                ringIndex = 0;
+                List<ChunkPos> list = new ArrayList<>(8 * ring);
+                for (int d = -ring; d < ring; d++) {
+                    list.add(new ChunkPos(center.x() + d, center.z() - ring));
+                    list.add(new ChunkPos(center.x() + ring, center.z() + d));
+                    list.add(new ChunkPos(center.x() - d, center.z() + ring));
+                    list.add(new ChunkPos(center.x() - ring, center.z() - d));
+                }
+                ringPositions = list;
+            }
+            return ringPositions.get(ringIndex++);
+        }
+
+        void tick(boolean slowTick) {
+            if (cancelled) {
+                return;
+            }
+            if (Bukkit.getWorld(world.getUID()) == null) {
+                progress.accept(t("wm.pregen.aborted", world.getName()));
+                TachyonConsole.liveDone("pregen");
+                pregen = null;
+                return;
+            }
+            if (++liveTick % 5 == 0) {
+                double secs = (System.nanoTime() - startNanos) / 1e9;
+                double rate = secs > 0 ? done / secs : 0;
+                long remaining = rate > 0 ? (long) ((total - done) / rate) : -1;
+                TachyonConsole.live("pregen", done / (double) total, t("live.pregen", world.getName(), String.format(Locale.ROOT, "%.0f", rate),
+                        remaining < 0 ? "?" : t("wm.pregen.eta", remaining / 60, remaining % 60)), secs);
+            }
+            if (slowTick) {
+                pausedTicks++;
+                return; // Server ist gerade ausgelastet - Spieler gehen vor
+            }
+            while (inFlight < pregenParallel) {
+                ChunkPos pos = next();
+                if (pos == null) {
+                    break;
+                }
+                inFlight++;
+                level.getChunkSource().addTicketAndLoadWithRadius(TicketType.TACHYON_PREGEN, pos, 0)
+                        .whenComplete((r, t) -> mainQueue.add(this::onChunkDone));
+            }
+        }
+
+        private void onChunkDone() {
+            inFlight--;
+            done++;
+            if (cancelled) {
+                return;
+            }
+            int percent = (int) (done * 100 / total);
+            if (done >= total) {
+                double secs = (System.nanoTime() - startNanos) / 1e9;
+                String msg = t("wm.pregen.done", world.getName(), total, secs);
+                TachyonConsole.liveDone("pregen");
+                logger.info("[WorldManager] \u2714 " + msg);
+                progress.accept(msg);
+                pregen = null;
+                return;
+            }
+            if (percent / 5 != lastReportedPercent / 5) {
+                lastReportedPercent = percent;
+                String msg = status();
+                if (!TachyonConsole.liveSupported()) {
+                    logger.info("[WorldManager] " + msg); // ohne Live-Balken (Panels) weiterhin alle 5 %
+                }
+                progress.accept(msg);
+            }
+        }
+
+        String status() {
+            double secs = (System.nanoTime() - startNanos) / 1e9;
+            double rate = secs > 0 ? done / secs : 0;
+            long remaining = rate > 0 ? (long) ((total - done) / rate) : -1;
+            return t("wm.pregen.status", world.getName(), done, total, done * 100 / total, rate,
+                    remaining < 0 ? "?" : t("wm.pregen.eta", remaining / 60, remaining % 60),
+                    pausedTicks > 0 ? t("wm.pregen.paused", pausedTicks) : "");
+        }
+    }
+
+    /** Gespeicherte Einstellungen einer Welt, optional mit Umgebung aus einem Befehl ("normal", "nether", "end"). */
+    public WorldSpec specFor(String name, String envArg) {
+        WorldSpec stored = storedSpec(name);
+        if (stored != null && envArg == null) {
+            return stored;
+        }
+        World.Environment env = World.Environment.NORMAL;
+        if (envArg != null) {
+            switch (envArg.toLowerCase(Locale.ROOT)) {
+                case "nether" -> env = World.Environment.NETHER;
+                case "end", "the_end" -> env = World.Environment.THE_END;
+                default -> env = World.Environment.NORMAL;
+            }
+        }
+        return new WorldSpec(name, env, stored != null ? stored.type() : WorldSpec.Type.NORMAL, null, true);
+    }
+
+    // ------------------------------------------------------------------ Tachyon-API fuer Plugins
+
+    /** Implementierung von {@link TachyonWorlds}: duenne Schicht ueber dem World-Manager. */
+    private final class Api implements TachyonWorlds {
+
+        private CompletableFuture<World> future(java.util.function.BiConsumer<Consumer<World>, Consumer<String>> action) {
+            CompletableFuture<World> f = new CompletableFuture<>();
+            action.accept(f::complete, msg -> f.completeExceptionally(new IllegalStateException(msg)));
+            return f;
+        }
+
+        @Override
+        public CompletableFuture<World> createWorld(WorldOptions o) {
+            WorldSpec spec = new WorldSpec(o.name(), o.environment(), WorldSpec.Type.valueOf(o.type().name()), o.seed(), o.structures());
+            return future((ok, err) -> loadOrCreate(spec, o.autoload(), ok, err));
+        }
+
+        @Override
+        public CompletableFuture<World> loadWorld(String name) {
+            if (!worldExistsOnDisk(name) && Bukkit.getWorld(name) == null) {
+                return CompletableFuture.failedFuture(new IllegalStateException(t("cmd.tp.missing", name)));
+            }
+            return future((ok, err) -> loadOrCreate(specFor(name, null), true, ok, err));
+        }
+
+        @Override
+        public boolean unloadWorld(String name, boolean save) {
+            return unload(name, save) == null;
+        }
+
+        @Override
+        public CompletableFuture<Void> deleteWorld(String name) {
+            CompletableFuture<Void> f = new CompletableFuture<>();
+            delete(name, msg -> f.complete(null), msg -> f.completeExceptionally(new IllegalStateException(msg)));
+            return f;
+        }
+
+        @Override
+        public CompletableFuture<World> cloneWorld(String source, String target) {
+            return future((ok, err) -> WorldManager.this.cloneWorld(source, target, ok, err));
+        }
+
+        @Override
+        public boolean isReady(World world) {
+            return WorldManager.this.isReady(world);
+        }
+
+        @Override
+        public CompletableFuture<World> whenReady(World world) {
+            CompletableFuture<World> f = new CompletableFuture<>();
+            WorldManager.this.whenReady(world, f::complete);
+            return f;
+        }
+
+        @Override
+        public void teleportWhenReady(Player player, World world) {
+            WorldManager.this.teleportWhenReady(player, world);
+        }
+
+        @Override
+        public String startPregen(World world, int radiusBlocks) {
+            return WorldManager.this.startPregen(world, radiusBlocks, msg -> { });
+        }
+
+        @Override
+        public boolean stopPregen() {
+            return WorldManager.this.stopPregen() != null;
+        }
+
+        @Override
+        public Set<String> getManagedWorlds() {
+            return managedWorlds();
+        }
+
+        @Override
+        public void setAutoload(String name, boolean autoload) {
+            WorldManager.this.setAutoload(name, autoload);
+        }
+    }
+
+    private static final class LoadState {
+        boolean ready;
+        boolean created;
+        boolean quiet;
+        boolean searching;
+        int candidate;
+        World world;
+        ChunkPos preloadCenter;
+        long startNanos = System.nanoTime();
+        double mainThreadMs;
+        final List<Consumer<World>> waiters = new ArrayList<>();
+    }
+
+    // ------------------------------------------------------------------ WorldSpec
+
+    public record WorldSpec(String name, World.Environment environment, Type type, Long seed, boolean structures) {
+
+        public enum Type {
+            NORMAL, FLAT, AMPLIFIED, LARGE_BIOMES, VOID;
+
+            public static Type parse(String s) {
+                if (s == null) {
+                    return null;
+                }
+                try {
+                    return valueOf(s.toUpperCase(Locale.ROOT).replace('-', '_'));
+                } catch (IllegalArgumentException e) {
+                    return null;
+                }
+            }
+        }
+
+        public WorldSpec withName(String newName) {
+            return new WorldSpec(newName, environment, type, seed, structures);
+        }
+
+        public WorldCreator toCreator() {
+            WorldCreator wc = new WorldCreator(name).environment(environment).generateStructures(structures);
+            if (seed != null) {
+                wc.seed(seed);
+            }
+            switch (type) {
+                case FLAT -> wc.type(WorldType.FLAT);
+                case AMPLIFIED -> wc.type(WorldType.AMPLIFIED);
+                case LARGE_BIOMES -> wc.type(WorldType.LARGE_BIOMES);
+                case VOID -> wc.generator(new VoidGenerator());
+                default -> wc.type(WorldType.NORMAL);
+            }
+            return wc;
+        }
+    }
+}
