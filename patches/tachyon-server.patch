+    public void reloadConfig() {
+        config = YamlConfiguration.loadConfiguration(configFile);
+        config.options().setHeader(List.of(t("wm.config.header").split("\n")));
+        config.addDefault("startup.fast-start", true);
+        config.addDefault("world-manager.fast-world-creation-for-plugins", false);
+        config.addDefault("world-manager.spawn-preload-radius", 2);
+        config.addDefault("world-manager.autoload-interval-ticks", 20);
+        config.addDefault("world-manager.pregen-parallel-chunks", Math.max(4, Runtime.getRuntime().availableProcessors() * 2));
+        config.addDefault("world-manager.unload-idle-minutes", 10);
+        config.addDefault("performance.dynamic-simulation-distance", true);
+        config.addDefault("performance.min-simulation-distance", 4);
+        config.addDefault("performance.mspt-high", 40.0);
+        config.addDefault("performance.mspt-low", 25.0);
+        config.addDefault("performance.release-ram-when-empty", true);
+        config.addDefault("sleep-mode.enabled", true);
+        config.addDefault("sleep-mode.after-minutes", 15);
+        config.options().copyDefaults(true);
+        fastForPlugins = config.getBoolean("world-manager.fast-world-creation-for-plugins");
+        fastStartup = config.getBoolean("startup.fast-start");
+        preloadRadius = Math.max(0, Math.min(8, config.getInt("world-manager.spawn-preload-radius")));
+        if (Runtime.getRuntime().maxMemory() < 400L * 1024 * 1024) {
+            preloadRadius = 0; // sehr wenig RAM: nur den Spawn-Chunk vorladen, damit es nicht knapp wird
+        }
+        autoloadInterval = Math.max(1, config.getInt("world-manager.autoload-interval-ticks"));
+        pregenParallel = Math.max(1, Math.min(256, config.getInt("world-manager.pregen-parallel-chunks")));
+        unloadIdleMinutes = Math.max(0, config.getInt("world-manager.unload-idle-minutes"));
+        dev.tachyon.perf.DynamicPerformance.configure(config.getBoolean("performance.dynamic-simulation-distance"),
+                config.getInt("performance.min-simulation-distance"), config.getDouble("performance.mspt-high"), config.getDouble("performance.mspt-low"));
+        dev.tachyon.perf.MemoryManager.configure(config.getBoolean("performance.release-ram-when-empty"),
+                config.getBoolean("sleep-mode.enabled"), config.getInt("sleep-mode.after-minutes"));
+        saveConfig();
