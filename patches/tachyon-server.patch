+/**
+ * Tachyon World-Manager.
+ *
+ * Vanilla/Spigot erzeugt neue Welten komplett auf dem Main-Thread: Der Spawnpunkt wird
+ * in einer 11x11-Chunk-Spirale gesucht und jeder Chunk dabei synchron generiert. Waehrenddessen
+ * tickt der Server nicht, alle Spieler frieren ein.
+ *
+ * Der World-Manager legt die Welt sofort an (provisorischer Spawn, keine Chunk-Generierung auf
+ * dem Main-Thread) und sucht den Spawn danach Chunk fuer Chunk ueber Tickets - die eigentliche
+ * Generierung laeuft auf den Worldgen-Threads. Erst wenn der Spawnbereich fertig ist, gilt die
+ * Welt als "bereit" und wartende Teleports werden ausgefuehrt.
+ */
+public final class WorldManager {
+
+    public static final Pattern VALID_NAME = Pattern.compile("[A-Za-z0-9_\\-]{1,64}");
+    private static final int SPAWN_SEARCH_RADIUS = 5; // wie Vanilla: 11x11 Chunks
+
+    private static WorldManager instance;
+    /** >0 solange der World-Manager selbst gerade createWorld aufruft (nur Main-Thread). */
+    private static int managerDepth;
+
+    private final Logger logger = Logger.getLogger("Tachyon");
+    private final File configFile;
+    private YamlConfiguration config;
+
+    private final Map<String, LoadState> states = new HashMap<>();
+    private final Set<ServerLevel> provisionalSpawn = Collections.newSetFromMap(new IdentityHashMap<>());
+    private final ConcurrentLinkedQueue<Runnable> mainQueue = new ConcurrentLinkedQueue<>();
+    private final Deque<String> autoloadQueue = new ArrayDeque<>();
+    private final ExecutorService io = Executors.newSingleThreadExecutor(r -> {
+        Thread t = new Thread(r, "Tachyon-World-IO");
+        t.setDaemon(true);
+        return t;
+    });
+
+    private static final boolean AOT_TRAINING = Boolean.getBoolean("tachyon.aotTraining");
+    private boolean started;
+    private int ticks;
+    private int trainingTicks;
+
+    // Einstellungen
+    private boolean fastForPlugins;
+    private boolean fastStartup;
+    private int preloadRadius;
+    private int autoloadInterval;
+    private int pregenParallel;
+
+    // Pregenerator
+    private PregenTask pregen;
+    private long lastTickNanos;
+
+    private WorldManager(File configFile) {
+        this.configFile = configFile;
+        reloadConfig();
+    }
+
+    // ------------------------------------------------------------------ statische Hooks (Server-Kern)
+
+    public static void init(File configFile) {
+        if (instance == null) {
+            instance = new WorldManager(configFile);
+        }
+    }
+
+    public static WorldManager get() {
+        return instance;
+    }
+
+    /**
+     * Wird von MinecraftServer#setInitialSpawn / #prepareLevels abgefragt.
+     * true = keine synchrone Spawnsuche und kein blockierendes Warten auf Chunks.
+     */
+    public static boolean isFastLoading() {
+        if (managerDepth > 0) {
+            return true;
+        }
+        WorldManager wm = instance;
+        if (wm == null) {
+            return false;
+        }
+        // Beim Serverstart (vor dem ersten Tick) gilt startup.fast-start, danach die Plugin-Einstellung.
+        return wm.started ? wm.fastForPlugins : wm.fastStartup;
+    }
+
+    /** Kern-Hook: Spawn wurde nur provisorisch gesetzt und muss asynchron gesucht werden. */
+    public static void markProvisionalSpawn(ServerLevel level) {
+        WorldManager wm = instance;
+        if (wm == null) {
+            return;
+        }
+        wm.provisionalSpawn.add(level);
+        wm.setPendingSpawn(level.getWorld().getName(), true); // falls der Server vor Ende der Suche stoppt
+        if (managerDepth == 0) {
+            // Von einem Plugin erzeugt: Spawn im naechsten Tick im Hintergrund aufloesen.
+            wm.mainQueue.add(() -> {
+                if (wm.provisionalSpawn.remove(level)) {
+                    wm.resolveSpawn(level.getWorld(), null);
+                }
+            });
+        }
+    }
+
+    /** Kern-Hook: einmal pro Server-Tick auf dem Main-Thread. */
+    public static void tickHook() {
+        WorldManager wm = instance;
+        if (wm != null) {
+            wm.tick();
+        }
+    }
+
+    public static void shutdown() {
+        WorldManager wm = instance;
+        if (wm != null) {
+            wm.io.shutdown();
+        }
+    }
+
+    // ------------------------------------------------------------------ Konfiguration
+
+    public void reloadConfig() {
+        config = YamlConfiguration.loadConfiguration(configFile);
+        config.options().setHeader(List.of(
+                "Tachyon Konfiguration",
+                "",
+                "startup.fast-start:",
+                "  true = der Server wartet beim Start nicht auf die Spawnsuche/Spawn-Chunks, sondern erledigt das",
+                "  in den ersten Sekunden nach 'Done' im Hintergrund. Spieler finden trotzdem einen sicheren Spawn.",
+                "world-manager.fast-world-creation-for-plugins:",
+                "  true = auch Welten, die Plugins (z.B. Multiverse) erstellen, werden ohne Server-Haenger angelegt.",
+                "  Der Spawnpunkt wird dann kurz nach dem Erstellen im Hintergrund gesucht.",
+                "world-manager.spawn-preload-radius: Chunks um den Spawn, die vor 'bereit' geladen werden.",
+                "world-manager.autoload-interval-ticks: Abstand zwischen zwei Welten beim automatischen Laden nach dem Start.",
+                "world-manager.pregen-parallel-chunks: so viele Chunks generiert /wm pregen gleichzeitig (pausiert automatisch bei Lag).",
+                "worlds: wird vom /wm Befehl verwaltet."));
+        config.addDefault("startup.fast-start", true);
+        config.addDefault("world-manager.fast-world-creation-for-plugins", false);
+        config.addDefault("world-manager.spawn-preload-radius", 2);
+        config.addDefault("world-manager.autoload-interval-ticks", 20);
+        config.addDefault("world-manager.pregen-parallel-chunks", Math.max(4, Runtime.getRuntime().availableProcessors() * 2));
+        config.options().copyDefaults(true);
+        fastForPlugins = config.getBoolean("world-manager.fast-world-creation-for-plugins");
+        fastStartup = config.getBoolean("startup.fast-start");
+        preloadRadius = Math.max(0, Math.min(8, config.getInt("world-manager.spawn-preload-radius")));
+        autoloadInterval = Math.max(1, config.getInt("world-manager.autoload-interval-ticks"));
+        pregenParallel = Math.max(1, Math.min(256, config.getInt("world-manager.pregen-parallel-chunks")));
+        saveConfig();
+    }
+
+    private void saveConfig() {
+        try {
+            config.save(configFile);
+        } catch (IOException e) {
+            logger.log(Level.WARNING, "Konnte " + configFile + " nicht speichern", e);
+        }
+    }
+
+    private ConfigurationSection worldSection(String name) {
+        return config.getConfigurationSection("worlds." + name);
+    }
+
+    private void storeSpec(WorldSpec spec, boolean autoload) {
+        String p = "worlds." + spec.name() + ".";
+        config.set(p + "environment", spec.environment().name());
+        config.set(p + "type", spec.type().name().toLowerCase(Locale.ROOT));
+        config.set(p + "structures", spec.structures());
+        config.set(p + "autoload", autoload);
+        saveConfig();
+    }
+
+    public WorldSpec storedSpec(String name) {
+        ConfigurationSection s = worldSection(name);
+        if (s == null) {
+            return null;
+        }
+        World.Environment env;
+        try {
+            env = World.Environment.valueOf(s.getString("environment", "NORMAL"));
+        } catch (IllegalArgumentException e) {
+            env = World.Environment.NORMAL;
+        }
+        WorldSpec.Type type = WorldSpec.Type.parse(s.getString("type", "normal"));
+        return new WorldSpec(name, env, type == null ? WorldSpec.Type.NORMAL : type, null, s.getBoolean("structures", true));
+    }
+
+    public Set<String> managedWorlds() {
+        ConfigurationSection s = config.getConfigurationSection("worlds");
+        return s == null ? Set.of() : new TreeSet<>(s.getKeys(false));
+    }
+
+    public void setAutoload(String name, boolean autoload) {
+        config.set("worlds." + name + ".autoload", autoload);
+        saveConfig();
+    }
+
+    public boolean isAutoload(String name) {
+        return config.getBoolean("worlds." + name + ".autoload", false);
+    }
+
+    // ------------------------------------------------------------------ Tick
+
+    private void tick() {
+        long now = System.nanoTime();
+        boolean slowTick = lastTickNanos != 0 && now - lastTickNanos > 55_000_000L; // letzter Tick > 55 ms
+        lastTickNanos = now;
+        if (!started) {
+            started = true;
+            for (String name : managedWorlds()) {
+                if (isAutoload(name) && Bukkit.getWorld(name) != null) {
+                    continue;
+                }
+                if (isAutoload(name)) {
+                    autoloadQueue.add(name);
+                }
+            }
+            if (!autoloadQueue.isEmpty()) {
+                logger.info("[WorldManager] Lade " + autoloadQueue.size() + " Welt(en) im Hintergrund...");
+            }
+            // Spawnsuchen fortsetzen, die beim letzten Mal durch einen Stopp unterbrochen wurden
+            for (String name : config.getStringList("internal.pending-spawn")) {
+                World w = Bukkit.getWorld(name);
+                if (w != null && !provisionalSpawn.contains(((CraftWorld) w).getHandle())) {
+                    logger.info("[WorldManager] Setze unterbrochene Spawnsuche fuer '" + name + "' fort...");
+                    resolveSpawn(w, null);
+                }
+            }
+        }
+
+        Runnable task;
+        int budget = 64;
+        while (budget-- > 0 && (task = mainQueue.poll()) != null) {
+            try {
+                task.run();
+            } catch (Throwable t) {
+                logger.log(Level.SEVERE, "[WorldManager] Fehler in Hintergrundaufgabe", t);
+            }
+        }
+
+        if (pregen != null) {
+            pregen.tick(slowTick);
+        }
+
+        // AOT-Trainingslauf (start.bat): kurz laufen lassen, damit Java den Start-Cache aufzeichnen kann, dann beenden.
+        if (AOT_TRAINING && ++trainingTicks == 200) {
+            logger.info("[Tachyon] AOT-Training abgeschlossen - Server wird beendet, Java schreibt jetzt den Start-Cache...");
+            Bukkit.shutdown();
+        }
+
+        if (!autoloadQueue.isEmpty() && ++ticks % autoloadInterval == 0) {
+            String name = autoloadQueue.poll();
+            WorldSpec spec = storedSpec(name);
+            if (spec != null && Bukkit.getWorld(name) == null) {
+                if (!worldFolder(name).isDirectory()) {
+                    logger.warning("[WorldManager] Ordner fuer Welt '" + name + "' fehlt - uebersprungen.");
+                } else {
+                    loadOrCreate(spec, w -> logger.info("[WorldManager] Welt '" + name + "' bereit."),
+                            err -> logger.warning("[WorldManager] " + err));
+                }
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ Laden / Erstellen
+
+    public File worldFolder(String name) {
+        return new File(Bukkit.getWorldContainer(), name);
+    }
+
+    public boolean worldExistsOnDisk(String name) {
+        return new File(worldFolder(name), "level.dat").isFile();
+    }
+
+    public boolean isReady(World world) {
+        LoadState st = states.get(world.getName().toLowerCase(Locale.ROOT));
+        return st == null || st.ready;
+    }
+
+    /**
+     * Laedt oder erstellt eine Welt ohne den Main-Thread zu blockieren.
+     * onReady wird auf dem Main-Thread aufgerufen, sobald der Spawnbereich generiert ist.
+     */
+    public void loadOrCreate(WorldSpec spec, Consumer<World> onReady, Consumer<String> onError) {
+        if (!VALID_NAME.matcher(spec.name()).matches()) {
+            onError.accept("Ungueltiger Weltname. Erlaubt: A-Z, a-z, 0-9, _ und - (max. 64 Zeichen).");
+            return;
+        }
+        String key = spec.name().toLowerCase(Locale.ROOT);
+        World existing = Bukkit.getWorld(spec.name());
+        if (existing != null) {
+            whenReady(existing, onReady);
+            return;
+        }
+        LoadState pending = states.get(key);
+        if (pending != null && !pending.ready) {
+            pending.waiters.add(onReady);
+            return;
+        }
+
+        boolean isNew = !worldExistsOnDisk(spec.name());
+        long start = System.nanoTime();
+        World world;
+        managerDepth++;
+        try {
+            world = Bukkit.createWorld(spec.toCreator());
+        } catch (Throwable t) {
+            logger.log(Level.SEVERE, "[WorldManager] Welt '" + spec.name() + "' konnte nicht geladen werden", t);
+            onError.accept("Welt '" + spec.name() + "' konnte nicht geladen werden: " + t.getMessage());
+            return;
+        } finally {
+            managerDepth--;
+        }
+        if (world == null) {
+            onError.accept("Welt '" + spec.name() + "' konnte nicht geladen werden.");
+            return;
+        }
+        double ms = (System.nanoTime() - start) / 1_000_000.0;
+        logger.info(String.format(Locale.ROOT, "[WorldManager] Welt '%s' %s in %.1f ms (Main-Thread). Spawnbereich wird im Hintergrund generiert...",
+                world.getName(), isNew ? "erstellt" : "geladen", ms));
+
+        LoadState st = new LoadState();
+        st.waiters.add(onReady);
+        states.put(key, st);
+        storeSpec(spec, true);
+
+        ServerLevel level = ((CraftWorld) world).getHandle();
+        String resolvedKey = "worlds." + spec.name() + ".spawn-resolved";
+        boolean provisional = provisionalSpawn.remove(level);
+        boolean unresolved = config.contains(resolvedKey) && !config.getBoolean(resolvedKey);
+        if (provisional || unresolved) {
+            config.set(resolvedKey, false); // falls der Server vor dem Ende der Suche stoppt
+            saveConfig();
+            resolveSpawn(world, st);
+        } else {
+            preloadSpawn(world, st);
+        }
+    }
+
+    private void whenReady(World world, Consumer<World> callback) {
+        LoadState st = states.get(world.getName().toLowerCase(Locale.ROOT));
+        if (st == null || st.ready) {
+            callback.accept(world);
+        } else {
+            st.waiters.add(callback);
+        }
+    }
+
+    // ------------------------------------------------------------------ Asynchrone Spawnsuche
+
+    private void resolveSpawn(World world, LoadState st) {
+        final LoadState state = st != null ? st : states.computeIfAbsent(world.getName().toLowerCase(Locale.ROOT), k -> new LoadState());
+        ServerLevel level = ((CraftWorld) world).getHandle();
+        Location provisional = world.getSpawnLocation();
+        ChunkPos origin = new ChunkPos(provisional.getBlockX() >> 4, provisional.getBlockZ() >> 4);
+        List<ChunkPos> candidates = spiral(origin, SPAWN_SEARCH_RADIUS);
+        tryCandidate(world, level, candidates, 0, state);
+    }
+
+    private void tryCandidate(World world, ServerLevel level, List<ChunkPos> candidates, int index, LoadState st) {
+        if (Bukkit.getWorld(world.getUID()) == null) {
+            return; // Welt wurde inzwischen entladen
+        }
+        if (index >= candidates.size()) {
+            // Nichts gefunden (sehr selten, z.B. Ozean): hoechsten Block am Ursprung nehmen - Chunk ist schon geladen.
+            Location loc = world.getSpawnLocation();
+            int y = world.getHighestBlockYAt(loc.getBlockX(), loc.getBlockZ()) + 1;
+            finishSpawn(world, st, loc.getBlockX(), y, loc.getBlockZ());
+            return;
+        }
+        ChunkPos pos = candidates.get(index);
+        level.getChunkSource().addTicketAndLoadWithRadius(TicketType.TACHYON_WORLD_PRELOAD, pos, 0)
+                .whenComplete((result, error) -> mainQueue.add(() -> {
+                    if (Bukkit.getWorld(world.getUID()) == null) {
+                        return;
+                    }
+                    BlockPos spawn = error == null ? PlayerSpawnFinder.getSpawnPosInChunk(level, pos) : null;
+                    if (spawn != null) {
+                        finishSpawn(world, st, spawn.getX(), spawn.getY(), spawn.getZ());
+                    } else {
+                        tryCandidate(world, level, candidates, index + 1, st);
+                    }
+                }));
+    }
+
+    private void finishSpawn(World world, LoadState st, int x, int y, int z) {
+        world.setSpawnLocation(x, y, z);
+        if (config.contains("worlds." + world.getName())) {
+            config.set("worlds." + world.getName() + ".spawn-resolved", true);
+        }
+        setPendingSpawn(world.getName(), false);
+        preloadSpawn(world, st);
+    }
+
+    /** Merkt sich Welten mit noch provisorischem Spawn dauerhaft (internal.pending-spawn in tachyon.yml). */
+    private void setPendingSpawn(String worldName, boolean pending) {
+        List<String> list = new ArrayList<>(config.getStringList("internal.pending-spawn"));
+        boolean changed = pending ? !list.contains(worldName) && list.add(worldName) : list.remove(worldName);
+        if (changed) {
+            config.set("internal.pending-spawn", list.isEmpty() ? null : list);
+            saveConfig();
+        } else if (!pending) {
+            saveConfig();
+        }
+    }
+
+    private void preloadSpawn(World world, LoadState st) {
+        ServerLevel level = ((CraftWorld) world).getHandle();
+        Location spawn = world.getSpawnLocation();
+        ChunkPos center = new ChunkPos(spawn.getBlockX() >> 4, spawn.getBlockZ() >> 4);
+        long start = System.nanoTime();
+        level.getChunkSource().addTicketAndLoadWithRadius(TicketType.TACHYON_WORLD_PRELOAD, center, preloadRadius)
+                .whenComplete((result, error) -> mainQueue.add(() -> {
+                    st.ready = true;
+                    logger.info(String.format(Locale.ROOT, "[WorldManager] Welt '%s' bereit (Spawnbereich in %.1f s generiert, Server lief normal weiter).",
+                            world.getName(), (System.nanoTime() - start) / 1e9));
+                    List<Consumer<World>> waiters = new ArrayList<>(st.waiters);
+                    st.waiters.clear();
+                    for (Consumer<World> w : waiters) {
+                        try {
+                            w.accept(world);
+                        } catch (Throwable t) {
+                            logger.log(Level.WARNING, "[WorldManager] Fehler im Bereit-Callback", t);
+                        }
+                    }
+                }));
+    }
+
+    private static List<ChunkPos> spiral(ChunkPos origin, int radius) {
+        List<ChunkPos> out = new ArrayList<>((radius * 2 + 1) * (radius * 2 + 1));
+        out.add(origin);
+        for (int r = 1; r <= radius; r++) {
+            for (int dx = -r; dx <= r; dx++) {
+                for (int dz = -r; dz <= r; dz++) {
+                    if (Math.max(Math.abs(dx), Math.abs(dz)) == r) {
+                        out.add(new ChunkPos(origin.x() + dx, origin.z() + dz));
+                    }
+                }
+            }
+        }
+        return out;
+    }
+
+    // ------------------------------------------------------------------ Teleport / Entladen / Loeschen / Klonen
+
+    public Location safeSpawn(World world) {
+        return world.getSpawnLocation().clone().add(0.5, 0, 0.5);
+    }
+
+    public void teleportWhenReady(Player player, World world) {
+        whenReady(world, w -> {
+            if (player.isOnline()) {
+                player.teleport(safeSpawn(w));
+            }
+        });
+    }
+
+    /** @return Fehlermeldung oder null bei Erfolg */
+    public String unload(String name, boolean save) {
+        World world = Bukkit.getWorld(name);
+        if (world == null) {
+            return "Welt '" + name + "' ist nicht geladen.";
+        }
+        World main = Bukkit.getWorlds().get(0);
+        if (world.equals(main)) {
+            return "Die Hauptwelt kann nicht entladen werden.";
+        }
+        for (Player p : world.getPlayers()) {
+            p.teleport(safeSpawn(main));
+            p.sendMessage("§eDie Welt '" + name + "' wird entladen, du wurdest zum Spawn gebracht.");
+        }
+        if (!Bukkit.unloadWorld(world, save)) {
+            return "Welt '" + name + "' konnte nicht entladen werden (ein Plugin hat es verhindert?).";
+        }
+        states.remove(name.toLowerCase(Locale.ROOT));
+        return null;
+    }
+
+    public boolean isProtected(String name) {
+        String main = Bukkit.getWorlds().get(0).getName();
+        return name.equalsIgnoreCase(main) || name.equalsIgnoreCase(main + "_nether") || name.equalsIgnoreCase(main + "_the_end");
+    }
+
+    public void delete(String name, Consumer<String> onDone, Consumer<String> onError) {
+        if (isProtected(name)) {
+            onError.accept("Die Standardwelten koennen nicht geloescht werden.");
+            return;
+        }
+        if (Bukkit.getWorld(name) != null) {
+            String err = unload(name, false);
+            if (err != null) {
+                onError.accept(err);
+                return;
+            }
+        }
+        File folder = worldFolder(name);
+        config.set("worlds." + name, null);
+        saveConfig();
+        if (!folder.exists()) {
+            onDone.accept("Welt '" + name + "' aus der Verwaltung entfernt (kein Ordner vorhanden).");
+            return;
+        }
+        io.execute(() -> {
+            try {
+                deleteRecursive(folder.toPath());
+                mainQueue.add(() -> onDone.accept("Welt '" + name + "' wurde geloescht."));
+            } catch (IOException e) {
+                mainQueue.add(() -> onError.accept("Loeschen fehlgeschlagen: " + e.getMessage()));
+            }
+        });
+    }
+
+    public void cloneWorld(String source, String target, Consumer<World> onReady, Consumer<String> onError) {
+        if (!VALID_NAME.matcher(target).matches()) {
+            onError.accept("Ungueltiger Zielname.");
+            return;
+        }
+        if (!worldExistsOnDisk(source)) {
+            onError.accept("Quellwelt '" + source + "' existiert nicht.");
+            return;
+        }
+        if (Bukkit.getWorld(source) != null) {
+            onError.accept("Quellwelt '" + source + "' ist geladen - bitte zuerst '/wm unload " + source + "'.");
+            return;
+        }
+        if (worldFolder(target).exists()) {
+            onError.accept("Zielordner '" + target + "' existiert bereits.");
+            return;
+        }
+        WorldSpec srcSpec = storedSpec(source);
+        WorldSpec spec = srcSpec != null ? srcSpec.withName(target) : new WorldSpec(target, World.Environment.NORMAL, WorldSpec.Type.NORMAL, null, true);
+        Path from = worldFolder(source).toPath();
+        Path to = worldFolder(target).toPath();
+        io.execute(() -> {
+            try {
+                copyRecursive(from, to);
+                mainQueue.add(() -> {
+                    config.set("worlds." + target + ".spawn-resolved", true);
+                    loadOrCreate(spec, onReady, onError);
+                });
+            } catch (IOException e) {
+                mainQueue.add(() -> onError.accept("Kopieren fehlgeschlagen: " + e.getMessage()));
+            }
+        });
+    }
+
+    private static void deleteRecursive(Path root) throws IOException {
+        Files.walkFileTree(root, new SimpleFileVisitor<>() {
+            @Override
+            public FileVisitResult visitFile(Path file, BasicFileAttributes attrs) throws IOException {
+                Files.delete(file);
+                return FileVisitResult.CONTINUE;
+            }
+
+            @Override
+            public FileVisitResult postVisitDirectory(Path dir, IOException exc) throws IOException {
+                Files.delete(dir);
+                return FileVisitResult.CONTINUE;
+            }
+        });
+    }
+
+    private static void copyRecursive(Path from, Path to) throws IOException {
+        Files.walkFileTree(from, new SimpleFileVisitor<>() {
+            @Override
+            public FileVisitResult preVisitDirectory(Path dir, BasicFileAttributes attrs) throws IOException {
+                Files.createDirectories(to.resolve(from.relativize(dir)));
+                return FileVisitResult.CONTINUE;
+            }
+
+            @Override
+            public FileVisitResult visitFile(Path file, BasicFileAttributes attrs) throws IOException {
+                String n = file.getFileName().toString();
+                if (n.equals("session.lock") || n.equals("uid.dat")) {
+                    return FileVisitResult.CONTINUE; // neue Welt bekommt eigene UID / eigenes Lock
+                }
+                Files.copy(file, to.resolve(from.relativize(file)), StandardCopyOption.COPY_ATTRIBUTES);
+                return FileVisitResult.CONTINUE;
+            }
+        });
+    }
+
+    /** Alle Weltordner (mit level.dat) im Server-Verzeichnis. */
+    public List<String> worldFoldersOnDisk() {
+        List<String> out = new ArrayList<>();
+        File[] files = Bukkit.getWorldContainer().listFiles(File::isDirectory);
+        if (files != null) {
+            for (File f : files) {
+                if (new File(f, "level.dat").isFile()) {
+                    out.add(f.getName());
+                }
+            }
+        }
+        Collections.sort(out);
+        return out;
+    }
+
+    // ------------------------------------------------------------------ Pregenerator
+
+    /** @return Fehlermeldung oder null */
+    public String startPregen(World world, int radiusBlocks, Consumer<String> progress) {
+        if (pregen != null) {
+            return "Es laeuft bereits eine Vorgenerierung fuer '" + pregen.world.getName() + "'. Stoppen mit /wm pregen stop";
+        }
+        int radius = Math.max(1, radiusBlocks >> 4);
+        Location c = world.getSpawnLocation();
+        pregen = new PregenTask(world, new ChunkPos(c.getBlockX() >> 4, c.getBlockZ() >> 4), radius, progress);
+        logger.info("[WorldManager] Vorgenerierung gestartet: '" + world.getName() + "', Radius " + radiusBlocks + " Bloecke (" + pregen.total + " Chunks).");
+        return null;
+    }
+
+    public String stopPregen() {
+        if (pregen == null) {
+            return null;
+        }
+        String status = pregen.status();
+        pregen.cancelled = true;
+        pregen = null;
+        return status;
+    }
+
+    public String pregenStatus() {
+        return pregen == null ? null : pregen.status();
+    }
+
+    private final class PregenTask {
+        final World world;
+        final ServerLevel level;
+        final ChunkPos center;
+        final int radius;
+        final long total;
+        final Consumer<String> progress;
+        final long startNanos = System.nanoTime();
+        int ring;
+        int ringIndex;
+        List<ChunkPos> ringPositions;
+        int inFlight;
+        long done;
+        int lastReportedPercent = -1;
+        long pausedTicks;
+        boolean cancelled;
+
+        PregenTask(World world, ChunkPos center, int radius, Consumer<String> progress) {
+            this.world = world;
+            this.level = ((CraftWorld) world).getHandle();
+            this.center = center;
+            this.radius = radius;
+            this.total = (long) (radius * 2 + 1) * (radius * 2 + 1);
+            this.progress = progress;
+            this.ringPositions = List.of(center);
+        }
+
+        /** Naechster Chunk in Ringen um das Zentrum (ohne riesige Liste im Speicher). */
+        private ChunkPos next() {
+            while (ringIndex >= ringPositions.size()) {
+                ring++;
+                if (ring > radius) {
+                    return null;
+                }
+                ringIndex = 0;
+                List<ChunkPos> list = new ArrayList<>(8 * ring);
+                for (int d = -ring; d < ring; d++) {
+                    list.add(new ChunkPos(center.x() + d, center.z() - ring));
+                    list.add(new ChunkPos(center.x() + ring, center.z() + d));
+                    list.add(new ChunkPos(center.x() - d, center.z() + ring));
+                    list.add(new ChunkPos(center.x() - ring, center.z() - d));
+                }
+                ringPositions = list;
+            }
+            return ringPositions.get(ringIndex++);
+        }
+
+        void tick(boolean slowTick) {
+            if (cancelled) {
+                return;
+            }
+            if (Bukkit.getWorld(world.getUID()) == null) {
+                progress.accept("Vorgenerierung abgebrochen: Welt '" + world.getName() + "' wurde entladen.");
+                pregen = null;
+                return;
+            }
+            if (slowTick) {
+                pausedTicks++;
+                return; // Server ist gerade ausgelastet - Spieler gehen vor
+            }
+            while (inFlight < pregenParallel) {
+                ChunkPos pos = next();
+                if (pos == null) {
+                    break;
+                }
+                inFlight++;
+                level.getChunkSource().addTicketAndLoadWithRadius(TicketType.TACHYON_PREGEN, pos, 0)
+                        .whenComplete((r, t) -> mainQueue.add(this::onChunkDone));
+            }
+        }
+
+        private void onChunkDone() {
+            inFlight--;
+            done++;
+            if (cancelled) {
+                return;
+            }
+            int percent = (int) (done * 100 / total);
+            if (done >= total) {
+                double secs = (System.nanoTime() - startNanos) / 1e9;
+                String msg = String.format(Locale.ROOT, "Vorgenerierung von '%s' fertig: %d Chunks in %.0f s.", world.getName(), total, secs);
+                logger.info("[WorldManager] " + msg);
+                progress.accept(msg);
+                pregen = null;
+                return;
+            }
+            if (percent / 5 != lastReportedPercent / 5) {
+                lastReportedPercent = percent;
+                String msg = status();
+                logger.info("[WorldManager] " + msg);
+                progress.accept(msg);
+            }
+        }
+
+        String status() {
+            double secs = (System.nanoTime() - startNanos) / 1e9;
+            double rate = secs > 0 ? done / secs : 0;
+            long remaining = rate > 0 ? (long) ((total - done) / rate) : -1;
+            return String.format(Locale.ROOT, "Pregen '%s': %d/%d Chunks (%d%%), %.0f Chunks/s, noch ca. %s%s",
+                    world.getName(), done, total, done * 100 / total, rate,
+                    remaining < 0 ? "?" : (remaining / 60) + " min " + (remaining % 60) + " s",
+                    pausedTicks > 0 ? ", " + pausedTicks + " Ticks wegen Last pausiert" : "");
+        }
+    }
+
+    private static final class LoadState {
+        boolean ready;
+        final List<Consumer<World>> waiters = new ArrayList<>();
+    }
+
+    // ------------------------------------------------------------------ WorldSpec
+
+    public record WorldSpec(String name, World.Environment environment, Type type, Long seed, boolean structures) {
+
+        public enum Type {
+            NORMAL, FLAT, AMPLIFIED, LARGE_BIOMES, VOID;
+
+            public static Type parse(String s) {
+                if (s == null) {
+                    return null;
+                }
+                try {
+                    return valueOf(s.toUpperCase(Locale.ROOT).replace('-', '_'));
+                } catch (IllegalArgumentException e) {
+                    return null;
+                }
+            }
+        }
+
+        public WorldSpec withName(String newName) {
+            return new WorldSpec(newName, environment, type, seed, structures);
+        }
+
+        public WorldCreator toCreator() {
+            WorldCreator wc = new WorldCreator(name).environment(environment).generateStructures(structures);
+            if (seed != null) {
+                wc.seed(seed);
+            }
+            switch (type) {
+                case FLAT -> wc.type(WorldType.FLAT);
+                case AMPLIFIED -> wc.type(WorldType.AMPLIFIED);
+                case LARGE_BIOMES -> wc.type(WorldType.LARGE_BIOMES);
+                case VOID -> wc.generator(new VoidGenerator());
+                default -> wc.type(WorldType.NORMAL);
+            }
+            return wc;
+        }
+    }
+}
