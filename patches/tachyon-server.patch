+    /**
+     * Wird von MinecraftServer#setInitialSpawn / #prepareLevels abgefragt.
+     * true = keine synchrone Spawnsuche und kein blockierendes Warten auf Chunks.
+     */
+    public static boolean isFastLoading() {
+        if (managerDepth > 0) {
+            return true;
+        }
+        WorldManager wm = instance;
+        if (wm == null) {
+            return false;
+        }
+        // Beim Serverstart (vor dem ersten Tick) gilt startup.fast-start, danach die Plugin-Einstellung.
+        return wm.started ? wm.fastForPlugins : wm.fastStartup;
+    }
+
+    /** Kern-Hook: Spawn wurde nur provisorisch gesetzt und muss asynchron gesucht werden. */
+    public static void markProvisionalSpawn(ServerLevel level) {
+        WorldManager wm = instance;
+        if (wm == null) {
+            return;
+        }
+        wm.provisionalSpawn.add(level);
+        wm.setPendingSpawn(level.getWorld().getName(), true); // falls der Server vor Ende der Suche stoppt
+        if (managerDepth == 0) {
+            // Von einem Plugin erzeugt: Spawn im naechsten Tick im Hintergrund aufloesen.
+            wm.mainQueue.add(() -> {
+                if (wm.provisionalSpawn.remove(level)) {
+                    wm.resolveSpawn(level.getWorld(), null);
+                }
+            });
+        }
+    }
+
+    /** Kern-Hook: Server pausiert (niemand online) - alle 10 s leere Welten pruefen, ohne die Pause aufzuheben. */
+    public static void pausedTickHook() {
+        WorldManager wm = instance;
+        if (wm == null) {
+            return;
+        }
+        wm.drainQueue(); // z.B. "Welt bereit" auch ohne Spieler melden
+        if (++wm.pausedTicks % 200 == 0) {
+            wm.unloadIdleWorlds();
+        }
+        dev.tachyon.perf.MemoryManager.tick(); // RAM zurueckgeben / Schlafmodus
+    }
