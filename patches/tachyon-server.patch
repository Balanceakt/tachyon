+/**
+ * /wm - eingebauter World-Manager von Tachyon.
+ *
+ * Jeder Unterbefehl hat eine eigene Berechtigung (tachyon.wm.&lt;befehl&gt;), standardmaessig nur fuer OPs.
+ * Mit einem Permission-Plugin (z.B. LuckPerms) lassen sie sich einzeln vergeben; tachyon.wm.* gibt alle.
+ */
+public final class WorldManagerCommand extends Command {
+
+    public static final String PERM_PREFIX = "tachyon.wm.";
+    public static final String PERM_ALL = "tachyon.wm.*";
+    public static final String PERM_TP_OTHERS = "tachyon.wm.tp.others";
+
+    /** Unterbefehl -> Benutzung (fuer Hilfe und Fehlermeldungen). Reihenfolge = Reihenfolge in der Hilfe. */
+    private static final Map<String, String> SUB = new LinkedHashMap<>();
+    private static final List<String> TYPES = List.of("normal", "flat", "amplified", "large_biomes", "void", "nether", "end");
+
+    static {
+        SUB.put("create", "create <name> [normal|flat|amplified|large_biomes|void|nether|end] [seed]");
+        SUB.put("load", "load <name> [normal|nether|end]");
+        SUB.put("unload", "unload <name> [nosave]");
+        SUB.put("delete", "delete <name> confirm");
+        SUB.put("clone", "clone <source> <target>");
+        SUB.put("tp", "tp <world> [player]");
+        SUB.put("list", "list");
+        SUB.put("info", "info <name>");
+        SUB.put("setspawn", "setspawn");
+        SUB.put("autoload", "autoload <name> <true|false>");
+        SUB.put("pregen", "pregen <world> <radius> | stop | status");
+        SUB.put("reload", "reload");
+    }
+
+    public WorldManagerCommand(String name) {
+        super(name, t("cmd.desc"), "/wm <" + String.join("|", SUB.keySet()) + ">", List.of("worldmanager", "worlds"));
+        setPermission(PERM_PREFIX + "use");
+    }
+
+    // ------------------------------------------------------------------ Berechtigungen
+
+    /** Registriert alle Berechtigungen, damit Permission-Plugins sie kennen und anzeigen. */
+    public static void registerPermissions() {
+        PluginManager pm = Bukkit.getPluginManager();
+        Map<String, Boolean> children = new LinkedHashMap<>();
+        for (String sub : SUB.keySet()) {
+            String node = PERM_PREFIX + sub;
+            children.put(node, true);
+            if (pm.getPermission(node) == null) {
+                pm.addPermission(new Permission(node, "Tachyon: /wm " + sub, PermissionDefault.OP));
+            }
+        }
+        children.put(PERM_TP_OTHERS, true);
+        if (pm.getPermission(PERM_TP_OTHERS) == null) {
+            pm.addPermission(new Permission(PERM_TP_OTHERS, "Tachyon: /wm tp <world> <player>", PermissionDefault.OP));
+        }
+        if (pm.getPermission(PERM_PREFIX + "use") == null) {
+            pm.addPermission(new Permission(PERM_PREFIX + "use", "Tachyon: /wm", PermissionDefault.OP));
+        }
+        children.put(PERM_PREFIX + "use", true);
+        if (pm.getPermission(PERM_ALL) == null) {
+            pm.addPermission(new Permission(PERM_ALL, "Tachyon: alle /wm Befehle", PermissionDefault.OP, children));
+        }
+    }
+
+    private static boolean allowed(CommandSender sender, String sub) {
+        return sender.hasPermission(PERM_PREFIX + sub);
+    }
+
+    /** Sichtbar/nutzbar, sobald man mindestens einen Unterbefehl darf. */
+    @Override
+    public boolean testPermissionSilent(CommandSender target) {
+        if (target.hasPermission(PERM_PREFIX + "use")) {
+            return true;
+        }
+        for (String sub : SUB.keySet()) {
+            if (allowed(target, sub)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // ------------------------------------------------------------------ Ausfuehren
+
+    @Override
+    public boolean execute(CommandSender sender, String label, String[] args) {
+        if (!testPermission(sender)) {
+            return true;
+        }
+        WorldManager wm = WorldManager.get();
+        if (wm == null) {
+            err(sender, t("cmd.not_initialized"));
+            return true;
+        }
+        if (args.length == 0 || !SUB.containsKey(args[0].toLowerCase(Locale.ROOT))) {
+            help(sender, label);
+            return true;
+        }
+        String sub = args[0].toLowerCase(Locale.ROOT);
+        if (!allowed(sender, sub)) {
+            err(sender, t("cmd.no_permission", PERM_PREFIX + sub));
+            return true;
+        }
+        switch (sub) {
+            case "create" -> create(wm, sender, label, args);
+            case "load" -> load(wm, sender, label, args);
+            case "unload" -> unload(wm, sender, label, args);
+            case "delete" -> delete(wm, sender, label, args);
+            case "clone" -> cloneWorld(wm, sender, label, args);
+            case "tp" -> tp(wm, sender, label, args);
+            case "list" -> list(wm, sender);
+            case "info" -> info(wm, sender, label, args);
+            case "setspawn" -> setSpawn(sender);
+            case "autoload" -> autoload(wm, sender, label, args);
+            case "pregen" -> pregen(wm, sender, label, args);
+            case "reload" -> {
+                wm.reloadConfig();
+                ok(sender, t("cmd.reloaded"));
+            }
+            default -> help(sender, label);
+        }
+        return true;
+    }
+
+    private void help(CommandSender s, String label) {
+        String m = Style.col(s, Style.C_MUTED);
+        s.sendMessage(Style.line(s));
+        s.sendMessage(" " + Style.prefix(s) + ChatColor.BOLD + t("cmd.help.title"));
+        s.sendMessage("");
+        for (Map.Entry<String, String> e : SUB.entrySet()) {
+            if (allowed(s, e.getKey())) {
+                s.sendMessage(m + " \u25B8 " + Style.col(s, Style.C_ACCENT) + "/" + label + " " + localizeUsage(e.getValue()));
+                s.sendMessage(m + "     " + t("cmd.help." + e.getKey()));
+            }
+        }
+        s.sendMessage(Style.line(s));
+    }
+
+    private static String localizeUsage(String usage) {
+        return usage.replace("<name>", "<" + t("arg.name") + ">").replace("<world>", "<" + t("arg.world") + ">")
+                .replace("[player]", "[" + t("arg.player") + "]").replace("<source>", "<" + t("arg.source") + ">")
+                .replace("<target>", "<" + t("arg.target") + ">").replace("<radius>", "<" + t("arg.radius") + ">");
+    }
+
+    private static void usage(CommandSender s, String label, String sub) {
+        err(s, t("cmd.usage", "/" + label + " " + localizeUsage(SUB.get(sub))));
+    }
+
+    private static void ok(CommandSender s, String msg) {
+        Style.ok(s, msg);
+    }
+
+    private static void err(CommandSender s, String msg) {
+        Style.err(s, msg);
+    }
+
+    private static void info(CommandSender s, String msg) {
+        Style.info(s, msg);
+    }
+
+    // ------------------------------------------------------------------ Unterbefehle
+
+    private void create(WorldManager wm, CommandSender s, String label, String[] a) {
+        if (a.length < 2) {
+            usage(s, label, "create");
+            return;
+        }
+        String name = a[1];
+        if (Bukkit.getWorld(name) != null || wm.worldFolder(name).exists()) {
+            err(s, t("cmd.create.exists", name, label, name));
+            return;
+        }
+        String typeArg = a.length >= 3 ? a[2].toLowerCase(Locale.ROOT) : "normal";
+        World.Environment env = World.Environment.NORMAL;
+        WorldManager.WorldSpec.Type type;
+        switch (typeArg) {
+            case "nether" -> {
+                env = World.Environment.NETHER;
+                type = WorldManager.WorldSpec.Type.NORMAL;
+            }
+            case "end", "the_end" -> {
+                env = World.Environment.THE_END;
+                type = WorldManager.WorldSpec.Type.NORMAL;
+            }
+            default -> type = WorldManager.WorldSpec.Type.parse(typeArg);
+        }
+        if (type == null) {
+            err(s, t("cmd.create.unknown_type", typeArg, String.join(", ", TYPES)));
+            return;
+        }
+        Long seed = null;
+        if (a.length >= 4) {
+            try {
+                seed = Long.parseLong(a[3]);
+            } catch (NumberFormatException e) {
+                seed = (long) a[3].hashCode(); // wie Vanilla: Text-Seeds werden gehasht
+            }
+        }
+        WorldManager.WorldSpec spec = new WorldManager.WorldSpec(name, env, type, seed, true);
+        info(s, t("cmd.create.started", name, typeArg));
+        long start = System.currentTimeMillis();
+        wm.loadOrCreate(spec, true, w -> ok(s, t("cmd.create.ready", w.getName(), System.currentTimeMillis() - start, label, w.getName())), msg -> err(s, msg));
+    }
+
+    private void load(WorldManager wm, CommandSender s, String label, String[] a) {
+        if (a.length < 2) {
+            usage(s, label, "load");
+            return;
+        }
+        String name = a[1];
+        if (!wm.worldExistsOnDisk(name)) {
+            err(s, t("cmd.load.missing", name, label, name));
+            return;
+        }
+        WorldManager.WorldSpec spec = wm.specFor(name, a.length >= 3 ? a[2] : null);
+        info(s, t("cmd.load.started", name));
+        long start = System.currentTimeMillis();
+        wm.loadOrCreate(spec, true, w -> ok(s, t("cmd.load.ready", w.getName(), System.currentTimeMillis() - start)), msg -> err(s, msg));
+    }
+
+    private void unload(WorldManager wm, CommandSender s, String label, String[] a) {
+        if (a.length < 2) {
+            usage(s, label, "unload");
+            return;
+        }
+        boolean save = !(a.length >= 3 && a[2].equalsIgnoreCase("nosave"));
+        String error = wm.unload(a[1], save);
+        if (error != null) {
+            err(s, error);
+            return;
+        }
+        if (wm.managedWorlds().contains(a[1])) {
+            wm.setAutoload(a[1], false);
+        }
+        ok(s, t(save ? "cmd.unload.done.save" : "cmd.unload.done.nosave", a[1]));
+    }
+
+    private void delete(WorldManager wm, CommandSender s, String label, String[] a) {
+        if (a.length < 3 || !a[2].equalsIgnoreCase("confirm")) {
+            err(s, t("cmd.delete.confirm", label, a.length >= 2 ? a[1] : "<" + t("arg.name") + ">"));
+            return;
+        }
+        info(s, t("cmd.delete.started", a[1]));
+        wm.delete(a[1], msg -> ok(s, msg), msg -> err(s, msg));
+    }
+
+    private void cloneWorld(WorldManager wm, CommandSender s, String label, String[] a) {
+        if (a.length < 3) {
+            usage(s, label, "clone");
+            return;
+        }
+        info(s, t("cmd.clone.started", a[1], a[2]));
+        wm.cloneWorld(a[1], a[2], w -> ok(s, t("cmd.world.ready", w.getName())), msg -> err(s, msg));
+    }
+
+    private void tp(WorldManager wm, CommandSender s, String label, String[] a) {
+        if (a.length < 2) {
+            usage(s, label, "tp");
+            return;
+        }
+        Player target;
+        if (a.length >= 3) {
+            if (!s.hasPermission(PERM_TP_OTHERS)) {
+                err(s, t("cmd.no_permission", PERM_TP_OTHERS));
+                return;
+            }
+            target = Bukkit.getPlayerExact(a[2]);
+            if (target == null) {
+                err(s, t("cmd.tp.player_offline", a[2]));
+                return;
+            }
+        } else if (s instanceof Player p) {
+            target = p;
+        } else {
+            err(s, t("cmd.tp.console", label));
+            return;
+        }
+        String name = a[1];
+        World world = Bukkit.getWorld(name);
+        if (world != null) {
+            if (!wm.isReady(world)) {
+                info(s, t("cmd.tp.preparing", name));
+            }
+            wm.teleportWhenReady(target, world);
+            return;
+        }
+        if (!wm.worldExistsOnDisk(name)) {
+            err(s, t("cmd.tp.missing", name));
+            return;
+        }
+        info(s, t("cmd.tp.loading", name));
+        wm.loadOrCreate(wm.specFor(name, null), true, w -> {
+            if (target.isOnline()) {
+                target.teleport(wm.safeSpawn(w));
+            }
+        }, msg -> err(s, msg));
+    }
+
+    private void list(WorldManager wm, CommandSender s) {
+        s.sendMessage(Style.line(s));
+        s.sendMessage(" " + Style.prefix(s) + ChatColor.BOLD + t("cmd.list.title"));
+        Set<String> seen = new LinkedHashSet<>();
+        for (World w : Bukkit.getWorlds()) {
+            seen.add(w.getName());
+            String state = wm.isReady(w) ? ChatColor.GREEN + t("cmd.list.loaded") : ChatColor.YELLOW + t("cmd.list.preparing");
+            s.sendMessage(ChatColor.GRAY + " - " + ChatColor.WHITE + w.getName() + ChatColor.DARK_GRAY + " [" + state + ChatColor.DARK_GRAY + "] "
+                    + ChatColor.GRAY + t("cmd.list.details", w.getEnvironment().name().toLowerCase(Locale.ROOT), w.getPlayers().size(), w.getLoadedChunks().length)
+                    + (wm.isAutoload(w.getName()) ? ", " + t("cmd.list.autoload") : ""));
+        }
+        List<String> disk = new ArrayList<>(wm.worldFoldersOnDisk());
+        disk.addAll(wm.managedWorlds());
+        for (String name : new LinkedHashSet<>(disk)) {
+            if (seen.add(name)) {
+                boolean exists = wm.worldExistsOnDisk(name);
+                s.sendMessage(ChatColor.GRAY + " - " + ChatColor.WHITE + name + ChatColor.DARK_GRAY + " ["
+                        + (exists ? ChatColor.GRAY + t("cmd.list.unloaded") : ChatColor.RED + t("cmd.list.folder_missing")) + ChatColor.DARK_GRAY + "]"
+                        + (wm.isAutoload(name) ? ChatColor.GRAY + " " + t("cmd.list.autoload") : ""));
+            }
+        }
+    }
+
+    private void info(WorldManager wm, CommandSender s, String label, String[] a) {
+        if (a.length < 2) {
+            usage(s, label, "info");
+            return;
+        }
+        World w = Bukkit.getWorld(a[1]);
+        if (w == null) {
+            info(s, t("cmd.info.not_loaded", a[1], t(wm.worldExistsOnDisk(a[1]) ? "cmd.info.folder_exists" : "cmd.info.not_exists")));
+            return;
+        }
+        Location sp = w.getSpawnLocation();
+        s.sendMessage(" " + Style.prefix(s) + ChatColor.BOLD + w.getName());
+        s.sendMessage(ChatColor.GRAY + " " + t("cmd.info.status", wm.isReady(w) ? t("cmd.info.status.ready") : t("cmd.list.preparing")));
+        s.sendMessage(ChatColor.GRAY + " " + t("cmd.info.env", w.getEnvironment().name(), w.getSeed()));
+        s.sendMessage(ChatColor.GRAY + " " + t("cmd.info.spawn", sp.getBlockX(), sp.getBlockY(), sp.getBlockZ()));
+        s.sendMessage(ChatColor.GRAY + " " + t("cmd.info.counts", w.getPlayers().size(), w.getLoadedChunks().length, w.getEntities().size()));
+        s.sendMessage(ChatColor.GRAY + " " + t("cmd.info.autoload", wm.isAutoload(w.getName())));
+    }
+
+    private void setSpawn(CommandSender s) {
+        if (!(s instanceof Player p)) {
+            err(s, t("cmd.setspawn.players_only"));
+            return;
+        }
+        Location l = p.getLocation();
+        p.getWorld().setSpawnLocation(l);
+        ok(s, t("cmd.setspawn.done", p.getWorld().getName(), l.getBlockX(), l.getBlockY(), l.getBlockZ()));
+    }
+
+    private void autoload(WorldManager wm, CommandSender s, String label, String[] a) {
+        if (a.length < 3) {
+            usage(s, label, "autoload");
+            return;
+        }
+        if (!wm.managedWorlds().contains(a[1])) {
+            err(s, t("cmd.autoload.unmanaged", a[1], label));
+            return;
+        }
+        boolean v = Boolean.parseBoolean(a[2]);
+        wm.setAutoload(a[1], v);
+        ok(s, t("cmd.autoload.done", a[1], v));
+    }
+
+    private void pregen(WorldManager wm, CommandSender s, String label, String[] a) {
+        if (a.length >= 2 && a[1].equalsIgnoreCase("stop")) {
+            String st = wm.stopPregen();
+            if (st == null) {
+                err(s, t("cmd.pregen.none"));
+            } else {
+                ok(s, t("cmd.pregen.stopped", st));
+            }
+            return;
+        }
+        if (a.length >= 2 && a[1].equalsIgnoreCase("status")) {
+            String st = wm.pregenStatus();
+            info(s, st == null ? t("cmd.pregen.none") : st);
+            return;
+        }
+        if (a.length < 3) {
+            usage(s, label, "pregen");
+            return;
+        }
+        World w = Bukkit.getWorld(a[1]);
+        if (w == null) {
+            err(s, t("wm.err.not_loaded", a[1]));
+            return;
+        }
+        int radius;
+        try {
+            radius = Integer.parseInt(a[2]);
+        } catch (NumberFormatException e) {
+            err(s, t("cmd.pregen.radius_nan"));
+            return;
+        }
+        if (radius < 16 || radius > 50000) {
+            err(s, t("cmd.pregen.radius_range"));
+            return;
+        }
+        String error = wm.startPregen(w, radius, msg -> {
+            if (s instanceof Player p && p.isOnline()) {
+                Style.info(p, msg);
+            }
+        });
+        if (error != null) {
+            err(s, error);
+        } else {
+            ok(s, t("cmd.pregen.started", w.getName(), radius, label));
+        }
+    }
+
+    // ------------------------------------------------------------------ Tab-Vervollstaendigung
+
+    @Override
+    public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
+        if (!testPermissionSilent(sender)) {
+            return List.of();
+        }
+        WorldManager wm = WorldManager.get();
+        if (args.length == 1) {
+            List<String> subs = new ArrayList<>();
+            for (String sub : SUB.keySet()) {
+                if (allowed(sender, sub)) {
+                    subs.add(sub);
+                }
+            }
+            return filter(subs, args[0]);
+        }
+        String sub = args[0].toLowerCase(Locale.ROOT);
+        if (!SUB.containsKey(sub) || !allowed(sender, sub)) {
+            return List.of();
+        }
+        if (args.length == 2 && sub.equals("pregen")) {
+            List<String> opts = new ArrayList<>(List.of("stop", "status"));
+            for (World w : Bukkit.getWorlds()) {
+                opts.add(w.getName());
+            }
+            return filter(opts, args[1]);
+        }
+        if (args.length == 2 && wm != null && !sub.equals("create")) {
+            Set<String> names = new LinkedHashSet<>();
+            for (World w : Bukkit.getWorlds()) {
+                names.add(w.getName());
+            }
+            if (!sub.equals("unload")) {
+                names.addAll(wm.worldFoldersOnDisk());
+            }
+            return filter(new ArrayList<>(names), args[1]);
+        }
+        if (args.length == 3) {
+            return switch (sub) {
+                case "create" -> filter(TYPES, args[2]);
+                case "load" -> filter(List.of("normal", "nether", "end"), args[2]);
+                case "unload" -> filter(List.of("nosave"), args[2]);
+                case "delete" -> filter(List.of("confirm"), args[2]);
+                case "autoload" -> filter(List.of("true", "false"), args[2]);
+                case "pregen" -> filter(List.of("1000", "2000", "5000", "10000"), args[2]);
+                case "tp" -> sender.hasPermission(PERM_TP_OTHERS)
+                        ? filter(Bukkit.getOnlinePlayers().stream().map(Player::getName).toList(), args[2]) : List.of();
+                default -> List.of();
+            };
+        }
+        return List.of();
+    }
+
+    private static List<String> filter(List<String> options, String prefix) {
+        String p = prefix.toLowerCase(Locale.ROOT);
+        List<String> out = new ArrayList<>();
+        for (String o : options) {
+            if (o.toLowerCase(Locale.ROOT).startsWith(p)) {
+                out.add(o);
+            }
+        }
+        return out;
+    }
+}
