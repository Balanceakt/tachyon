+                + dev.tachyon.i18n.Lang.t( dev.tachyon.perf.MemoryManager.isTrimEnabled() ? "tps.sleep.trim.on" : "tps.sleep.trim.off" ) );
+        // Tachyon end
+        sender.sendMessage( m + " " + dev.tachyon.i18n.Lang.t( "tps.world.label" ) + tx
+                + dev.tachyon.i18n.Lang.t( "tps.world", org.bukkit.Bukkit.getWorlds().size() ) + sep + dev.tachyon.i18n.Lang.t( "tps.chunks", chunks )
+                + sep + dev.tachyon.i18n.Lang.t( "tps.entities", entities ) + sep
+                + dev.tachyon.i18n.Lang.t( "tps.players", org.bukkit.Bukkit.getOnlinePlayers().size(), org.bukkit.Bukkit.getMaxPlayers() ) );
+        sender.sendMessage( dev.tachyon.text.Style.line( sender ) );
+        // Tachyon end
         return true;
     }
 
+    // Tachyon start
+    private static String colTps(CommandSender sender, double tps)
+    {
+        double v = Math.min( 20.0, tps );
+        return dev.tachyon.text.Style.col( sender, dev.tachyon.text.Style.tpsColor( v ) ) + format1( v );
+    }
+
+    private static String pct(double load)
+    {
+        return load < 0 ? "?" : String.format( java.util.Locale.ROOT, "%.0f %%", load * 100 );
+    }
+
+    private static String cpuColor(double load)
+    {
+        return load < 0.6 ? dev.tachyon.text.Style.C_GOOD : load < 0.85 ? dev.tachyon.text.Style.C_WARN : dev.tachyon.text.Style.C_BAD;
+    }
+
+    private static String vmOption(String name)
+    {
+        try
+        {
+            return java.lang.management.ManagementFactory.getPlatformMXBean( com.sun.management.HotSpotDiagnosticMXBean.class ).getVMOption( name ).getValue();
+        } catch ( Exception e )
+        {
+            return null;
+        }
+    }
+
+    private static String format1(double v)
+    {
+        return String.format( java.util.Locale.ROOT, "%.1f", v );
+    }
+
+    private static String mb(long bytes)
+    {
+        long mb = bytes / ( 1024 * 1024 );
+        return mb >= 1024 ? String.format( java.util.Locale.ROOT, "%.1f GB", mb / 1024.0 ) : mb + " MB";
+    }
+    // Tachyon end
+
     private String format(double tps)
     {
         return ( ( tps > 18.0 ) ? ChatColor.GREEN : ( tps > 16.0 ) ? ChatColor.YELLOW : ChatColor.RED ).toString()
