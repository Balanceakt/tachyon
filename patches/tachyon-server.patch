+
+    // ------------------------------------------------------------------ Tick
+
+    private void tick() {
+        long now = System.nanoTime();
+        boolean slowTick = lastTickNanos != 0 && now - lastTickNanos > 55_000_000L; // letzter Tick > 55 ms
+        lastTickNanos = now;
+        if (!started) {
+            started = true;
+            for (String name : managedWorlds()) {
+                if (isAutoload(name) && Bukkit.getWorld(name) != null) {
+                    continue;
+                }
+                if (isAutoload(name)) {
+                    autoloadQueue.add(name);
+                }
+            }
+            if (!autoloadQueue.isEmpty()) {
+                logger.info("[WorldManager] " + t("wm.log.autoload", autoloadQueue.size()));
+            }
+            // Spawnsuchen fortsetzen, die beim letzten Mal durch einen Stopp unterbrochen wurden
+            for (String name : config.getStringList("internal.pending-spawn")) {
+                World w = Bukkit.getWorld(name);
+                if (w != null && !provisionalSpawn.contains(((CraftWorld) w).getHandle())) {
+                    logger.info("[WorldManager] " + t("wm.log.resume_spawn", name));
+                    resolveSpawn(w, null);
+                }
+            }
+        }
+
+        drainQueue();
+
+        if (pregen != null) {
+            pregen.tick(slowTick);
+        }
+        if (++liveTicks % 5 == 0) {
+            updateLiveBars();
+        }
+        dev.tachyon.perf.DynamicPerformance.tick();
+        dev.tachyon.perf.MemoryManager.tick();
+        if (liveTicks % 200 == 0) {
+            unloadIdleWorlds();
+        }
+
+        // AOT-Trainingslauf (start.bat): kurz laufen lassen, damit Java den Start-Cache aufzeichnen kann, dann beenden.
+        if (AOT_TRAINING && ++trainingTicks == 200) {
+            logger.info("[Tachyon] " + t("wm.log.training_done"));
+            Bukkit.shutdown();
+        }
+
+        if (!autoloadQueue.isEmpty() && ++ticks % autoloadInterval == 0) {
+            String name = autoloadQueue.poll();
+            WorldSpec spec = storedSpec(name);
+            if (spec != null && Bukkit.getWorld(name) == null) {
+                if (!worldFolder(name).isDirectory()) {
+                    logger.warning("[WorldManager] " + t("wm.log.folder_missing", name));
+                } else {
+                    loadOrCreate(spec, true, w -> { },
+                            err -> logger.warning("[WorldManager] " + err));
+                }
+            }
+        }
+    }
+
+    /** Erledigt Rueckmeldungen aus dem Hintergrund (max. 64 pro Tick) auf dem Main-Thread. */
+    private void drainQueue() {
+        Runnable task;
+        int budget = 64;
+        while (budget-- > 0 && (task = mainQueue.poll()) != null) {
+            try {
+                task.run();
+            } catch (Throwable t) {
+                logger.log(Level.SEVERE, "[WorldManager] background task failed", t);
+            }
+        }
+    }
+
+    /** Live-Balken fuer alle Welten, die gerade geladen/erstellt werden (nur echtes Terminal). */
+    private void updateLiveBars() {
+        if (!TachyonConsole.liveSupported()) {
+            return;
+        }
+        for (LoadState st : states.values()) {
+            if (st.ready || st.world == null) {
+                continue;
+            }
+            double fraction;
+            String phase;
+            if (st.searching || st.preloadCenter == null) {
+                fraction = 0.05 + 0.25 * Math.min(1.0, st.candidate / 27.0);
+                phase = t("live.phase.search");
+            } else {
+                ServerLevel level = ((CraftWorld) st.world).getHandle();
+                int loaded = 0;
+                int total = 0;
+                for (int dx = -preloadRadius; dx <= preloadRadius; dx++) {
+                    for (int dz = -preloadRadius; dz <= preloadRadius; dz++) {
+                        total++;
+                        if (level.getChunkSource().getChunkNow(st.preloadCenter.x() + dx, st.preloadCenter.z() + dz) != null) {
+                            loaded++;
+                        }
+                    }
+                }
+                fraction = 0.3 + 0.7 * loaded / Math.max(1, total);
+                phase = t("live.phase.spawn");
+            }
+            TachyonConsole.live("world:" + st.world.getName(), fraction, t("live.world", st.world.getName(), phase), (System.nanoTime() - st.startNanos) / 1e9);
+        }
+    }
+
+    /**
+     * Welten des World-Managers, in denen seit unload-idle-minutes kein Spieler war, speichern und aus dem RAM nehmen.
+     * Sie laden bei Bedarf (/wm tp, Plugin-API) ohne Server-Haenger wieder. Standard- und Plugin-Welten bleiben unberuehrt.
+     */
+    private void unloadIdleWorlds() {
+        if (unloadIdleMinutes <= 0) {
+            return;
+        }
+        long now = System.currentTimeMillis();
+        for (World w : new ArrayList<>(Bukkit.getWorlds())) {
+            String name = w.getName();
+            if (!w.getPlayers().isEmpty()) {
+                lastOccupied.put(name, now);
+                continue;
+            }
+            if (!managedWorlds().contains(name) || isProtected(name) || !isReady(w) || (pregen != null && pregen.world.equals(w))) {
+                continue;
+            }
+            long since = lastOccupied.computeIfAbsent(name, k -> now);
+            if (now - since >= unloadIdleMinutes * 60_000L && unload(name, true) == null) {
+                sleeping.add(name);
+                lastOccupied.remove(name);
+                logger.info("[RAM] " + t("wm.log.idle_unload", name, unloadIdleMinutes));
+            }
+        }
+    }
+
+    /** @return true, solange Welten erstellt/geladen werden oder ein Pregen laeuft (dann nicht schlafen gehen) */
+    public boolean isBusy() {
+        if (pregen != null) {
+            return true;
+        }
+        for (LoadState st : states.values()) {
+            if (!st.ready) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** @return Welten, die wegen Leerlauf ausgelagert wurden und bei Bedarf wieder laden */
+    public Set<String> sleepingWorlds() {
+        sleeping.removeIf(n -> Bukkit.getWorld(n) != null);
+        return sleeping;
+    }
