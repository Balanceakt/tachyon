@@ -0,0 +1,402 @@
+package org.bukkit.craftbukkit.bootstrap;
+
+import java.io.BufferedInputStream;
+import java.io.BufferedReader;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.io.Reader;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.time.LocalTime;
+import java.time.format.DateTimeFormatter;
+import java.util.Locale;
+import java.util.Properties;
+
+/**
+ * Tachyon-Schlafmodus: der Waechter.
+ *
+ * Laeuft statt des Servers, solange dieser schlaeft (java -jar tachyon.jar --tachyon-sleep). Er braucht nur
+ * wenige MB RAM, haelt den Port offen, zeigt in der Serverliste "schlaeft - joinen zum Aufwecken" und beendet
+ * sich mit Exit-Code 10, sobald jemand joinen will. Das Startskript startet daraufhin Tachyon neu.
+ *
+ * Bewusst nur JDK-Klassen: kein Netty, kein Minecraft-Code - darum startet er in Bruchteilen einer Sekunde.
+ */
+final class SleepWatcher {
+
+    static final int EXIT_WAKE = 10;
+    static final int EXIT_STOP = 0;
+    private static final DateTimeFormatter TIME = DateTimeFormatter.ofPattern("HH:mm:ss");
+
+    private final Properties info = new Properties();
+    private final boolean de;
+    private final boolean color;
+    private final long sleepingSince = System.currentTimeMillis();
+    private volatile ServerSocket socket;
+    private volatile int exitCode = -1;
+
+    private SleepWatcher() {
+        Path file = Paths.get(System.getProperty("bundlerRepoDir", "tachyon-libs"), "sleep.properties");
+        try (Reader r = Files.newBufferedReader(file, StandardCharsets.UTF_8)) {
+            info.load(r);
+        } catch (IOException ignored) {
+            // Ohne Datei: Werte aus server.properties bzw. Standardwerte
+        }
+        String lang = info.getProperty("language");
+        de = lang != null ? lang.equals("de") : Main.isGermanPublic();
+        String os = System.getProperty("os.name", "").toLowerCase(Locale.ROOT);
+        color = System.console() != null && (!os.contains("win") || System.getenv("WT_SESSION") != null || System.getenv("ConEmuANSI") != null);
+    }
+
+    static void run() {
+        int code = new SleepWatcher().loop();
+        System.out.flush();
+        System.exit(code);
+    }
+
+    // ------------------------------------------------------------------ Hauptschleife
+
+    private int loop() {
+        int port = intValue("port", serverProperty("server-port", 25565));
+        String ip = info.getProperty("ip", serverProperty("server-ip", ""));
+        ServerSocket server = bind(ip, port);
+        if (server == null) {
+            say(c("93") + (de ? "  Port " + port + " ist belegt - der Waechter kann nicht lauschen. Server startet direkt wieder."
+                    : "  Port " + port + " is in use - the watcher cannot listen. Starting the server again.") + c("0"));
+            return EXIT_WAKE;
+        }
+        socket = server;
+        banner(port);
+
+        Thread console = new Thread(this::readConsole, "Tachyon-Sleep-Console");
+        console.setDaemon(true);
+        console.start();
+
+        while (exitCode < 0) {
+            Socket client;
+            try {
+                client = server.accept();
+            } catch (IOException e) {
+                break; // Socket geschlossen = aufwachen oder beenden
+            }
+            Thread.ofVirtual().start(() -> handle(client));
+        }
+        return exitCode < 0 ? EXIT_WAKE : exitCode;
+    }
+
+    private ServerSocket bind(String ip, int port) {
+        for (int attempt = 0; attempt < 40; attempt++) { // der Server gibt den Port evtl. erst einen Moment spaeter frei
+            try {
+                ServerSocket s = new ServerSocket();
+                s.setReuseAddress(true);
+                InetSocketAddress addr = ip == null || ip.isBlank() ? new InetSocketAddress(port) : new InetSocketAddress(InetAddress.getByName(ip), port);
+                s.bind(addr, 50);
+                return s;
+            } catch (IOException e) {
+                try {
+                    Thread.sleep(250);
+                } catch (InterruptedException ie) {
+                    return null;
+                }
+            }
+        }
+        return null;
+    }
+
+    private synchronized void finish(int code) {
+        if (exitCode >= 0) {
+            return;
+        }
+        exitCode = code;
+        try {
+            socket.close();
+        } catch (IOException ignored) {
+        }
+    }
+
+    // ------------------------------------------------------------------ Konsole
+
+    private void banner(int port) {
+        long ram = longValue("ram", 0);
+        String freed = ram > 0 ? String.format(Locale.ROOT, de ? "ca. %s" : "about %s", size(ram)) : (de ? "der gesamte Server-RAM" : "all server RAM");
+        say("");
+        say("   " + c("95;1") + (de ? "Zzz  TACHYON SCHLAEFT" : "Zzz  TACHYON IS SLEEPING") + c("0"));
+        say("   " + c("90") + "-".repeat(60) + c("0"));
+        say("   " + label(de ? "RAM frei" : "RAM freed") + c("92;1") + freed + c("0") + c("90") + (de ? "  (der Waechter selbst braucht ca. 30-40 MB)" : "  (the watcher itself needs about 30-40 MB)") + c("0"));
+        say("   " + label(de ? "Welten" : "Worlds") + (de ? "gespeichert auf der SSD/HDD" : "saved on disk"));
+        say("   " + label("Port") + port + c("90") + (de ? "  - in der Serverliste: \"schlaeft, joinen zum Aufwecken\"" : "  - server list shows \"sleeping, join to wake up\"") + c("0"));
+        say("   " + label(de ? "Aufwachen" : "Wake up") + (de ? "sobald ein Spieler joint (Start in wenigen Sekunden)" : "as soon as a player joins (starts in a few seconds)"));
+        say("   " + label(de ? "Befehle" : "Commands") + c("96") + "wake" + c("0") + (de ? " = jetzt aufwecken  |  " : " = wake up now  |  ") + c("96") + "stop" + c("0")
+                + (de ? " = ganz beenden" : " = shut down completely"));
+        say("");
+    }
+
+    private String label(String l) {
+        return c("90") + l + " ".repeat(Math.max(1, 12 - l.length())) + c("0");
+    }
+
+    private void readConsole() {
+        try {
+            BufferedReader in = new BufferedReader(new InputStreamReader(System.in));
+            String line;
+            while ((line = in.readLine()) != null && exitCode < 0) {
+                String cmd = line.trim().toLowerCase(Locale.ROOT);
+                if (cmd.isEmpty()) {
+                    continue;
+                }
+                switch (cmd) {
+                    case "wake", "start", "aufwachen", "wach", "up" -> {
+                        log(c("92") + (de ? "Wird geweckt (Konsole)..." : "Waking up (console)...") + c("0"));
+                        finish(EXIT_WAKE);
+                    }
+                    case "stop", "end", "exit", "quit", "beenden" -> {
+                        log(de ? "Wird beendet." : "Shutting down.");
+                        finish(EXIT_STOP);
+                    }
+                    default -> log(de ? "Unbekannt. Befehle: wake = aufwecken, stop = beenden" : "Unknown. Commands: wake, stop");
+                }
+            }
+        } catch (IOException ignored) {
+            // keine Konsole (Panel ohne Eingabe) - dann weckt nur ein Join
+        }
+    }
+
+    private void say(String s) {
+        synchronized (System.out) {
+            System.out.println(s);
+        }
+    }
+
+    private void log(String msg) {
+        say(c("90") + LocalTime.now().format(TIME) + c("0") + " " + c("95") + "Zzz" + c("0") + " " + msg);
+    }
+
+    private String c(String code) {
+        return color ? "\u001B[" + code + "m" : "";
+    }
+
+    // ------------------------------------------------------------------ Minecraft-Protokoll (Handshake, Status, Login)
+
+    private void handle(Socket s) {
+        try (s) {
+            s.setSoTimeout(5000);
+            s.setTcpNoDelay(true);
+            InputStream in = new BufferedInputStream(s.getInputStream());
+            OutputStream out = s.getOutputStream();
+            in.mark(1);
+            int first = in.read();
+            if (first == -1 || first == 0xFE) {
+                return; // uralter Client-Ping - einfach schliessen
+            }
+            in.reset();
+            byte[] handshake = readPacket(in);
+            if (handshake == null) {
+                return;
+            }
+            DataInputStream hs = new DataInputStream(new ByteArrayInputStream(handshake));
+            if (readVarInt(hs) != 0x00) {
+                return;
+            }
+            int clientProtocol = readVarInt(hs);
+            readString(hs); // Adresse
+            hs.readUnsignedShort(); // Port
+            int next = readVarInt(hs);
+            if (next == 1) {
+                status(in, out, clientProtocol);
+            } else if (next == 2 || next == 3) {
+                login(in, out);
+            }
+        } catch (IOException ignored) {
+            // Verbindungsabbruch, Timeout, Portscanner - egal
+        }
+    }
+
+    private void status(InputStream in, OutputStream out, int clientProtocol) throws IOException {
+        byte[] request = readPacket(in);
+        if (request == null || request.length < 1 || request[0] != 0x00) {
+            return;
+        }
+        writePacket(out, 0x00, string(statusJson(clientProtocol)));
+        byte[] ping = readPacket(in);
+        if (ping != null && ping.length == 9 && ping[0] == 0x01) {
+            writeVarInt(out, ping.length);
+            out.write(ping); // Pong = gleiche Zahl zurueck
+            out.flush();
+        }
+    }
+
+    private void login(InputStream in, OutputStream out) throws IOException {
+        String name = "?";
+        byte[] hello = readPacket(in);
+        if (hello != null && hello.length > 1 && hello[0] == 0x00) {
+            name = readString(new DataInputStream(new ByteArrayInputStream(hello, 1, hello.length - 1)));
+        }
+        writePacket(out, 0x00, string(kickJson()));
+        String safe = name.replaceAll("[^A-Za-z0-9_]", "");
+        log(c("92") + (de ? safe + " will joinen - Tachyon wird geweckt..." : safe + " wants to join - waking Tachyon up...") + c("0"));
+        finish(EXIT_WAKE);
+    }
+
+    private String statusJson(int clientProtocol) {
+        int protocol = intValue("protocol", clientProtocol);
+        String version = info.getProperty("version", "Tachyon");
+        String motd = info.getProperty("motd", "§b⚡ Tachyon");
+        String line2 = de ? "§d☾ §7Server schläft §8· §ejoinen zum Aufwecken"
+                : "§d☾ §7Server is sleeping §8· §ejoin to wake it up";
+        StringBuilder sb = new StringBuilder(256);
+        sb.append("{\"version\":{\"name\":").append(json(version)).append(",\"protocol\":").append(protocol).append('}');
+        sb.append(",\"players\":{\"max\":").append(intValue("max-players", 20)).append(",\"online\":0,\"sample\":[]}");
+        sb.append(",\"description\":{\"text\":").append(json(motd + "\n" + line2)).append('}');
+        String favicon = info.getProperty("favicon");
+        if (favicon != null && !favicon.isEmpty()) {
+            sb.append(",\"favicon\":").append(json("data:image/png;base64," + favicon));
+        }
+        sb.append(",\"enforcesSecureChat\":false}");
+        return sb.toString();
+    }
+
+    private String kickJson() {
+        String a = de ? " wacht gerade auf!" : " is waking up!";
+        String b = de ? "Der Server war im Schlafmodus und startet jetzt.\nVerbinde dich in ein paar Sekunden erneut."
+                : "The server was sleeping and is starting now.\nJoin again in a few seconds.";
+        return "{\"text\":\"\",\"extra\":[{\"text\":\"⚡ Tachyon\",\"color\":\"aqua\",\"bold\":true},{\"text\":" + json(a + "\n\n")
+                + ",\"color\":\"white\"},{\"text\":" + json(b) + ",\"color\":\"gray\"}]}";
+    }
+
+    // ------------------------------------------------------------------ Hilfen
+
+    private static byte[] readPacket(InputStream in) throws IOException {
+        int len = readVarInt(in);
+        if (len <= 0 || len > 32 * 1024) {
+            return null;
+        }
+        byte[] data = in.readNBytes(len);
+        return data.length == len ? data : null;
+    }
+
+    private static void writePacket(OutputStream out, int id, byte[] payload) throws IOException {
+        ByteArrayOutputStream body = new ByteArrayOutputStream(payload.length + 5);
+        writeVarInt(body, id);
+        body.write(payload);
+        ByteArrayOutputStream frame = new ByteArrayOutputStream(body.size() + 5);
+        writeVarInt(frame, body.size());
+        body.writeTo(frame);
+        out.write(frame.toByteArray());
+        out.flush();
+    }
+
+    private static int readVarInt(InputStream in) throws IOException {
+        int value = 0;
+        for (int i = 0; i < 5; i++) {
+            int b = in.read();
+            if (b == -1) {
+                throw new IOException("EOF");
+            }
+            value |= (b & 0x7F) << (7 * i);
+            if ((b & 0x80) == 0) {
+                return value;
+            }
+        }
+        throw new IOException("VarInt too big");
+    }
+
+    private static void writeVarInt(OutputStream out, int value) throws IOException {
+        while ((value & ~0x7F) != 0) {
+            out.write((value & 0x7F) | 0x80);
+            value >>>= 7;
+        }
+        out.write(value);
+    }
+
+    private static String readString(InputStream in) throws IOException {
+        int len = readVarInt(in);
+        if (len < 0 || len > 1024) {
+            throw new IOException("bad string");
+        }
+        return new String(in.readNBytes(len), StandardCharsets.UTF_8);
+    }
+
+    private static byte[] string(String s) throws IOException {
+        byte[] b = s.getBytes(StandardCharsets.UTF_8);
+        ByteArrayOutputStream out = new ByteArrayOutputStream(b.length + 5);
+        writeVarInt(out, b.length);
+        out.write(b);
+        return out.toByteArray();
+    }
+
+    private static String json(String s) {
+        StringBuilder sb = new StringBuilder(s.length() + 2).append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char ch = s.charAt(i);
+            switch (ch) {
+                case '"' -> sb.append("\\\"");
+                case '\\' -> sb.append("\\\\");
+                case '\n' -> sb.append("\\n");
+                case '\r' -> sb.append("\\r");
+                case '\t' -> sb.append("\\t");
+                default -> {
+                    if (ch < 0x20) {
+                        sb.append(String.format("\\u%04x", (int) ch));
+                    } else {
+                        sb.append(ch);
+                    }
+                }
+            }
+        }
+        return sb.append('"').toString();
+    }
+
+    private int intValue(String key, int def) {
+        try {
+            return Integer.parseInt(info.getProperty(key, "").trim());
+        } catch (NumberFormatException e) {
+            return def;
+        }
+    }
+
+    private long longValue(String key, long def) {
+        try {
+            return Long.parseLong(info.getProperty(key, "").trim());
+        } catch (NumberFormatException e) {
+            return def;
+        }
+    }
+
+    private static <T> T serverProperty(String key, T def) {
+        try {
+            Properties p = new Properties();
+            try (Reader r = Files.newBufferedReader(Paths.get("server.properties"), StandardCharsets.UTF_8)) {
+                p.load(r);
+            }
+            String v = p.getProperty(key);
+            if (v == null || v.isBlank()) {
+                return def;
+            }
+            if (def instanceof Integer) {
+                @SuppressWarnings("unchecked")
+                T t = (T) Integer.valueOf(v.trim());
+                return t;
+            }
+            @SuppressWarnings("unchecked")
+            T t = (T) v.trim();
+            return t;
+        } catch (Exception e) {
+            return def;
+        }
+    }
+
+    private static String size(long bytes) {
+        double mb = bytes / (1024.0 * 1024.0);
+        return mb >= 1024 ? String.format(Locale.ROOT, "%.1f GB", mb / 1024.0) : String.format(Locale.ROOT, "%.0f MB", mb);
+    }
+}
