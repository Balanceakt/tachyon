+    // ------------------------------------------------------------------ Laden / Erstellen
+
+    public File worldFolder(String name) {
+        return new File(Bukkit.getWorldContainer(), name);
+    }
+
+    public boolean worldExistsOnDisk(String name) {
+        return new File(worldFolder(name), "level.dat").isFile();
+    }
+
+    public boolean isReady(World world) {
+        LoadState st = states.get(world.getName().toLowerCase(Locale.ROOT));
+        return st == null || st.ready;
+    }
+
+    /**
+     * Laedt oder erstellt eine Welt ohne den Main-Thread zu blockieren.
+     * onReady wird auf dem Main-Thread aufgerufen, sobald der Spawnbereich generiert ist.
+     */
+    public void loadOrCreate(WorldSpec spec, boolean autoload, Consumer<World> onReady, Consumer<String> onError) {
+        if (!VALID_NAME.matcher(spec.name()).matches()) {
+            onError.accept(t("wm.err.invalid_name"));
+            return;
+        }
+        String key = spec.name().toLowerCase(Locale.ROOT);
+        World existing = Bukkit.getWorld(spec.name());
+        if (existing != null) {
+            whenReady(existing, onReady);
+            return;
+        }
+        LoadState pending = states.get(key);
+        if (pending != null && !pending.ready) {
+            pending.waiters.add(onReady);
+            return;
+        }
+
+        boolean isNew = !worldExistsOnDisk(spec.name());
+        long start = System.nanoTime();
+        World world;
+        managerDepth++;
+        try {
+            world = Bukkit.createWorld(spec.toCreator());
+        } catch (Throwable t) {
+            logger.log(Level.SEVERE, "[WorldManager] " + t("wm.err.load_failed", spec.name(), String.valueOf(t.getMessage())), t);
+            onError.accept(t("wm.err.load_failed", spec.name(), String.valueOf(t.getMessage())));
+            return;
+        } finally {
+            managerDepth--;
+        }
+        if (world == null) {
+            onError.accept(t("wm.err.load_failed", spec.name(), "-"));
+            return;
+        }
+        double ms = (System.nanoTime() - start) / 1_000_000.0;
+
+        lastOccupied.put(world.getName(), System.currentTimeMillis());
+        sleeping.remove(world.getName());
+
+        LoadState st = new LoadState();
+        st.created = isNew;
+        st.world = world;
+        st.startNanos = start;
+        st.mainThreadMs = ms;
+        st.waiters.add(onReady);
+        states.put(key, st);
+        storeSpec(spec, autoload);
+
+        ServerLevel level = ((CraftWorld) world).getHandle();
+        String resolvedKey = "worlds." + spec.name() + ".spawn-resolved";
+        boolean provisional = provisionalSpawn.remove(level);
+        boolean unresolved = config.contains(resolvedKey) && !config.getBoolean(resolvedKey);
+        if (provisional || unresolved) {
+            config.set(resolvedKey, false); // falls der Server vor dem Ende der Suche stoppt
+            saveConfig();
+            resolveSpawn(world, st);
+        } else {
+            preloadSpawn(world, st);
+        }
+    }
+
+    private void whenReady(World world, Consumer<World> callback) {
+        LoadState st = states.get(world.getName().toLowerCase(Locale.ROOT));
+        if (st == null || st.ready) {
+            callback.accept(world);
+        } else {
+            st.waiters.add(callback);
+        }
+    }
+
+    // ------------------------------------------------------------------ Asynchrone Spawnsuche
+
+    private void resolveSpawn(World world, LoadState st) {
+        final LoadState state = st != null ? st : states.computeIfAbsent(world.getName().toLowerCase(Locale.ROOT), k -> {
+            LoadState n = new LoadState();
+            n.quiet = true; // Hauptwelten beim Start / Plugin-Welten: Live-Balken ja, aber keine eigene Logzeile
+            return n;
+        });
+        state.world = world;
+        state.searching = true;
+        ServerLevel level = ((CraftWorld) world).getHandle();
+        Location provisional = world.getSpawnLocation();
+        ChunkPos origin = new ChunkPos(provisional.getBlockX() >> 4, provisional.getBlockZ() >> 4);
+        List<ChunkPos> candidates = spiral(origin, SPAWN_SEARCH_RADIUS);
+        tryCandidate(world, level, candidates, 0, state);
+    }
+
+    private void tryCandidate(World world, ServerLevel level, List<ChunkPos> candidates, int index, LoadState st) {
+        if (Bukkit.getWorld(world.getUID()) == null) {
+            return; // Welt wurde inzwischen entladen
+        }
+        if (index >= candidates.size()) {
+            // Nichts gefunden (sehr selten, z.B. Ozean): hoechsten Block am Ursprung nehmen - Chunk ist schon geladen.
+            Location loc = world.getSpawnLocation();
+            int y = world.getHighestBlockYAt(loc.getBlockX(), loc.getBlockZ()) + 1;
+            finishSpawn(world, st, loc.getBlockX(), y, loc.getBlockZ());
+            return;
+        }
+        // Paketweise: die naechsten SPAWN_BATCH Kandidaten gleichzeitig generieren lassen (Worldgen-Threads),
+        // danach in Spiral-Reihenfolge pruefen - gleicher Spawn wie bei der Einzelsuche, aber viel schneller.
+        int end = Math.min(candidates.size(), index + SPAWN_BATCH);
+        st.candidate = index;
+        java.util.concurrent.CompletableFuture<?>[] loads = new java.util.concurrent.CompletableFuture<?>[end - index];
+        for (int i = index; i < end; i++) {
+            loads[i - index] = level.getChunkSource().addTicketAndLoadWithRadius(TicketType.TACHYON_WORLD_PRELOAD, candidates.get(i), 0);
+        }
+        java.util.concurrent.CompletableFuture.allOf(loads).whenComplete((result, error) -> mainQueue.add(() -> {
+            if (Bukkit.getWorld(world.getUID()) == null) {
+                return;
+            }
+            for (int i = index; i < end; i++) {
+                if (loads[i - index].isCompletedExceptionally()) {
+                    continue;
+                }
+                BlockPos spawn = PlayerSpawnFinder.getSpawnPosInChunk(level, candidates.get(i));
+                if (spawn != null) {
+                    finishSpawn(world, st, spawn.getX(), spawn.getY(), spawn.getZ());
+                    return;
+                }
+            }
+            tryCandidate(world, level, candidates, end, st);
+        }));
+    }
+
+    private void finishSpawn(World world, LoadState st, int x, int y, int z) {
+        world.setSpawnLocation(x, y, z);
+        if (config.contains("worlds." + world.getName())) {
+            config.set("worlds." + world.getName() + ".spawn-resolved", true);
+        }
+        setPendingSpawn(world.getName(), false);
+        preloadSpawn(world, st);
+    }
+
+    /** Merkt sich Welten mit noch provisorischem Spawn dauerhaft (internal.pending-spawn in tachyon.yml). */
+    private void setPendingSpawn(String worldName, boolean pending) {
+        List<String> list = new ArrayList<>(config.getStringList("internal.pending-spawn"));
+        boolean changed = pending ? !list.contains(worldName) && list.add(worldName) : list.remove(worldName);
+        if (changed) {
+            config.set("internal.pending-spawn", list.isEmpty() ? null : list);
+            saveConfig();
+        } else if (!pending) {
+            saveConfig();
+        }
+    }
+
+    private void preloadSpawn(World world, LoadState st) {
+        ServerLevel level = ((CraftWorld) world).getHandle();
+        Location spawn = world.getSpawnLocation();
+        ChunkPos center = new ChunkPos(spawn.getBlockX() >> 4, spawn.getBlockZ() >> 4);
+        st.world = world;
+        st.searching = false;
+        st.preloadCenter = center;
+        level.getChunkSource().addTicketAndLoadWithRadius(TicketType.TACHYON_WORLD_PRELOAD, center, preloadRadius)
+                .whenComplete((result, error) -> mainQueue.add(() -> {
+                    st.ready = true;
+                    TachyonConsole.liveDone("world:" + world.getName());
+                    if (!st.quiet) {
+                        logger.info("[WorldManager] \u2714 " + t("wm.log.ready", world.getName(), t(st.created ? "wm.word.created" : "wm.word.loaded"),
+                                st.mainThreadMs, (System.nanoTime() - st.startNanos) / 1e9));
+                    }
+                    if (Bukkit.getWorld(world.getUID()) != null) {
+                        Bukkit.getPluginManager().callEvent(new TachyonWorldReadyEvent(world, st.created));
+                    }
+                    List<Consumer<World>> waiters = new ArrayList<>(st.waiters);
+                    st.waiters.clear();
+                    for (Consumer<World> w : waiters) {
+                        try {
+                            w.accept(world);
+                        } catch (Throwable t) {
+                            logger.log(Level.WARNING, "[WorldManager] ready callback failed", t);
+                        }
+                    }
+                }));
+    }
+
+    private static List<ChunkPos> spiral(ChunkPos origin, int radius) {
+        List<ChunkPos> out = new ArrayList<>((radius * 2 + 1) * (radius * 2 + 1));
+        out.add(origin);
+        for (int r = 1; r <= radius; r++) {
+            for (int dx = -r; dx <= r; dx++) {
+                for (int dz = -r; dz <= r; dz++) {
+                    if (Math.max(Math.abs(dx), Math.abs(dz)) == r) {
+                        out.add(new ChunkPos(origin.x() + dx, origin.z() + dz));
+                    }
+                }
+            }
+        }
+        return out;
+    }
