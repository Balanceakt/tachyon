+    private void storeSpec(WorldSpec spec, boolean autoload) {
+        String p = "worlds." + spec.name() + ".";
+        config.set(p + "environment", spec.environment().name());
+        config.set(p + "type", spec.type().name().toLowerCase(Locale.ROOT));
+        config.set(p + "structures", spec.structures());
+        config.set(p + "autoload", autoload);
+        saveConfig();
+    }
+
+    public WorldSpec storedSpec(String name) {
+        ConfigurationSection s = worldSection(name);
+        if (s == null) {
+            return null;
+        }
+        World.Environment env;
+        try {
+            env = World.Environment.valueOf(s.getString("environment", "NORMAL"));
+        } catch (IllegalArgumentException e) {
+            env = World.Environment.NORMAL;
+        }
+        WorldSpec.Type type = WorldSpec.Type.parse(s.getString("type", "normal"));
+        return new WorldSpec(name, env, type == null ? WorldSpec.Type.NORMAL : type, null, s.getBoolean("structures", true));
+    }
+
+    public Set<String> managedWorlds() {
+        ConfigurationSection s = config.getConfigurationSection("worlds");
+        return s == null ? Set.of() : new TreeSet<>(s.getKeys(false));
+    }
