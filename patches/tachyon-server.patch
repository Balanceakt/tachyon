+package dev.tachyon;
+
+/**
+ * Zentrale Stelle fuer das Branding von Tachyon.
+ * Zum Umbenennen reicht es, NAME zu aendern.
+ */
+public final class Tachyon {
+
+    /** Name, der im F3-Menue, in der Serverliste, bei /version und im Log erscheint. */
+    public static final String NAME = "Tachyon";
+
+    /** Minecraft-Version, auf der diese Tachyon-Version basiert. */
+    public static final String MC_VERSION = "26.3";
+
+    /**
+     * MOTD in der Serverliste (2 Zeilen, Minecraft-Farbcodes).
+     * Zeile 1: "Powered by TACHYON" mit Blitzen, Zeile 2: was Tachyon ausmacht.
+     */
+    public static final String DEFAULT_MOTD =
+            "\u00A7d\u00A7l\u26A1 \u00A7b\u00A7lPowered by \u00A7d\u00A7l" + NAME.toUpperCase(java.util.Locale.ROOT) + " \u00A7d\u00A7l\u26A1"
+            + "\n\u00A78\u00BB \u00A7aKeine Lags \u00A78\u2502 \u00A7bTurbo-Start \u00A78\u2502 \u00A7eWorld-Manager";
+
+    /** Unveraenderte Vanilla-MOTD (oder die alte schlichte Tachyon-MOTD) automatisch durch die Tachyon-MOTD ersetzen. */
+    public static String motd(String configured) {
+        if (configured == null || configured.isEmpty() || "A Minecraft Server".equals(configured) || ("Powered by " + NAME).equals(configured)) {
+            return DEFAULT_MOTD;
+        }
+        return configured;
+    }
+
+    private Tachyon() {
+    }
+}
diff --git a/src/main/java/dev/tachyon/console/TachyonConsole.java b/src/main/java/dev/tachyon/console/TachyonConsole.java
new file mode 100644
index 000000000..9ed6d989e
--- /dev/null
+++ b/src/main/java/dev/tachyon/console/TachyonConsole.java
@@ -0,0 +1,661 @@
+package dev.tachyon.console;
+
+import dev.tachyon.Tachyon;
+import dev.tachyon.i18n.Lang;
+import static dev.tachyon.i18n.Lang.t;
+import java.io.PrintStream;
+import java.lang.management.ManagementFactory;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.StringJoiner;
+import java.util.concurrent.CountDownLatch;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.plugin.Plugin;
+
+/**
+ * Moderne Konsolenausgabe von Tachyon.
+ *
+ * Beim Start: Banner, EIN Ladebalken, der sich selbst aktualisiert, und keine INFO-Flut - nur Warnungen
+ * und Fehler erscheinen. Alles landet trotzdem vollstaendig in logs/latest.log. Am Ende eine Zusammenfassung.
+ * Danach normale (eingefaerbte) Log-Ausgabe.
+ *
+ * Kostet im laufenden Betrieb nichts: der Ladebalken existiert nur waehrend des Starts.
+ * Schalter: -Dtachyon.verboseStartup=true (altes ausfuehrliches Log), -Dtachyon.noColor=true (keine Farben).
+ */
+public final class TachyonConsole {
+
+    public static final String RESET = "\u001B[0m";
+    public static final String DIM = "\u001B[90m";
+    public static final String BOLD = "\u001B[1m";
+    public static final String CYAN = "\u001B[96m";
+    public static final String GREEN = "\u001B[92m";
+    public static final String YELLOW = "\u001B[93m";
+    public static final String RED = "\u001B[91m";
+    public static final String MAGENTA = "\u001B[95m";
+    public static final String BLUE = "\u001B[94m";
+    private static final String CLEAR_LINE = "\r\u001B[2K";
+
+    private static final String[] LOGO = {
+        " _____  _    ____ _   ___   _____  _   _ ",
+        "|_   _|/ \\  / ___| | | \\ \\ / / _ \\| \\ | |",
+        "  | | / _ \\| |   | |_| |\\ V / | | |  \\| |",
+        "  | |/ ___ \\ |___|  _  | | || |_| | |\\  |",
+        "  |_/_/   \\_\\____|_| |_| |_| \\___/|_| \\_|",
+    };
+    /** Farbverlauf Cyan -> Blau -> Magenta (256 Farben). */
+    private static final int[] GRADIENT = {51, 45, 39, 63, 135};
+
+    private static final PrintStream OUT = System.out; // vor jeder Umleitung durch Minecraft/Bukkit
+    private static final boolean COLOR = detectColor();
+    /** Echtes Terminal: Zeile kann ueberschrieben werden, Unicode/Farben moeglich. */
+    private static final boolean INTERACTIVE = COLOR;
+    private static final boolean VERBOSE = Boolean.getBoolean("tachyon.verboseStartup");
+    private static final String SEP = INTERACTIVE ? "  \u00B7  " : "  |  ";
+
+    private static final Object LOCK = new Object();
+    private static final CountDownLatch STARTUP_DONE = new CountDownLatch(1);
+    private static volatile boolean startupActive = true;
+    private static volatile boolean loggerMode;
+    private static String barLine = "";
+    private static String lastPhase = "";
+    private static int warnings;
+    private static int errors;
+
+    static {
+        if (VERBOSE) {
+            System.setProperty("tachyon.startupLevel", "INFO"); // vor der log4j-Initialisierung, siehe log4j2.xml
+        }
+    }
+
+    private TachyonConsole() {
+    }
+
+    private static org.apache.logging.log4j.Logger log() {
+        return org.apache.logging.log4j.LogManager.getLogger("Tachyon");
+    }
+
+    private static boolean detectColor() {
+        if (Boolean.getBoolean("tachyon.noColor") || System.getenv("NO_COLOR") != null) {
+            return false;
+        }
+        java.io.Console console = System.console();
+        if (console == null || !console.isTerminal()) {
+            return false; // Pipe / Hosting-Panel / Datei
+        }
+        if (!System.getProperty("os.name", "").toLowerCase(Locale.ROOT).contains("win")) {
+            return true;
+        }
+        // Windows: Windows Terminal (Standard unter Windows 11) und VS Code koennen ANSI immer
+        if (System.getenv("WT_SESSION") != null || "vscode".equals(System.getenv("TERM_PROGRAM")) || System.getenv("ANSICON") != null) {
+            return true;
+        }
+        // Klassisches Konsolenfenster (conhost): ANSI-Verarbeitung selbst einschalten
+        return enableWindowsVirtualTerminal();
+    }
+
+    /** Schaltet in der klassischen Windows-Konsole die ANSI-Verarbeitung ein (ENABLE_VIRTUAL_TERMINAL_PROCESSING). */
+    private static boolean enableWindowsVirtualTerminal() {
+        try {
+            com.sun.jna.platform.win32.Kernel32 kernel = com.sun.jna.platform.win32.Kernel32.INSTANCE;
+            com.sun.jna.platform.win32.WinNT.HANDLE out = kernel.GetStdHandle(com.sun.jna.platform.win32.Wincon.STD_OUTPUT_HANDLE);
+            com.sun.jna.ptr.IntByReference mode = new com.sun.jna.ptr.IntByReference();
+            if (!kernel.GetConsoleMode(out, mode)) {
+                return false;
+            }
+            int current = mode.getValue();
+            return (current & 0x0004) != 0 || kernel.SetConsoleMode(out, current | 0x0004);
+        } catch (Throwable t) {
+            return false; // kein JNA / keine echte Konsole: dann eben ohne Farben
+        }
+    }
+
+    private static String c(String code) {
+        return COLOR ? code : "";
+    }
+
+    private static double uptimeSeconds() {
+        return Math.max(0, ManagementFactory.getRuntimeMXBean().getUptime() - promptNanos / 1_000_000) / 1000.0;
+    }
+
+    public static boolean isStartupActive() {
+        return startupActive && !VERBOSE;
+    }
+
+    // ------------------------------------------------------------------ Banner + Ladebalken
+
+    /** Ganz am Anfang, noch bevor Minecraft geladen wird. */
+    public static void banner() {
+        Runtime rt = Runtime.getRuntime();
+        OUT.println();
+        for (int i = 0; i < LOGO.length; i++) {
+            OUT.println("   " + (COLOR ? "\u001B[1;38;5;" + GRADIENT[i] + "m" : "") + LOGO[i] + c(RESET));
+        }
+        OUT.println();
+        if (Lang.needsChoice()) {
+            askLanguage();
+        }
+        OUT.println("   " + c(BOLD) + Tachyon.NAME + " " + Tachyon.MC_VERSION + c(RESET) + c(DIM)
+                + SEP + t("console.tagline") + SEP + "Java " + Runtime.version().feature()
+                + SEP + formatMb(rt.maxMemory()) + " " + t("console.ram") + SEP + rt.availableProcessors() + " " + t("console.threads") + c(RESET));
+        OUT.println();
+        progress(0.05, t("progress.java"));
+    }
+
+    /** Fortschritt melden (0..1). Im Terminal wird dieselbe Zeile ueberschrieben. */
+    public static void progress(double fraction, String label) {
+        if (VERBOSE) {
+            stepLine(fraction, label);
+            return;
+        }
+        if (!startupActive) {
+            return;
+        }
+        synchronized (LOCK) {
+            barLine = renderBar(fraction, label);
+            if (INTERACTIVE) {
+                OUT.print(CLEAR_LINE + barLine);
+                OUT.flush();
+            } else {
+                // Pipes/Panels koennen keine Zeile ueberschreiben: nur Hauptphasen als eigene Zeile
+                String phase = label.contains(":") ? label.substring(0, label.indexOf(':')) : label;
+                if (!phase.equals(lastPhase)) {
+                    lastPhase = phase;
+                    OUT.println(barLine);
+                }
+            }
+        }
+    }
+
+    /** Hauptphasen des Starts. */
+    public static void step(String key) {
+        double f = switch (key) {
+            case "core" -> 0.35;
+            case "config" -> 0.50;
+            case "plugins" -> 0.75;
+            case "worlds" -> 0.97;
+            default -> 0.05;
+        };
+        progress(f, t("progress." + key));
+    }
+
+    // ------------------------------------------------------------------ Fragen in der Konsole (erster Start)
+
+    /** Liest eine Zeile direkt von der Konsole (vor dem Start von jline). null = keine Eingabe moeglich. */
+    /** Zeit, die der Start auf Eingaben gewartet hat (Sprache, EULA) - zaehlt nicht zur Startzeit. */
+    private static volatile long promptNanos;
+
+    private static String readLine() {
+        long waitStart = System.nanoTime();
+        try {
+            return readLine0();
+        } finally {
+            promptNanos += System.nanoTime() - waitStart;
+        }
+    }
+
+    private static String readLine0() {
+        try {
+            StringBuilder sb = new StringBuilder();
+            int b;
+            while ((b = System.in.read()) != -1) {
+                if (b == '\n') {
+                    return sb.toString().strip();
+                }
+                if (b != '\r') {
+                    sb.append((char) b);
+                }
+            }
+            return sb.length() > 0 ? sb.toString().strip() : null;
+        } catch (java.io.IOException e) {
+            return null;
+        }
+    }
+
+    /** Sprachwahl beim ersten Start. Enter = Systemsprache. */
+    private static void askLanguage() {
+        String def = Lang.systemDefault();
+        synchronized (LOCK) {
+            OUT.println("   " + c(BOLD) + c(CYAN) + "Sprache waehlen / Choose language" + c(RESET));
+            OUT.println("     " + c(BOLD) + "[1]" + c(RESET) + " Deutsch" + ("de".equals(def) ? c(DIM) + "  (Enter)" + c(RESET) : ""));
+            OUT.println("     " + c(BOLD) + "[2]" + c(RESET) + " English" + ("en".equals(def) ? c(DIM) + "  (Enter)" + c(RESET) : ""));
+            OUT.print("   > ");
+            OUT.flush();
+        }
+        String in = readLine();
+        String choice = def;
+        if (in != null) {
+            String v = in.toLowerCase(Locale.ROOT);
+            if (v.equals("1") || v.startsWith("de")) {
+                choice = "de";
+            } else if (v.equals("2") || v.startsWith("en")) {
+                choice = "en";
+            }
+        }
+        Lang.choose(choice);
+        OUT.println("   " + c(GREEN) + t("setup.language.chosen") + c(RESET));
+        OUT.println();
+    }
+
+    /**
+     * EULA direkt in der Konsole annehmen, damit man den Server nicht neu starten muss.
+     *
+     * @param eulaFile Pfad zur eula.txt
+     * @return true, wenn angenommen (eula.txt wurde geschrieben)
+     */
+    public static boolean askEula(java.nio.file.Path eulaFile) {
+        synchronized (LOCK) {
+            if (INTERACTIVE) {
+                OUT.print(CLEAR_LINE);
+            }
+            OUT.println();
+            OUT.println("   " + c(BOLD) + c(YELLOW) + t("setup.eula.title") + c(RESET));
+            OUT.println("   " + t("setup.eula.text"));
+            OUT.println("   " + c(CYAN) + "https://aka.ms/MinecraftEULA" + c(RESET));
+            OUT.print("   " + c(BOLD) + t("setup.eula.question") + c(RESET));
+            OUT.flush();
+        }
+        String in = readLine();
+        boolean yes = false;
+        if (in != null) {
+            for (String word : t("setup.eula.yes").split(",")) {
+                if (in.equalsIgnoreCase(word.strip())) {
+                    yes = true;
+                    break;
+                }
+            }
+        }
+        if (!yes) {
+            OUT.println("   " + c(RED) + t("setup.eula.declined") + c(RESET));
+            return false;
+        }
+        try {
+            java.nio.file.Files.writeString(eulaFile, "#By changing the setting below to TRUE you are indicating your agreement to our EULA (https://aka.ms/MinecraftEULA).\n"
+                    + "#" + java.time.ZonedDateTime.now() + "\neula=true\n", java.nio.charset.StandardCharsets.UTF_8);
+        } catch (java.io.IOException e) {
+            OUT.println("   " + c(RED) + e.getMessage() + c(RESET));
+            return false;
+        }
+        OUT.println("   " + c(GREEN) + t("setup.eula.accepted") + c(RESET));
+        OUT.println();
+        synchronized (LOCK) {
+            if (!barLine.isEmpty()) {
+                OUT.print(INTERACTIVE ? barLine : "");
+                OUT.flush();
+            }
+        }
+        return true;
+    }
+
+    /** Unterschritt innerhalb einer Phase, z.B. Plugin 3 von 12 (von..bis = Anteil am Gesamtbalken). */
+    public static void subProgress(double from, double to, int index, int total, String label) {
+        double f = total <= 0 ? to : from + (to - from) * index / (double) total;
+        progress(f, label);
+    }
+
+    private static String renderBar(double fraction, String label) {
+        int width = 30;
+        double f = Math.max(0, Math.min(1, fraction));
+        int filled = (int) Math.round(width * f);
+        String full = INTERACTIVE ? "\u2588" : "#";
+        String empty = INTERACTIVE ? "\u2591" : "-";
+        String text = label.length() > 42 ? label.substring(0, 41) + "~" : label;
+        return "   " + c(CYAN) + full.repeat(filled) + c(DIM) + empty.repeat(width - filled) + c(RESET)
+                + c(BOLD) + String.format(" %3d%%", Math.round(f * 100)) + c(RESET) + "  " + text
+                + c(DIM) + String.format(Locale.GERMANY, "  %.1f s", uptimeSeconds()) + c(RESET);
+    }
+
+    /** Ausfuehrlicher Modus: jede Phase als Log-Zeile. */
+    private static void stepLine(double fraction, String label) {
+        String line = String.format(Locale.GERMANY, "[%3d%%] %s (%.1f s)", Math.round(fraction * 100), label, uptimeSeconds());
+        if (loggerMode) {
+            log().info(line);
+        } else {
+            OUT.println("   " + line);
+        }
+    }
+
+    /**
+     * Vom Konsolen-Thread fuer jede Log-Zeile aufgerufen, solange der Start laeuft.
+     * @return true, wenn die Zeile hier behandelt wurde (INFO verschluckt, WARN/FEHLER ueber dem Balken ausgegeben)
+     */
+    public static boolean handleStartupLine(String raw, boolean color) {
+        if (!isStartupActive()) {
+            return false;
+        }
+        String[] p = raw.split("\t", 4);
+        String level = p.length >= 2 ? p[1] : "INFO";
+        boolean warn = level.equals("WARN");
+        boolean error = level.equals("ERROR") || level.equals("FATAL");
+        if (!warn && !error) {
+            return true; // INFO/DEBUG beim Start nur ins Logfile
+        }
+        synchronized (LOCK) {
+            if (warn) {
+                warnings++;
+            } else {
+                errors++;
+            }
+            String line = formatLine(raw, color).stripTrailing();
+            if (INTERACTIVE) {
+                OUT.print(CLEAR_LINE + line + System.lineSeparator() + barLine);
+            } else {
+                OUT.println(line);
+            }
+            OUT.flush();
+        }
+        return true;
+    }
+
+    /** Vom Konsolen-Thread, sobald er laeuft. */
+    public static void consoleReady() {
+        loggerMode = true;
+    }
+
+    // ------------------------------------------------------------------ Live-Balken im laufenden Betrieb (Statuszeile unten)
+
+    private static volatile org.jline.terminal.Terminal terminal;
+    private static org.jline.utils.Status status;
+    private static final java.util.Map<String, String> LIVE = new java.util.LinkedHashMap<>();
+
+    /** Lock, den auch der Konsolen-Thread beim Schreiben nutzt (damit sich Log und Statuszeile nicht zerschneiden). */
+    public static Object outputLock() {
+        return LOCK;
+    }
+
+    /** Vom Konsolen-Thread: echtes Terminal fuer die Statuszeile merken. */
+    public static void attachTerminal(org.jline.terminal.Terminal t) {
+        if (COLOR && t != null && !t.getType().startsWith(org.jline.terminal.Terminal.TYPE_DUMB)) {
+            terminal = t;
+        }
+    }
+
+    /** @return true, wenn Live-Balken angezeigt werden koennen (echtes Terminal, Start abgeschlossen) */
+    public static boolean liveSupported() {
+        return terminal != null && !startupActive;
+    }
+
+    /**
+     * Zeigt oder aktualisiert einen Live-Balken unten in der Konsole.
+     *
+     * @param id eindeutige Kennung (z.B. "world:test")
+     * @param fraction Fortschritt 0..1
+     * @param label Beschriftung
+     * @param seconds bisherige Dauer
+     */
+    public static void live(String id, double fraction, String label, double seconds) {
+        if (!liveSupported()) {
+            return;
+        }
+        int width = 24;
+        double f = Math.max(0, Math.min(1, fraction));
+        int filled = (int) Math.round(width * f);
+        String line = " " + CYAN + "\u2588".repeat(filled) + DIM + "\u2591".repeat(width - filled) + RESET
+                + BOLD + String.format(" %3d%%", Math.round(f * 100)) + RESET + "  " + label
+                + DIM + String.format(Locale.GERMANY, "  %.1f s", seconds) + RESET;
+        synchronized (LOCK) {
+            LIVE.put(id, line);
+            redrawLive();
+        }
+    }
+
+    /** Entfernt einen Live-Balken. */
+    public static void liveDone(String id) {
+        synchronized (LOCK) {
+            if (LIVE.remove(id) != null) {
+                redrawLive();
+            }
+        }
+    }
+
+    private static void redrawLive() {
+        org.jline.terminal.Terminal t = terminal;
+        if (t == null) {
+            return;
+        }
+        try {
+            if (status == null) {
+                status = org.jline.utils.Status.getStatus(t);
+                if (status == null) {
+                    terminal = null;
+                    return;
+                }
+            }
+            List<org.jline.utils.AttributedString> lines = new ArrayList<>();
+            for (String l : LIVE.values()) {
+                lines.add(org.jline.utils.AttributedString.fromAnsi(l));
+            }
+            status.update(lines);
+        } catch (Throwable e) {
+            terminal = null; // Terminal kann keine Statuszeile: dann eben ohne Live-Balken
+        }
+    }
+
+    /**
+     * Routine-Meldungen, die nur ins Logfile gehoeren (die Konsole bleibt ruhig).
+     *
+     * @param msg Nachricht einer INFO-Zeile
+     * @return true, wenn die Zeile nicht in der Konsole erscheinen soll
+     */
+    public static boolean isNoise(String msg) {
+        if (VERBOSE) {
+            return false;
+        }
+        return msg.startsWith("Saving chunks for level ") || msg.contains("All chunks are saved")
+                || msg.startsWith("ThreadedAnvilChunkStorage") || msg.startsWith("Preparing start region")
+                || msg.startsWith("Selecting global world spawn");
+    }
+
+    /** Die Konsolen-Eingabe wartet, bis der Start fertig ist (sonst zerreisst der Prompt den Ladebalken). */
+    public static void awaitStartup() {
+        if (VERBOSE) {
+            return;
+        }
+        try {
+            STARTUP_DONE.await();
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+    }
+
+    /** Falls der Start abbricht oder der Server stoppt: Konsole wieder normal benutzen. */
+    public static void abortStartup() {
+        if (startupActive) {
+            synchronized (LOCK) {
+                if (INTERACTIVE && !VERBOSE) {
+                    OUT.println();
+                }
+                startupActive = false;
+            }
+            STARTUP_DONE.countDown();
+        }
+    }
+
+    // ------------------------------------------------------------------ Zusammenfassung
+
+    /** Nach "Done": Balken auf 100 %, dann Zusammenfassung, was geladen wurde. */
+    public static void ready(int port) {
+        progress(1.0, t("progress.ready"));
+        double secs = uptimeSeconds();
+        Runtime rt = Runtime.getRuntime();
+
+        List<String> lines = new ArrayList<>();
+        lines.add(t("summary.title", Tachyon.NAME.toUpperCase(Locale.ROOT), Tachyon.MC_VERSION, secs));
+        lines.add("");
+        lines.add(label("summary.port") + port + SEP + t("summary.slots", Bukkit.getMaxPlayers()) + SEP + t(Bukkit.getOnlineMode() ? "summary.online" : "summary.offline")
+                + SEP + t(Bukkit.hasWhitelist() ? "summary.whitelist.on" : "summary.whitelist.off"));
+        StringJoiner worlds = new StringJoiner(", ");
+        for (World w : Bukkit.getWorlds()) {
+            worlds.add(w.getName());
+        }
+        lines.add(label("summary.worlds") + worlds);
+        Plugin[] plugins = Bukkit.getPluginManager().getPlugins();
+        if (plugins.length == 0) {
+            lines.add(label("summary.plugins") + t("summary.plugins.none"));
+        } else {
+            StringJoiner pl = new StringJoiner(", ");
+            int disabled = 0;
+            for (Plugin plugin : plugins) {
+                if (plugin.isEnabled()) {
+                    pl.add(plugin.getName() + " " + plugin.getDescription().getVersion());
+                } else {
+                    disabled++;
+                }
+            }
+            lines.add(label("summary.plugins") + t("summary.plugins.active", plugins.length - disabled) + (disabled > 0 ? t("summary.plugins.failed", disabled) : ""));
+            for (String chunk : wrap(pl.toString(), 70)) {
+                lines.add("            " + chunk);
+            }
+        }
+        lines.add(label("summary.system") + "Java " + Runtime.version().feature() + SEP + rt.availableProcessors() + " " + t("console.threads") + SEP
+                + t("summary.ram", formatMb(rt.totalMemory() - rt.freeMemory()), formatMb(rt.maxMemory())));
+        String problems = (warnings == 0 && errors == 0) ? t("summary.start.ok") : t("summary.start.problems", warnings, errors);
+        lines.add(label("summary.start") + problems);
+        lines.add("");
+        lines.add(label("summary.commands") + t("summary.commands.list").replace("  \u00B7  ", SEP));
+
+        int w = 0;
+        for (String l : lines) {
+            w = Math.max(w, l.length());
+        }
+        String h = (INTERACTIVE ? "\u2500" : "-").repeat(w + 2);
+        String v = INTERACTIVE ? "\u2502" : "|";
+        String border = (errors > 0) ? RED : (warnings > 0 ? YELLOW : GREEN);
+        String nl = System.lineSeparator();
+        StringBuilder sb = new StringBuilder();
+        sb.append(nl).append(nl);
+        sb.append("   ").append(c(border)).append(INTERACTIVE ? "\u250C" : "+").append(h).append(INTERACTIVE ? "\u2510" : "+").append(c(RESET)).append(nl);
+        for (int i = 0; i < lines.size(); i++) {
+            String l = lines.get(i);
+            String body = (i == 0) ? c(BOLD) + c(border) + l + c(RESET) : colorLabel(l);
+            sb.append("   ").append(c(border)).append(v).append(c(RESET)).append(' ').append(body).append(" ".repeat(w - l.length()))
+                    .append(' ').append(c(border)).append(v).append(c(RESET)).append(nl);
+        }
+        sb.append("   ").append(c(border)).append(INTERACTIVE ? "\u2514" : "+").append(h).append(INTERACTIVE ? "\u2518" : "+").append(c(RESET)).append(nl);
+
+        synchronized (LOCK) {
+            if (VERBOSE) {
+                for (String l : lines) {
+                    log().info(l);
+                }
+            } else {
+                OUT.print(sb);
+                OUT.flush();
+            }
+            startupActive = false;
+        }
+        STARTUP_DONE.countDown();
+    }
+
+    private static String colorLabel(String l) {
+        if (!COLOR || l.length() < 12 || l.isBlank()) {
+            return l;
+        }
+        String label = l.substring(0, 12);
+        String rest = l.substring(12);
+        if (rest.contains("FEHLGESCHLAGEN") || rest.contains("FAILED") || rest.contains("logs/latest.log")) {
+            rest = YELLOW + rest + RESET;
+        }
+        return DIM + label + RESET + rest;
+    }
+
+    /** Beschriftung links in der Zusammenfassung, auf 12 Zeichen aufgefuellt. */
+    private static String label(String key) {
+        String l = t(key);
+        return l + " ".repeat(Math.max(1, 12 - l.length()));
+    }
+
+    private static List<String> wrap(String text, int width) {
+        List<String> out = new ArrayList<>();
+        StringBuilder line = new StringBuilder();
+        for (String word : text.split(" ")) {
+            if (line.length() + word.length() + 1 > width && line.length() > 0) {
+                out.add(line.toString());
+                line.setLength(0);
+            }
+            if (line.length() > 0) {
+                line.append(' ');
+            }
+            line.append(word);
+        }
+        if (line.length() > 0) {
+            out.add(line.toString());
+        }
+        return out;
+    }
+
+    private static String formatMb(long bytes) {
+        long mb = bytes / (1024 * 1024);
+        return mb >= 1024 ? String.format(Locale.GERMANY, "%.1f GB", mb / 1024.0) : mb + " MB";
+    }
+
+    // ------------------------------------------------------------------ Einfaerben der Log-Zeilen (nach dem Start)
+
+    /**
+     * Formatiert eine Log-Zeile fuer die Konsole. raw = "HH:mm:ss\tLEVEL\tThread\tNachricht".
+     * Nur String-Operationen auf der fertigen Zeile, im Konsolen-Thread - der Server-Thread merkt davon nichts.
+     */
+    public static String formatLine(String raw, boolean color) {
+        String[] p = raw.split("\t", 4);
+        if (p.length < 4) {
+            return raw;
+        }
+        String time = p[0];
+        String level = p[1];
+        String thread = p[2];
+        String msg = p[3];
+        if (!color) {
+            return "[" + time + "] [" + thread + "/" + level + "]: " + msg.replace('✔', '+'); // klassisches Format (Pipes, Panels)
+        }
+        StringBuilder sb = new StringBuilder(msg.length() + 48);
+        sb.append(DIM).append(time).append(RESET).append(' ');
+        switch (level) {
+            case "WARN" -> sb.append(YELLOW).append(BOLD).append("WARN ").append(RESET);
+            case "ERROR", "FATAL" -> sb.append(RED).append(BOLD).append("FEHL ").append(RESET);
+            case "DEBUG", "TRACE" -> sb.append(DIM).append("DEBUG").append(RESET);
+            default -> sb.append(DIM).append("\u2502    ").append(RESET);
+        }
+        sb.append(' ');
+        if (!"Server thread".equals(thread)) {
+            sb.append(DIM).append('[').append(thread).append("] ").append(RESET);
+        }
+        sb.append(colorMessage(level, msg)).append(RESET);
+        return sb.toString();
+    }
+
+    private static String colorMessage(String level, String msg) {
+        if (level.equals("WARN")) {
+            return YELLOW + msg;
+        }
+        if (level.equals("ERROR") || level.equals("FATAL")) {
+            return RED + msg;
+        }
+        if (msg.startsWith("Done (")) {
+            return GREEN + BOLD + msg;
+        }
+        if (msg.contains(" joined the game")) {
+            return GREEN + "\u25B6 " + msg;
+        }
+        if (msg.contains(" left the game")) {
+            return YELLOW + "\u25C0 " + msg;
+        }
+        if (msg.contains(" issued server command: ")) {
+            return MAGENTA + msg;
+        }
+        if (msg.startsWith("[WorldManager] ✔")) {
+            return GREEN + BOLD + "✔" + RESET + GREEN + msg.substring("[WorldManager] ✔".length());
+        }
+        if (msg.startsWith("[RAM]")) {
+            return MAGENTA + BOLD + "⇄ RAM" + RESET + MAGENTA + msg.substring("[RAM]".length());
+        }
+        if (msg.startsWith("[WorldManager]") || msg.startsWith("[Tachyon]")) {
+            int close = msg.indexOf(']');
+            return CYAN + BOLD + msg.substring(0, close + 1) + RESET + CYAN + msg.substring(close + 1);
+        }
+        if (msg.startsWith("<")) {
+            return BLUE + msg; // Chat
+        }
+        return msg;
+    }
+}
diff --git a/src/main/java/dev/tachyon/i18n/Lang.java b/src/main/java/dev/tachyon/i18n/Lang.java
new file mode 100644
index 000000000..03718385d
--- /dev/null
+++ b/src/main/java/dev/tachyon/i18n/Lang.java
@@ -0,0 +1,136 @@
+package dev.tachyon.i18n;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Properties;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Sprachen von Tachyon (Deutsch / Englisch).
+ * <p>
+ * Die Sprache steht in tachyon.yml ("language: de" oder "language: en"). Fehlt sie, fragt Tachyon
+ * beim ersten Start in der Konsole nach. Ueberschreiben: -Dtachyon.language=de|en.
+ */
+public final class Lang {
+
+    public static final Path CONFIG = Paths.get("tachyon.yml");
+    private static final Pattern LANGUAGE_LINE = Pattern.compile("(?m)^language:\\s*['\"]?(de|en)['\"]?\\s*$");
+
+    private static volatile String code;
+    private static Properties messages = new Properties();
+    private static Properties fallback = new Properties();
+
+    private Lang() {
+    }
+
+    /** Liest die Sprache (ohne nachzufragen). Wird bei Bedarf automatisch aufgerufen. */
+    private static synchronized void ensureLoaded() {
+        if (code == null) {
+            String configured = configuredLanguage();
+            load(configured != null ? configured : systemDefault());
+        }
+    }
+
+    /** @return true, wenn noch keine Sprache festgelegt wurde (erster Start) */
+    public static boolean needsChoice() {
+        return configuredLanguage() == null;
+    }
+
+    /** @return "de" oder "en" passend zur Systemsprache */
+    public static String systemDefault() {
+        return "de".equals(Locale.getDefault().getLanguage()) ? "de" : "en";
+    }
+
+    private static String configuredLanguage() {
+        String prop = System.getProperty("tachyon.language");
+        if (prop != null && (prop.equalsIgnoreCase("de") || prop.equalsIgnoreCase("en"))) {
+            return prop.toLowerCase(Locale.ROOT);
+        }
+        try {
+            if (Files.isRegularFile(CONFIG)) {
+                Matcher m = LANGUAGE_LINE.matcher(Files.readString(CONFIG, StandardCharsets.UTF_8));
+                if (m.find()) {
+                    return m.group(1);
+                }
+            }
+        } catch (IOException ignored) {
+            // dann eben Systemsprache
+        }
+        return null;
+    }
+
+    /** Setzt die Sprache und speichert sie in tachyon.yml. */
+    public static synchronized void choose(String language) {
+        load(language);
+        try {
+            List<String> lines = Files.isRegularFile(CONFIG) ? new ArrayList<>(Files.readAllLines(CONFIG, StandardCharsets.UTF_8)) : new ArrayList<>();
+            lines.removeIf(l -> l.startsWith("language:"));
+            int insert = 0;
+            while (insert < lines.size() && lines.get(insert).startsWith("#")) {
+                insert++; // nach dem Kopfkommentar einfuegen
+            }
+            lines.add(insert, "language: " + language);
+            Files.write(CONFIG, lines, StandardCharsets.UTF_8);
+        } catch (IOException ignored) {
+            // nicht schlimm: dann wird beim naechsten Start erneut gefragt
+        }
+    }
+
+    private static void load(String language) {
+        code = "de".equals(language) ? "de" : "en";
+        messages = read(code);
+        fallback = "en".equals(code) ? messages : read("en");
+    }
+
+    private static Properties read(String language) {
+        Properties p = new Properties();
+        try (InputStream in = Lang.class.getResourceAsStream("/tachyon/lang/" + language + ".properties")) {
+            if (in != null) {
+                p.load(new InputStreamReader(in, StandardCharsets.UTF_8));
+            }
+        } catch (IOException ignored) {
+            // leere Texte -> Schluessel wird angezeigt
+        }
+        return p;
+    }
+
+    /** @return aktuelle Sprache ("de" oder "en") */
+    public static String code() {
+        ensureLoaded();
+        return code;
+    }
+
+    /** @return true bei Deutsch */
+    public static boolean german() {
+        return "de".equals(code());
+    }
+
+    /**
+     * Uebersetzter Text. Platzhalter wie in String.format (%s, %d ...).
+     *
+     * @param key Schluessel aus tachyon/lang/*.properties
+     * @param args Werte fuer die Platzhalter
+     * @return Text in der eingestellten Sprache
+     */
+    public static String t(String key, Object... args) {
+        ensureLoaded();
+        String text = messages.getProperty(key, fallback.getProperty(key, key));
+        if (args.length == 0) {
+            return text;
+        }
+        try {
+            return String.format(german() ? Locale.GERMANY : Locale.ROOT, text, args);
+        } catch (RuntimeException e) {
+            return text;
+        }
+    }
+}
diff --git a/src/main/java/dev/tachyon/perf/AotTrainer.java b/src/main/java/dev/tachyon/perf/AotTrainer.java
new file mode 100644
index 000000000..08f4e6e45
--- /dev/null
+++ b/src/main/java/dev/tachyon/perf/AotTrainer.java
@@ -0,0 +1,258 @@
+package dev.tachyon.perf;
+
+import static dev.tachyon.i18n.Lang.t;
+
+import java.io.File;
+import java.io.IOException;
+import java.lang.management.ManagementFactory;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+import java.util.stream.Stream;
+
+/**
+ * Erstellt Javas Start-Cache (AOT) im Hintergrund, ohne den Start zu bremsen.
+ *
+ * Frueher lief vor dem ersten Start nach einem Update ein ~40 s langes Training. Jetzt startet der Server sofort
+ * ohne Cache (~7 s) und Tachyon startet danach mit niedriger Prioritaet eine zweite, unsichtbare Java-Instanz:
+ * gleiche Jar, gleiche JVM-Einstellungen, aber eigener Ordner (tachyon-libs/aot-training) mit Mini-Welt und
+ * Port 0 - sie beruehrt weder Welten noch Konfiguration oder Logs des echten Servers. Sie faehrt kurz hoch,
+ * beendet sich, und Java schreibt dabei den Cache. Ab dem naechsten Start ist Tachyon in ~3 s bereit.
+ *
+ * Das Startskript fordert das an (-Dtachyon.aotTrain=true) und legt in tachyon-libs/aot.wanted die Signatur
+ * (Jar + JVM-Flags) ab. Nur wenn der Cache wirklich fertig ist, wird sie nach tachyon.aot.sig kopiert.
+ */
+public final class AotTrainer {
+
+    private static final Logger LOG = Logger.getLogger("Tachyon");
+    private static final boolean REQUESTED = Boolean.getBoolean("tachyon.aotTrain");
+    private static final String LAUNCH_ARGS = System.getProperty("bundlerRepoDir", "tachyon-libs") + "/tachyon-launch.args";
+    private static boolean started;
+
+    private AotTrainer() {
+    }
+
+    /** Nach "bereit" vom Server aufgerufen. */
+    public static synchronized void startIfRequested() {
+        if (!REQUESTED || started) {
+            return;
+        }
+        started = true;
+        Thread thread = new Thread(AotTrainer::run, "Tachyon-AOT");
+        thread.setDaemon(true);
+        thread.setPriority(Thread.MIN_PRIORITY);
+        thread.start();
+    }
+
+    private static void run() {
+        try {
+            Path server = Paths.get("").toAbsolutePath();
+            Path libs = server.resolve(System.getProperty("bundlerRepoDir", "tachyon-libs"));
+            Path wanted = libs.resolve("aot.wanted");
+            if (!Files.isRegularFile(wanted) || !Files.isRegularFile(libs.resolve("tachyon-launch.args"))) {
+                return;
+            }
+            Path dir = libs.resolve("aot-training");
+            Files.createDirectories(dir);
+            Path lock = dir.resolve("running.lock");
+            if (otherTrainingRunning(lock)) {
+                LOG.info("[Tachyon] " + t("aot.bg.already"));
+                return;
+            }
+            prepareDirectory(server, libs, dir);
+            boolean windows = System.getProperty("os.name", "").toLowerCase(Locale.ROOT).contains("win");
+            Path out = server.resolve("tachyon.aot.new");
+            Files.deleteIfExists(out);
+            writeArgs(dir, out);
+            Path script = windows ? writeCmd(dir, server, out) : writeSh(dir, server, out);
+
+            ProcessBuilder pb = windows ? new ProcessBuilder("cmd", "/c", script.toString()) : new ProcessBuilder("sh", script.toString());
+            pb.directory(dir.toFile());
+            pb.redirectInput(ProcessBuilder.Redirect.from(new File(windows ? "NUL" : "/dev/null")));
+            pb.redirectOutput(ProcessBuilder.Redirect.DISCARD);
+            pb.redirectErrorStream(true);
+            long t0 = System.nanoTime();
+            Process process = pb.start();
+            Files.writeString(lock, Long.toString(process.pid()), StandardCharsets.UTF_8);
+            LOG.info("[Tachyon] " + t("aot.bg.start"));
+
+            int rc = process.waitFor();
+            double secs = (System.nanoTime() - t0) / 1e9;
+            Path aot = server.resolve("tachyon.aot");
+            if (rc == 0 && Files.isRegularFile(aot) && Files.isRegularFile(server.resolve("tachyon.aot.sig"))) {
+                LOG.info("[Tachyon] ✔ " + t("aot.bg.done", secs, Files.size(aot) / (1024 * 1024)));
+            } else {
+                LOG.warning("[Tachyon] " + t("aot.bg.failed", dir.resolve("train.log")));
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        } catch (Throwable e) {
+            LOG.log(Level.WARNING, "[Tachyon] " + t("aot.bg.failed", e.getMessage()), e);
+        }
+    }
+
+    private static boolean otherTrainingRunning(Path lock) {
+        try {
+            if (!Files.isRegularFile(lock)) {
+                return false;
+            }
+            long pid = Long.parseLong(Files.readString(lock, StandardCharsets.UTF_8).trim());
+            return ProcessHandle.of(pid).map(ProcessHandle::isAlive).orElse(false);
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    /**
+     * Trainingsordner: eigene Mini-Welt, Port 0, Schlafmodus aus. Der Classpath in tachyon-launch.args ist relativ
+     * ("tachyon-libs/..."), darum zeigt aot-training/tachyon-libs als Verknuepfung auf den echten Ordner - so
+     * stimmen die Pfade im Cache exakt mit denen des echten Servers ueberein.
+     */
+    private static void prepareDirectory(Path server, Path libs, Path dir) throws IOException, InterruptedException {
+        // Alte Trainingswelt/Logs loeschen (ohne der Verknuepfung zu folgen!)
+        try (Stream<Path> entries = Files.list(dir)) {
+            for (Path p : (Iterable<Path>) entries::iterator) {
+                String name = p.getFileName().toString();
+                if (name.startsWith("world") || name.equals("logs")) {
+                    deleteTree(p);
+                }
+            }
+        }
+        Path link = dir.resolve(libs.getFileName().toString());
+        if (!Files.exists(link)) {
+            if (System.getProperty("os.name", "").toLowerCase(Locale.ROOT).contains("win")) {
+                Process p = new ProcessBuilder("cmd", "/c", "mklink", "/J", link.toString(), libs.toString())
+                        .redirectErrorStream(true).redirectOutput(ProcessBuilder.Redirect.DISCARD).start();
+                p.waitFor();
+            } else {
+                Files.createSymbolicLink(link, libs);
+            }
+        }
+        if (!Files.exists(link.resolve("tachyon-launch.args"))) {
+            throw new IOException("link " + link + " failed");
+        }
+        Path eula = server.resolve("eula.txt");
+        if (Files.isRegularFile(eula)) {
+            Files.copy(eula, dir.resolve("eula.txt"), java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+        }
+        Files.writeString(dir.resolve("server.properties"), String.join("\n",
+                "server-port=0", "online-mode=false", "enable-query=false", "enable-rcon=false", "management-server-enabled=false",
+                "spawn-protection=0", "view-distance=6", "simulation-distance=4", "sync-chunk-writes=false", "") , StandardCharsets.UTF_8);
+        Files.writeString(dir.resolve("tachyon.yml"), String.join("\n",
+                "language: " + dev.tachyon.i18n.Lang.code(), "sleep-mode:", "  enabled: false", "performance:", "  release-ram-when-empty: false", ""),
+                StandardCharsets.UTF_8);
+        Files.writeString(dir.resolve("README.txt"),
+                "Tachyon: Ordner fuer das Erstellen des Start-Caches (AOT). Wird automatisch verwaltet - kann geloescht werden.\n"
+                        + "Tachyon: folder used to build the startup cache (AOT). Managed automatically - safe to delete.\n", StandardCharsets.UTF_8);
+    }
+
+    /** JVM-Argumente des laufenden Servers uebernehmen (der Cache passt nur zu denselben Einstellungen) + Aufzeichnung. */
+    private static void writeArgs(Path dir, Path out) throws IOException {
+        List<String> args = new ArrayList<>();
+        for (String a : ManagementFactory.getRuntimeMXBean().getInputArguments()) {
+            if (a.startsWith("-Xms") || a.startsWith("-Dtachyon.") || a.startsWith("-XX:AOTCache") || a.startsWith("-XX:AOTMode")
+                    || a.startsWith("-Djava.class.path") || a.startsWith("-DbundlerMainClass")) {
+                continue;
+            }
+            args.add(a);
+        }
+        args.add("-Xms64m");
+        args.add("-Xlog:aot*=warning");
+        args.add("-XX:+UnlockDiagnosticVMOptions");
+        args.add("-XX:+AOTStreamableObjects");
+        args.add("-XX:AOTCacheOutput=" + out);
+        args.add("-Dtachyon.aotTraining=true");
+        args.add("-Dtachyon.verboseStartup=true");
+        StringBuilder sb = new StringBuilder();
+        for (String a : args) {
+            sb.append(a.indexOf(' ') >= 0 || a.indexOf('\\') >= 0 ? "\"" + a.replace("\\", "/") + "\"" : a).append('\n');
+        }
+        Files.writeString(dir.resolve("train.args"), sb.toString(), StandardCharsets.UTF_8);
+    }
+
+    private static String java() {
+        return ProcessHandle.current().info().command().orElse(Paths.get(System.getProperty("java.home"), "bin", "java").toString());
+    }
+
+    private static Path writeCmd(Path dir, Path server, Path out) throws IOException {
+        String java = java();
+        String run = "start \"\" /low /b /wait \"" + java + "\" %EXTRA% @train.args @" + LAUNCH_ARGS + " nogui --nojline --noconsole < nul >> train.log 2>&1";
+        // nur gueltig, wenn der Trainings-Server wirklich hochgefahren ist ("Done (") und Java einen Cache geschrieben hat
+        String check = "findstr /c:\"Done (\" train.log >nul && if exist \"" + out + "\" for %%F in (\"" + out + "\") do if %%~zF GTR 0 goto ok";
+        String s = String.join("\r\n",
+                "@echo off",
+                "cd /d \"%~dp0\"",
+                "echo Tachyon AOT %date% %time%> train.log",
+                "set EXTRA=",
+                run,
+                check,
+                "del /q \"" + out + "\" 2>nul",
+                "echo --- retry without AOTClassLinking>> train.log",
+                "set EXTRA=-XX:-AOTClassLinking",
+                run,
+                check,
+                "echo FAILED>> train.log",
+                "del /q running.lock 2>nul",
+                "exit /b 1",
+                ":ok",
+                "move /y \"" + out + "\" \"" + server.resolve("tachyon.aot") + "\" >nul",
+                "copy /y \"" + server.resolve("tachyon-libs").resolve("aot.wanted") + "\" \"" + server.resolve("tachyon.aot.sig") + "\" >nul",
+                "echo OK>> train.log",
+                "del /q running.lock 2>nul",
+                "exit /b 0", "");
+        Path f = dir.resolve("train.cmd");
+        Files.writeString(f, s, StandardCharsets.UTF_8);
+        return f;
+    }
+
+    private static Path writeSh(Path dir, Path server, Path out) throws IOException {
+        String java = java();
+        String s = String.join("\n",
+                "#!/bin/sh",
+                "cd \"$(dirname \"$0\")\"",
+                "echo \"Tachyon AOT $(date)\" > train.log",
+                "N=''; command -v nice >/dev/null && N='nice -n 10'",
+                "$N \"" + java + "\" @train.args @" + LAUNCH_ARGS + " nogui --nojline --noconsole </dev/null >> train.log 2>&1",
+                "if [ ! -s '" + out + "' ] || ! grep -q 'Done (' train.log; then",
+                "  rm -f '" + out + "'",
+                "  echo '--- retry without AOTClassLinking' >> train.log",
+                "  $N \"" + java + "\" -XX:-AOTClassLinking @train.args @" + LAUNCH_ARGS + " nogui --nojline --noconsole </dev/null >> train.log 2>&1",
+                "fi",
+                "if [ -s '" + out + "' ] && grep -q 'Done (' train.log; then",
+                "  mv -f '" + out + "' '" + server.resolve("tachyon.aot") + "'",
+                "  cp -f '" + server.resolve("tachyon-libs").resolve("aot.wanted") + "' '" + server.resolve("tachyon.aot.sig") + "'",
+                "  echo OK >> train.log; rm -f running.lock; exit 0",
+                "fi",
+                "echo FAILED >> train.log; rm -f running.lock; exit 1", "");
+        Path f = dir.resolve("train.sh");
+        Files.writeString(f, s, StandardCharsets.UTF_8);
+        return f;
+    }
+
+    /** Loescht einen Ordner, folgt dabei aber keinen Verknuepfungen. */
+    private static void deleteTree(Path p) throws IOException {
+        if (Files.isDirectory(p, LinkOption.NOFOLLOW_LINKS) && !Files.isSymbolicLink(p) && !isJunction(p)) {
+            try (Stream<Path> s = Files.list(p)) {
+                for (Path c : (Iterable<Path>) s::iterator) {
+                    deleteTree(c);
+                }
+            }
+        }
+        Files.deleteIfExists(p);
+    }
+
+    private static boolean isJunction(Path p) {
+        try {
+            return !p.toRealPath().equals(p.toAbsolutePath().normalize());
+        } catch (IOException e) {
+            return true;
+        }
+    }
+}
diff --git a/src/main/java/dev/tachyon/perf/DynamicPerformance.java b/src/main/java/dev/tachyon/perf/DynamicPerformance.java
new file mode 100644
index 000000000..48eadfe7f
--- /dev/null
+++ b/src/main/java/dev/tachyon/perf/DynamicPerformance.java
@@ -0,0 +1,117 @@
+package dev.tachyon.perf;
+
+import static dev.tachyon.i18n.Lang.t;
+
+import java.util.logging.Logger;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+
+/**
+ * Dynamische Lastregelung von Tachyon.
+ *
+ * Steigt die Tick-Zeit Richtung 50 ms (= Lag), verkleinert Tachyon schrittweise die Simulationsdistanz
+ * (Bereich um Spieler, in dem Mobs, Redstone, Pflanzen usw. berechnet werden). Die Sichtweite bleibt gleich.
+ * Ist wieder Luft, geht es schrittweise zurueck auf den eingestellten Wert.
+ */
+public final class DynamicPerformance {
+
+    private static final Logger LOG = Logger.getLogger("Tachyon");
+    private static final int CHECK_TICKS = 100;          // alle 5 s pruefen
+    private static final long RAISE_COOLDOWN_MS = 30_000; // nach einer Aenderung 30 s warten, bevor es wieder hoch geht
+
+    private static boolean enabled = true;
+    private static int minDistance = 4;
+    private static double msptHigh = 40;
+    private static double msptLow = 25;
+
+    private static int reduction;
+    private static long lastChange;
+    private static int ticks;
+    private static double lastMspt;
+
+    private DynamicPerformance() {
+    }
+
+    public static void configure(boolean on, int min, double high, double low) {
+        enabled = on;
+        minDistance = Math.max(2, min);
+        msptHigh = high;
+        msptLow = Math.min(low, high - 1);
+        if (!enabled && reduction > 0) {
+            reduction = 0;
+            apply();
+        }
+    }
+
+    /** Jeden Tick vom World-Manager aufgerufen. */
+    public static void tick() {
+        if (!enabled || ++ticks % CHECK_TICKS != 0) {
+            return;
+        }
+        MinecraftServer server = MinecraftServer.getServer();
+        double mspt = server.getAverageTickTimeNanos() / 1_000_000.0;
+        lastMspt = mspt;
+        long now = System.currentTimeMillis();
+        int maxReduction = maxReduction(server);
+        if (mspt > msptHigh && reduction < maxReduction) {
+            int before = reduction;
+            reduction++;
+            lastChange = now;
+            apply();
+            LOG.info("[Tachyon] " + t("perf.sim.down", mspt, configured(server) - before, configured(server) - reduction));
+        } else if (mspt < msptLow && reduction > 0 && now - lastChange > RAISE_COOLDOWN_MS) {
+            int before = reduction;
+            reduction--;
+            lastChange = now;
+            apply();
+            LOG.info("[Tachyon] " + t("perf.sim.up", mspt, configured(server) - before, configured(server) - reduction));
+        } else if (reduction > 0 && ticks % 1200 == 0) {
+            apply(); // neu geladene Welten nachziehen
+        }
+    }
+
+    /** Groesste konfigurierte Simulationsdistanz aller Welten (fuer Meldungen). */
+    private static int configured(MinecraftServer server) {
+        int max = 0;
+        for (ServerLevel level : server.getAllLevels()) {
+            max = Math.max(max, level.spigotConfig.simulationDistance);
+        }
+        return max;
+    }
+
+    private static int maxReduction(MinecraftServer server) {
+        return Math.max(0, configured(server) - minDistance);
+    }
+
+    private static void apply() {
+        for (ServerLevel level : MinecraftServer.getServer().getAllLevels()) {
+            int cfg = level.spigotConfig.simulationDistance;
+            level.getChunkSource().setSimulationDistance(Math.max(Math.min(cfg, minDistance), cfg - reduction));
+        }
+    }
+
+    /** @return aktuelle Simulationsdistanz der ersten Welt (fuer /tps) */
+    public static int current() {
+        for (ServerLevel level : MinecraftServer.getServer().getAllLevels()) {
+            int cfg = level.spigotConfig.simulationDistance;
+            return Math.max(Math.min(cfg, minDistance), cfg - reduction);
+        }
+        return 0;
+    }
+
+    /** @return eingestellte Simulationsdistanz der ersten Welt (fuer /tps) */
+    public static int configuredFirst() {
+        for (ServerLevel level : MinecraftServer.getServer().getAllLevels()) {
+            return level.spigotConfig.simulationDistance;
+        }
+        return 0;
+    }
+
+    public static boolean isEnabled() {
+        return enabled;
+    }
+
+    public static double lastMspt() {
+        return lastMspt;
+    }
+}
diff --git a/src/main/java/dev/tachyon/perf/MemoryManager.java b/src/main/java/dev/tachyon/perf/MemoryManager.java
new file mode 100644
index 000000000..cd49ea9ce
--- /dev/null
+++ b/src/main/java/dev/tachyon/perf/MemoryManager.java
@@ -0,0 +1,274 @@
+package dev.tachyon.perf;
+
+import static dev.tachyon.i18n.Lang.t;
+
+import java.lang.management.ManagementFactory;
+import java.lang.management.MemoryMXBean;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.Base64;
+import java.util.Locale;
+import java.util.Properties;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+import javax.management.ObjectName;
+import net.minecraft.network.protocol.status.ServerStatus;
+import net.minecraft.server.MinecraftServer;
+
+/**
+ * RAM-Steuerung von Tachyon: gibt Speicher zurueck, wenn niemand online ist, und legt den Server
+ * auf Wunsch ganz schlafen.
+ *
+ * Stufe 1 - RAM zurueckgeben: Ist der Server eine Minute leer, raeumt Tachyon einmal gruendlich auf
+ * (volle Speicherbereinigung) und gibt den frei gewordenen Speicher ans Betriebssystem zurueck.
+ * Ohne Spieler stoert die kurze Pause niemanden.
+ *
+ * Stufe 2 - Schlafmodus: Ist der Server sleep-mode.after-minutes leer, speichert er alles und beendet Java.
+ * Das Startskript startet dann einen winzigen Waechter, der den Port belegt, in der Serverliste
+ * "schlaeft" anzeigt und Tachyon wieder startet, sobald jemand joinen will. Der RAM des Servers ist
+ * in dieser Zeit komplett frei, die Welten liegen nur noch auf der SSD/HDD.
+ */
+public final class MemoryManager {
+
+    /** Exit-Code fuer "schlafen gehen" - das Startskript startet daraufhin den Waechter. */
+    public static final int SLEEP_EXIT_CODE = 75;
+    /** Nur die Tachyon-Startskripte koennen den Server wieder aufwecken - ohne sie schlaeft er nie ein. */
+    private static final boolean LAUNCHER = Boolean.getBoolean("tachyon.sleepLauncher");
+    private static final boolean AOT_TRAINING = Boolean.getBoolean("tachyon.aotTraining");
+    /** Nur zum Testen: Sekunden statt Minuten bis zum Einschlafen. */
+    private static final long TEST_SLEEP_SECONDS = Long.getLong("tachyon.sleepAfterSeconds", 0L);
+    private static final long TRIM_AFTER_MS = Long.getLong("tachyon.trimAfterSeconds", 60L) * 1000L;
+    private static final Logger LOG = Logger.getLogger("Tachyon");
+
+    private static boolean trimEnabled = true;
+    private static boolean sleepEnabled = true;
+    private static int sleepAfterMinutes = 15;
+
+    private static int ticks;
+    private static long emptySince = -1;
+    private static boolean trimmed;
+    private static volatile boolean trimRunning;
+    private static boolean sleeping;
+    private static boolean infoShown;
+    private static int exitCode;
+
+    private MemoryManager() {
+    }
+
+    public static void configure(boolean trim, boolean sleep, int afterMinutes) {
+        trimEnabled = trim;
+        sleepEnabled = sleep;
+        sleepAfterMinutes = Math.max(1, afterMinutes);
+    }
+
+    /** Kurz vor System.exit: Hinweis, falls Java jetzt noch den Start-Cache schreibt (erster Start nach einem Update). */
+    public static void beforeExit() {
+        try {
+            for (String arg : ManagementFactory.getRuntimeMXBean().getInputArguments()) {
+                if (arg.startsWith("-XX:AOTCacheOutput")) {
+                    LOG.info("[Tachyon] " + t("aot.writing"));
+                    break;
+                }
+            }
+        } catch (Throwable ignored) {
+        }
+    }
+
+    /** Exit-Code fuer System.exit am Ende des Server-Stopps (0 = normal beendet). */
+    public static int exitCode() {
+        return exitCode;
+    }
+
+    /** true, wenn der Schlafmodus eingeschaltet ist und ein Tachyon-Startskript den Server wieder wecken kann. */
+    public static boolean sleepActive() {
+        return sleepEnabled && LAUNCHER && !AOT_TRAINING;
+    }
+
+    public static boolean isSleepEnabled() {
+        return sleepEnabled;
+    }
+
+    public static boolean isTrimEnabled() {
+        return trimEnabled;
+    }
+
+    public static int sleepAfterMinutes() {
+        return sleepAfterMinutes;
+    }
+
+    public static boolean hasLauncher() {
+        return LAUNCHER;
+    }
+
+    private static long sleepAfterMs() {
+        return TEST_SLEEP_SECONDS > 0 ? TEST_SLEEP_SECONDS * 1000L : sleepAfterMinutes * 60_000L;
+    }
+
+    /** @return Minuten bis zum Einschlafen (fuer /tps), -1 = es ist jemand online oder der Schlafmodus ist aus */
+    public static long minutesUntilSleep() {
+        if (!sleepActive() || emptySince < 0) {
+            return -1;
+        }
+        long left = sleepAfterMs() - (System.currentTimeMillis() - emptySince);
+        return Math.max(0, (left + 59_999) / 60_000);
+    }
+
+    /** Jeden Tick vom World-Manager aufgerufen - auch waehrend der Server pausiert (niemand online). */
+    public static void tick() {
+        if (sleeping || AOT_TRAINING || ++ticks % 20 != 0) {
+            return;
+        }
+        MinecraftServer server = MinecraftServer.getServer();
+        if (!infoShown) {
+            infoShown = true;
+            if (sleepEnabled && !LAUNCHER) {
+                LOG.info("[RAM] " + t("ram.sleep.no_launcher"));
+            }
+        }
+        if (server.getPlayerCount() > 0) {
+            emptySince = -1;
+            trimmed = false;
+            return;
+        }
+        long now = System.currentTimeMillis();
+        if (emptySince < 0) {
+            emptySince = now;
+        }
+        long idle = now - emptySince;
+        dev.tachyon.world.WorldManager wm = dev.tachyon.world.WorldManager.get();
+        if (wm != null && wm.isBusy()) {
+            emptySince = now; // Weltgenerierung / Pregen laeuft - nicht stoeren, Leerlauf beginnt erst danach
+            return;
+        }
+        if (trimEnabled && !trimmed && idle >= TRIM_AFTER_MS) {
+            trimmed = true;
+            trimAsync(idle / 60_000);
+        }
+        if (sleepActive() && idle >= sleepAfterMs()) {
+            goToSleep(server, idle);
+        }
+    }
+
+    // ------------------------------------------------------------------ Stufe 1: RAM zurueckgeben
+
+    /** Volle Speicherbereinigung im Hintergrund-Thread, danach Meldung, wie viel RAM ans System zurueckging. */
+    private static void trimAsync(long idleMinutes) {
+        if (trimRunning) {
+            return;
+        }
+        trimRunning = true;
+        Thread thread = new Thread(() -> {
+            try {
+                MemoryMXBean mem = ManagementFactory.getMemoryMXBean();
+                long before = mem.getHeapMemoryUsage().getCommitted();
+                long start = System.nanoTime();
+                if (!fullGc()) {
+                    return;
+                }
+                trimNativeHeap();
+                long after = mem.getHeapMemoryUsage().getCommitted();
+                long used = mem.getHeapMemoryUsage().getUsed();
+                long ms = (System.nanoTime() - start) / 1_000_000;
+                long freed = before - after;
+                if (freed >= 16L * 1024 * 1024) {
+                    LOG.info("[RAM] " + t("ram.trim.done", Math.max(1, idleMinutes), mb(before), mb(after), mb(freed), mb(used), ms));
+                } else {
+                    long floor = mem.getHeapMemoryUsage().getInit();
+                    LOG.info("[RAM] " + t("ram.trim.minimal", mb(after), mb(used), mb(floor)));
+                }
+            } catch (Throwable e) {
+                LOG.log(Level.FINE, "RAM trim failed", e);
+            } finally {
+                trimRunning = false;
+            }
+        }, "Tachyon-RAM");
+        thread.setDaemon(true);
+        thread.start();
+    }
+
+    /**
+     * Volle GC ueber das Diagnose-Kommando "GC.run". Anders als System.gc() greift das auch bei
+     * -XX:+DisableExplicitGC (das verhindert nur, dass Plugins staendig System.gc() aufrufen).
+     * G1 verkleinert danach den Heap (bis RAM_MIN) und gibt den Rest ans Betriebssystem zurueck.
+     */
+    private static boolean fullGc() {
+        try {
+            ManagementFactory.getPlatformMBeanServer().invoke(new ObjectName("com.sun.management:type=DiagnosticCommand"),
+                    "gcRun", new Object[] { null }, new String[] { String[].class.getName() });
+            return true;
+        } catch (Exception e) {
+            LOG.log(Level.FINE, "GC.run not available", e);
+            return false;
+        }
+    }
+
+    /** Linux: auch den nativen Speicher (glibc malloc) zurueckgeben. Auf anderen Systemen gibt es das Kommando nicht. */
+    private static void trimNativeHeap() {
+        if (!System.getProperty("os.name", "").toLowerCase(Locale.ROOT).contains("linux")) {
+            return;
+        }
+        try {
+            ManagementFactory.getPlatformMBeanServer().invoke(new ObjectName("com.sun.management:type=DiagnosticCommand"),
+                    "systemTrimNativeHeap", new Object[] { null }, new String[] { String[].class.getName() });
+        } catch (Exception ignored) {
+            // aeltere JVM oder musl - egal
+        }
+    }
+
+    // ------------------------------------------------------------------ Stufe 2: Schlafmodus
+
+    private static void goToSleep(MinecraftServer server, long idleMs) {
+        sleeping = true;
+        exitCode = SLEEP_EXIT_CODE;
+        Runtime rt = Runtime.getRuntime();
+        long ram = rt.totalMemory() + nonHeapCommitted();
+        writeSleepInfo(server, ram);
+        long minutes = Math.max(1, idleMs / 60_000);
+        LOG.info("[RAM] 💤 " + t("ram.sleep.now", minutes, mb(ram)));
+        org.bukkit.Bukkit.shutdown();
+    }
+
+    private static long nonHeapCommitted() {
+        try {
+            return ManagementFactory.getMemoryMXBean().getNonHeapMemoryUsage().getCommitted();
+        } catch (Throwable e) {
+            return 0;
+        }
+    }
+
+    /** Alles, was der Waechter fuer die Serverliste braucht (er laeuft ohne die Server-Klassen). */
+    private static void writeSleepInfo(MinecraftServer server, long ram) {
+        try {
+            Properties p = new Properties();
+            ServerStatus.Version version = ServerStatus.Version.current();
+            p.setProperty("protocol", Integer.toString(version.protocol()));
+            p.setProperty("version", dev.tachyon.Tachyon.NAME + " " + dev.tachyon.Tachyon.MC_VERSION);
+            String motd = server.getMotd();
+            p.setProperty("motd", motd == null ? "" : motd.split("\n", 2)[0]);
+            p.setProperty("max-players", Integer.toString(server.getMaxPlayers()));
+            p.setProperty("port", Integer.toString(server.getPort()));
+            String ip = server.getLocalIp();
+            p.setProperty("ip", ip == null ? "" : ip);
+            p.setProperty("ram", Long.toString(ram));
+            p.setProperty("language", dev.tachyon.i18n.Lang.code());
+            ServerStatus status = server.getStatus();
+            if (status != null && status.favicon().isPresent()) {
+                p.setProperty("favicon", Base64.getEncoder().encodeToString(status.favicon().get().iconBytes()));
+            }
+            Path dir = Paths.get(System.getProperty("bundlerRepoDir", "tachyon-libs"));
+            Files.createDirectories(dir);
+            try (var out = Files.newBufferedWriter(dir.resolve("sleep.properties"), StandardCharsets.UTF_8)) {
+                p.store(out, "Tachyon sleep mode - written when the server goes to sleep");
+            }
+        } catch (Exception e) {
+            LOG.log(Level.WARNING, "[RAM] sleep.properties: " + e.getMessage(), e);
+        }
+    }
+
+    private static String mb(long bytes) {
+        double mb = bytes / (1024.0 * 1024.0);
+        return mb >= 1024 ? String.format(Locale.ROOT, "%.1f GB", mb / 1024.0) : String.format(Locale.ROOT, "%.0f MB", mb);
+    }
+}
diff --git a/src/main/java/dev/tachyon/text/Style.java b/src/main/java/dev/tachyon/text/Style.java
new file mode 100644
index 000000000..13aafc5eb
--- /dev/null
+++ b/src/main/java/dev/tachyon/text/Style.java
@@ -0,0 +1,100 @@
+package dev.tachyon.text;
+
+import net.md_5.bungee.api.ChatColor;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+
+/**
+ * Einheitlicher Chat-Look von Tachyon: Farbverlauf-Praefix, Hex-Farben, Trennlinien und Balken.
+ * Spieler bekommen Hex-Farben, die Konsole die naechstliegenden Standardfarben.
+ */
+public final class Style {
+
+    public static final String C_ACCENT = "#7ee0c3";
+    public static final String C_ACCENT2 = "#c9a7ff";
+    public static final String C_TEXT = "#e8e9f3";
+    public static final String C_MUTED = "#8a8fa3";
+    public static final String C_GOOD = "#7ee08a";
+    public static final String C_WARN = "#ffd479";
+    public static final String C_BAD = "#ff6b8b";
+
+    private Style() {
+    }
+
+    /** Farbe fuer einen Empfaenger: Hex fuer Spieler, Standardfarbe fuer die Konsole. */
+    public static String col(CommandSender to, String hex) {
+        if (to instanceof Player) {
+            return ChatColor.of(hex).toString();
+        }
+        return switch (hex) {
+            case C_ACCENT -> ChatColor.AQUA.toString();
+            case C_ACCENT2 -> ChatColor.LIGHT_PURPLE.toString();
+            case C_TEXT -> ChatColor.WHITE.toString();
+            case C_MUTED -> ChatColor.GRAY.toString();
+            case C_GOOD -> ChatColor.GREEN.toString();
+            case C_WARN -> ChatColor.YELLOW.toString();
+            case C_BAD -> ChatColor.RED.toString();
+            default -> ChatColor.WHITE.toString();
+        };
+    }
+
+    /** Text mit Farbverlauf (nur fuer Spieler, Konsole bekommt eine Farbe). */
+    public static String gradient(CommandSender to, String text, String fromHex, String toHex) {
+        if (!(to instanceof Player)) {
+            return col(to, fromHex) + ChatColor.BOLD + text + ChatColor.RESET;
+        }
+        java.awt.Color a = java.awt.Color.decode(fromHex);
+        java.awt.Color b = java.awt.Color.decode(toHex);
+        StringBuilder sb = new StringBuilder();
+        int n = Math.max(1, text.length() - 1);
+        for (int i = 0; i < text.length(); i++) {
+            float f = i / (float) n;
+            int r = Math.round(a.getRed() + (b.getRed() - a.getRed()) * f);
+            int g = Math.round(a.getGreen() + (b.getGreen() - a.getGreen()) * f);
+            int bl = Math.round(a.getBlue() + (b.getBlue() - a.getBlue()) * f);
+            sb.append(ChatColor.of(new java.awt.Color(r, g, bl))).append(ChatColor.BOLD).append(text.charAt(i));
+        }
+        return sb.append(ChatColor.RESET).toString();
+    }
+
+    /** "Tachyon » " in Farbverlauf. */
+    public static String prefix(CommandSender to) {
+        return gradient(to, "Tachyon", C_ACCENT, C_ACCENT2) + col(to, C_MUTED) + " » " + col(to, C_TEXT);
+    }
+
+    /** Durchgestrichene Trennlinie. */
+    public static String line(CommandSender to) {
+        return col(to, C_MUTED) + ChatColor.STRIKETHROUGH + " ".repeat(to instanceof Player ? 52 : 40) + ChatColor.RESET;
+    }
+
+    /** Balken aus Kaestchen, z.B. fuer TPS oder RAM. */
+    public static String bar(CommandSender to, double fraction, int width, String fillHex) {
+        double f = Math.max(0, Math.min(1, fraction));
+        int filled = (int) Math.round(f * width);
+        String full = to instanceof Player ? "■" : "#";
+        String empty = to instanceof Player ? "■" : "-";
+        return col(to, fillHex) + full.repeat(filled) + ChatColor.DARK_GRAY + empty.repeat(width - filled) + ChatColor.RESET;
+    }
+
+    /** Gruen / Gelb / Rot fuer TPS. */
+    public static String tpsColor(double tps) {
+        return tps >= 19.5 ? C_GOOD : tps >= 17 ? C_WARN : C_BAD;
+    }
+
+    /** Gruen / Gelb / Rot fuer Millisekunden pro Tick (50 ms = Limit). */
+    public static String msptColor(double mspt) {
+        return mspt < 30 ? C_GOOD : mspt < 45 ? C_WARN : C_BAD;
+    }
+
+    public static void ok(CommandSender to, String msg) {
+        to.sendMessage(prefix(to) + col(to, C_GOOD) + msg);
+    }
+
+    public static void err(CommandSender to, String msg) {
+        to.sendMessage(prefix(to) + col(to, C_BAD) + msg);
+    }
+
+    public static void info(CommandSender to, String msg) {
+        to.sendMessage(prefix(to) + col(to, C_TEXT) + msg);
+    }
+}
diff --git a/src/main/java/dev/tachyon/world/VoidGenerator.java b/src/main/java/dev/tachyon/world/VoidGenerator.java
