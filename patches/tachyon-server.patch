+package dev.tachyon;
+
+/**
+ * Zentrale Stelle fuer das Branding von Tachyon.
+ * Zum Umbenennen reicht es, NAME zu aendern.
+ */
+public final class Tachyon {
+
+    /** Name, der im F3-Menue, in der Serverliste, bei /version und im Log erscheint. */
+    public static final String NAME = "Tachyon";
+
+    /** Minecraft-Version, auf der diese Tachyon-Version basiert. */
+    public static final String MC_VERSION = "26.3";
+
+    /**
+     * MOTD in der Serverliste (2 Zeilen, Minecraft-Farbcodes).
+     * Zeile 1: "Powered by TACHYON" mit Blitzen, Zeile 2: was Tachyon ausmacht.
+     */
+    public static final String DEFAULT_MOTD =
+            "\u00A7d\u00A7l\u26A1 \u00A7b\u00A7lPowered by \u00A7d\u00A7l" + NAME.toUpperCase(java.util.Locale.ROOT) + " \u00A7d\u00A7l\u26A1"
+            + "\n\u00A78\u00BB \u00A7aKeine Lags \u00A78\u2502 \u00A7bTurbo-Start \u00A78\u2502 \u00A7eWorld-Manager";
+
+    /** Unveraenderte Vanilla-MOTD (oder die alte schlichte Tachyon-MOTD) automatisch durch die Tachyon-MOTD ersetzen. */
+    public static String motd(String configured) {
+        if (configured == null || configured.isEmpty() || "A Minecraft Server".equals(configured) || ("Powered by " + NAME).equals(configured)) {
+            return DEFAULT_MOTD;
+        }
+        return configured;
+    }
+
+    private Tachyon() {
+    }
+}
diff --git a/src/main/java/dev/tachyon/console/TachyonConsole.java b/src/main/java/dev/tachyon/console/TachyonConsole.java
new file mode 100644
index 000000000..4653472cb
--- /dev/null
+++ b/src/main/java/dev/tachyon/console/TachyonConsole.java
@@ -0,0 +1,443 @@
+package dev.tachyon.console;
+
+import dev.tachyon.Tachyon;
+import java.io.PrintStream;
+import java.lang.management.ManagementFactory;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.StringJoiner;
+import java.util.concurrent.CountDownLatch;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.plugin.Plugin;
+
+/**
+ * Moderne Konsolenausgabe von Tachyon.
+ *
+ * Beim Start: Banner, EIN Ladebalken, der sich selbst aktualisiert, und keine INFO-Flut - nur Warnungen
+ * und Fehler erscheinen. Alles landet trotzdem vollstaendig in logs/latest.log. Am Ende eine Zusammenfassung.
+ * Danach normale (eingefaerbte) Log-Ausgabe.
+ *
+ * Kostet im laufenden Betrieb nichts: der Ladebalken existiert nur waehrend des Starts.
+ * Schalter: -Dtachyon.verboseStartup=true (altes ausfuehrliches Log), -Dtachyon.noColor=true (keine Farben).
+ */
+public final class TachyonConsole {
+
+    public static final String RESET = "\u001B[0m";
+    public static final String DIM = "\u001B[90m";
+    public static final String BOLD = "\u001B[1m";
+    public static final String CYAN = "\u001B[96m";
+    public static final String GREEN = "\u001B[92m";
+    public static final String YELLOW = "\u001B[93m";
+    public static final String RED = "\u001B[91m";
+    public static final String MAGENTA = "\u001B[95m";
+    public static final String BLUE = "\u001B[94m";
+    private static final String CLEAR_LINE = "\r\u001B[2K";
+
+    private static final String[] LOGO = {
+        " _____  _    ____ _   ___   _____  _   _ ",
+        "|_   _|/ \\  / ___| | | \\ \\ / / _ \\| \\ | |",
+        "  | | / _ \\| |   | |_| |\\ V / | | |  \\| |",
+        "  | |/ ___ \\ |___|  _  | | || |_| | |\\  |",
+        "  |_/_/   \\_\\____|_| |_| |_| \\___/|_| \\_|",
+    };
+    /** Farbverlauf Cyan -> Blau -> Magenta (256 Farben). */
+    private static final int[] GRADIENT = {51, 45, 39, 63, 135};
+
+    private static final PrintStream OUT = System.out; // vor jeder Umleitung durch Minecraft/Bukkit
+    private static final boolean COLOR = detectColor();
+    /** Echtes Terminal: Zeile kann ueberschrieben werden, Unicode/Farben moeglich. */
+    private static final boolean INTERACTIVE = COLOR;
+    private static final boolean VERBOSE = Boolean.getBoolean("tachyon.verboseStartup");
+    private static final String SEP = INTERACTIVE ? "  \u00B7  " : "  |  ";
+
+    private static final Object LOCK = new Object();
+    private static final CountDownLatch STARTUP_DONE = new CountDownLatch(1);
+    private static volatile boolean startupActive = true;
+    private static volatile boolean loggerMode;
+    private static String barLine = "";
+    private static String lastPhase = "";
+    private static int warnings;
+    private static int errors;
+
+    static {
+        if (VERBOSE) {
+            System.setProperty("tachyon.startupLevel", "INFO"); // vor der log4j-Initialisierung, siehe log4j2.xml
+        }
+    }
+
+    private TachyonConsole() {
+    }
+
+    private static org.apache.logging.log4j.Logger log() {
+        return org.apache.logging.log4j.LogManager.getLogger("Tachyon");
+    }
+
+    private static boolean detectColor() {
+        if (Boolean.getBoolean("tachyon.noColor") || System.getenv("NO_COLOR") != null) {
+            return false;
+        }
+        java.io.Console console = System.console();
+        if (console == null || !console.isTerminal()) {
+            return false; // Pipe / Hosting-Panel / Datei
+        }
+        if (!System.getProperty("os.name", "").toLowerCase(Locale.ROOT).contains("win")) {
+            return true;
+        }
+        // Windows: Windows Terminal (Standard unter Windows 11) und VS Code koennen ANSI immer
+        if (System.getenv("WT_SESSION") != null || "vscode".equals(System.getenv("TERM_PROGRAM")) || System.getenv("ANSICON") != null) {
+            return true;
+        }
+        // Klassisches Konsolenfenster (conhost): ANSI-Verarbeitung selbst einschalten
+        return enableWindowsVirtualTerminal();
+    }
+
+    /** Schaltet in der klassischen Windows-Konsole die ANSI-Verarbeitung ein (ENABLE_VIRTUAL_TERMINAL_PROCESSING). */
+    private static boolean enableWindowsVirtualTerminal() {
+        try {
+            com.sun.jna.platform.win32.Kernel32 kernel = com.sun.jna.platform.win32.Kernel32.INSTANCE;
+            com.sun.jna.platform.win32.WinNT.HANDLE out = kernel.GetStdHandle(com.sun.jna.platform.win32.Wincon.STD_OUTPUT_HANDLE);
+            com.sun.jna.ptr.IntByReference mode = new com.sun.jna.ptr.IntByReference();
+            if (!kernel.GetConsoleMode(out, mode)) {
+                return false;
+            }
+            int current = mode.getValue();
+            return (current & 0x0004) != 0 || kernel.SetConsoleMode(out, current | 0x0004);
+        } catch (Throwable t) {
+            return false; // kein JNA / keine echte Konsole: dann eben ohne Farben
+        }
+    }
+
+    private static String c(String code) {
+        return COLOR ? code : "";
+    }
+
+    private static double uptimeSeconds() {
+        return ManagementFactory.getRuntimeMXBean().getUptime() / 1000.0;
+    }
+
+    public static boolean isStartupActive() {
+        return startupActive && !VERBOSE;
+    }
+
+    // ------------------------------------------------------------------ Banner + Ladebalken
+
+    /** Ganz am Anfang, noch bevor Minecraft geladen wird. */
+    public static void banner() {
+        Runtime rt = Runtime.getRuntime();
+        OUT.println();
+        for (int i = 0; i < LOGO.length; i++) {
+            OUT.println("   " + (COLOR ? "\u001B[1;38;5;" + GRADIENT[i] + "m" : "") + LOGO[i] + c(RESET));
+        }
+        OUT.println();
+        OUT.println("   " + c(BOLD) + Tachyon.NAME + " " + Tachyon.MC_VERSION + c(RESET) + c(DIM)
+                + SEP + "Minecraft-Server ohne Lags" + SEP + "Java " + Runtime.version().feature()
+                + SEP + formatMb(rt.maxMemory()) + " RAM" + SEP + rt.availableProcessors() + " Threads" + c(RESET));
+        OUT.println();
+        progress(0.05, "Java gestartet");
+    }
+
+    /** Fortschritt melden (0..1). Im Terminal wird dieselbe Zeile ueberschrieben. */
+    public static void progress(double fraction, String label) {
+        if (VERBOSE) {
+            stepLine(fraction, label);
+            return;
+        }
+        if (!startupActive) {
+            return;
+        }
+        synchronized (LOCK) {
+            barLine = renderBar(fraction, label);
+            if (INTERACTIVE) {
+                OUT.print(CLEAR_LINE + barLine);
+                OUT.flush();
+            } else {
+                // Pipes/Panels koennen keine Zeile ueberschreiben: nur Hauptphasen als eigene Zeile
+                String phase = label.contains(":") ? label.substring(0, label.indexOf(':')) : label;
+                if (!phase.equals(lastPhase)) {
+                    lastPhase = phase;
+                    OUT.println(barLine);
+                }
+            }
+        }
+    }
+
+    /** Hauptphasen des Starts. */
+    public static void step(String name) {
+        double f = switch (name) {
+            case "Minecraft-Kern geladen" -> 0.35;
+            case "Konfiguration & Datapacks" -> 0.50;
+            case "Plugins geladen" -> 0.75;
+            case "Welten geladen" -> 0.97;
+            default -> 0.05;
+        };
+        progress(f, name);
+    }
+
+    /** Unterschritt innerhalb einer Phase, z.B. Plugin 3 von 12 (von..bis = Anteil am Gesamtbalken). */
+    public static void subProgress(double from, double to, int index, int total, String label) {
+        double f = total <= 0 ? to : from + (to - from) * index / (double) total;
+        progress(f, label);
+    }
+
+    private static String renderBar(double fraction, String label) {
+        int width = 30;
+        double f = Math.max(0, Math.min(1, fraction));
+        int filled = (int) Math.round(width * f);
+        String full = INTERACTIVE ? "\u2588" : "#";
+        String empty = INTERACTIVE ? "\u2591" : "-";
+        String text = label.length() > 42 ? label.substring(0, 41) + "~" : label;
+        return "   " + c(CYAN) + full.repeat(filled) + c(DIM) + empty.repeat(width - filled) + c(RESET)
+                + c(BOLD) + String.format(" %3d%%", Math.round(f * 100)) + c(RESET) + "  " + text
+                + c(DIM) + String.format(Locale.GERMANY, "  %.1f s", uptimeSeconds()) + c(RESET);
+    }
+
+    /** Ausfuehrlicher Modus: jede Phase als Log-Zeile. */
+    private static void stepLine(double fraction, String label) {
+        String line = String.format(Locale.GERMANY, "[%3d%%] %s (%.1f s)", Math.round(fraction * 100), label, uptimeSeconds());
+        if (loggerMode) {
+            log().info(line);
+        } else {
+            OUT.println("   " + line);
+        }
+    }
+
+    /**
+     * Vom Konsolen-Thread fuer jede Log-Zeile aufgerufen, solange der Start laeuft.
+     * @return true, wenn die Zeile hier behandelt wurde (INFO verschluckt, WARN/FEHLER ueber dem Balken ausgegeben)
+     */
+    public static boolean handleStartupLine(String raw, boolean color) {
+        if (!isStartupActive()) {
+            return false;
+        }
+        String[] p = raw.split("\t", 4);
+        String level = p.length >= 2 ? p[1] : "INFO";
+        boolean warn = level.equals("WARN");
+        boolean error = level.equals("ERROR") || level.equals("FATAL");
+        if (!warn && !error) {
+            return true; // INFO/DEBUG beim Start nur ins Logfile
+        }
+        synchronized (LOCK) {
+            if (warn) {
+                warnings++;
+            } else {
+                errors++;
+            }
+            String line = formatLine(raw, color).stripTrailing();
+            if (INTERACTIVE) {
+                OUT.print(CLEAR_LINE + line + System.lineSeparator() + barLine);
+            } else {
+                OUT.println(line);
+            }
+            OUT.flush();
+        }
+        return true;
+    }
+
+    /** Vom Konsolen-Thread, sobald er laeuft. */
+    public static void consoleReady() {
+        loggerMode = true;
+    }
+
+    /** Die Konsolen-Eingabe wartet, bis der Start fertig ist (sonst zerreisst der Prompt den Ladebalken). */
+    public static void awaitStartup() {
+        if (VERBOSE) {
+            return;
+        }
+        try {
+            STARTUP_DONE.await();
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+    }
+
+    /** Falls der Start abbricht oder der Server stoppt: Konsole wieder normal benutzen. */
+    public static void abortStartup() {
+        if (startupActive) {
+            synchronized (LOCK) {
+                if (INTERACTIVE && !VERBOSE) {
+                    OUT.println();
+                }
+                startupActive = false;
+            }
+            STARTUP_DONE.countDown();
+        }
+    }
+
+    // ------------------------------------------------------------------ Zusammenfassung
+
+    /** Nach "Done": Balken auf 100 %, dann Zusammenfassung, was geladen wurde. */
+    public static void ready(int port) {
+        progress(1.0, "Bereit");
+        double secs = uptimeSeconds();
+        Runtime rt = Runtime.getRuntime();
+
+        List<String> lines = new ArrayList<>();
+        lines.add(String.format(Locale.GERMANY, "%s %s ist bereit  -  gestartet in %.1f s", Tachyon.NAME.toUpperCase(Locale.ROOT), Tachyon.MC_VERSION, secs));
+        lines.add("");
+        lines.add("Port        " + port + SEP + Bukkit.getMaxPlayers() + " Slots" + SEP + (Bukkit.getOnlineMode() ? "Online-Modus" : "Offline-Modus")
+                + SEP + "Whitelist " + (Bukkit.hasWhitelist() ? "an" : "aus"));
+        StringJoiner worlds = new StringJoiner(", ");
+        for (World w : Bukkit.getWorlds()) {
+            worlds.add(w.getName());
+        }
+        lines.add("Welten      " + worlds);
+        Plugin[] plugins = Bukkit.getPluginManager().getPlugins();
+        if (plugins.length == 0) {
+            lines.add("Plugins     keine (World-Manager ist eingebaut: /wm)");
+        } else {
+            StringJoiner pl = new StringJoiner(", ");
+            int disabled = 0;
+            for (Plugin plugin : plugins) {
+                if (plugin.isEnabled()) {
+                    pl.add(plugin.getName() + " " + plugin.getDescription().getVersion());
+                } else {
+                    disabled++;
+                }
+            }
+            lines.add("Plugins     " + (plugins.length - disabled) + " aktiv" + (disabled > 0 ? ", " + disabled + " FEHLGESCHLAGEN" : ""));
+            for (String chunk : wrap(pl.toString(), 70)) {
+                lines.add("            " + chunk);
+            }
+        }
+        lines.add("System      Java " + Runtime.version().feature() + SEP + rt.availableProcessors() + " Threads" + SEP
+                + formatMb(rt.totalMemory() - rt.freeMemory()) + " von " + formatMb(rt.maxMemory()) + " RAM belegt");
+        String problems = (warnings == 0 && errors == 0) ? "keine Warnungen oder Fehler"
+                : warnings + " Warnung(en), " + errors + " Fehler (Details in logs/latest.log)";
+        lines.add("Start       " + problems);
+        lines.add("");
+        lines.add("Befehle     /wm  (Welten)" + SEP + "/tps" + SEP + "/stop");
+
+        int w = 0;
+        for (String l : lines) {
+            w = Math.max(w, l.length());
+        }
+        String h = (INTERACTIVE ? "\u2500" : "-").repeat(w + 2);
+        String v = INTERACTIVE ? "\u2502" : "|";
+        String border = (errors > 0) ? RED : (warnings > 0 ? YELLOW : GREEN);
+        String nl = System.lineSeparator();
+        StringBuilder sb = new StringBuilder();
+        sb.append(nl).append(nl);
+        sb.append("   ").append(c(border)).append(INTERACTIVE ? "\u250C" : "+").append(h).append(INTERACTIVE ? "\u2510" : "+").append(c(RESET)).append(nl);
+        for (int i = 0; i < lines.size(); i++) {
+            String l = lines.get(i);
+            String body = (i == 0) ? c(BOLD) + c(border) + l + c(RESET) : colorLabel(l);
+            sb.append("   ").append(c(border)).append(v).append(c(RESET)).append(' ').append(body).append(" ".repeat(w - l.length()))
+                    .append(' ').append(c(border)).append(v).append(c(RESET)).append(nl);
+        }
+        sb.append("   ").append(c(border)).append(INTERACTIVE ? "\u2514" : "+").append(h).append(INTERACTIVE ? "\u2518" : "+").append(c(RESET)).append(nl);
+
+        synchronized (LOCK) {
+            if (VERBOSE) {
+                for (String l : lines) {
+                    log().info(l);
+                }
+            } else {
+                OUT.print(sb);
+                OUT.flush();
+            }
+            startupActive = false;
+        }
+        STARTUP_DONE.countDown();
+    }
+
+    private static String colorLabel(String l) {
+        if (!COLOR || l.length() < 12 || l.isBlank()) {
+            return l;
+        }
+        String label = l.substring(0, 12);
+        String rest = l.substring(12);
+        if (rest.contains("FEHLGESCHLAGEN") || rest.contains(" Fehler (")) {
+            rest = YELLOW + rest + RESET;
+        }
+        return DIM + label + RESET + rest;
+    }
+
+    private static List<String> wrap(String text, int width) {
+        List<String> out = new ArrayList<>();
+        StringBuilder line = new StringBuilder();
+        for (String word : text.split(" ")) {
+            if (line.length() + word.length() + 1 > width && line.length() > 0) {
+                out.add(line.toString());
+                line.setLength(0);
+            }
+            if (line.length() > 0) {
+                line.append(' ');
+            }
+            line.append(word);
+        }
+        if (line.length() > 0) {
+            out.add(line.toString());
+        }
+        return out;
+    }
+
+    private static String formatMb(long bytes) {
+        long mb = bytes / (1024 * 1024);
+        return mb >= 1024 ? String.format(Locale.GERMANY, "%.1f GB", mb / 1024.0) : mb + " MB";
+    }
+
+    // ------------------------------------------------------------------ Einfaerben der Log-Zeilen (nach dem Start)
+
+    /**
+     * Formatiert eine Log-Zeile fuer die Konsole. raw = "HH:mm:ss\tLEVEL\tThread\tNachricht".
+     * Nur String-Operationen auf der fertigen Zeile, im Konsolen-Thread - der Server-Thread merkt davon nichts.
+     */
+    public static String formatLine(String raw, boolean color) {
+        String[] p = raw.split("\t", 4);
+        if (p.length < 4) {
+            return raw;
+        }
+        String time = p[0];
+        String level = p[1];
+        String thread = p[2];
+        String msg = p[3];
+        if (!color) {
+            return "[" + time + "] [" + thread + "/" + level + "]: " + msg; // klassisches Format (Pipes, Panels)
+        }
+        StringBuilder sb = new StringBuilder(msg.length() + 48);
+        sb.append(DIM).append(time).append(RESET).append(' ');
+        switch (level) {
+            case "WARN" -> sb.append(YELLOW).append(BOLD).append("WARN ").append(RESET);
+            case "ERROR", "FATAL" -> sb.append(RED).append(BOLD).append("FEHL ").append(RESET);
+            case "DEBUG", "TRACE" -> sb.append(DIM).append("DEBUG").append(RESET);
+            default -> sb.append(DIM).append("\u2502    ").append(RESET);
+        }
+        sb.append(' ');
+        if (!"Server thread".equals(thread)) {
+            sb.append(DIM).append('[').append(thread).append("] ").append(RESET);
+        }
+        sb.append(colorMessage(level, msg)).append(RESET);
+        return sb.toString();
+    }
+
+    private static String colorMessage(String level, String msg) {
+        if (level.equals("WARN")) {
+            return YELLOW + msg;
+        }
+        if (level.equals("ERROR") || level.equals("FATAL")) {
+            return RED + msg;
+        }
+        if (msg.startsWith("Done (")) {
+            return GREEN + BOLD + msg;
+        }
+        if (msg.contains(" joined the game")) {
+            return GREEN + "\u25B6 " + msg;
+        }
+        if (msg.contains(" left the game")) {
+            return YELLOW + "\u25C0 " + msg;
+        }
+        if (msg.contains(" issued server command: ")) {
+            return MAGENTA + msg;
+        }
+        if (msg.startsWith("[WorldManager]") || msg.startsWith("[Tachyon]")) {
+            int close = msg.indexOf(']');
+            return CYAN + BOLD + msg.substring(0, close + 1) + RESET + CYAN + msg.substring(close + 1);
+        }
+        if (msg.startsWith("<")) {
+            return BLUE + msg; // Chat
+        }
+        return msg;
+    }
+}
