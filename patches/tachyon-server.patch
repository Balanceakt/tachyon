+/**
+ * Tachyon World-Manager.
+ *
+ * Vanilla/Spigot erzeugt neue Welten komplett auf dem Main-Thread: Der Spawnpunkt wird
+ * in einer 11x11-Chunk-Spirale gesucht und jeder Chunk dabei synchron generiert. Waehrenddessen
+ * tickt der Server nicht, alle Spieler frieren ein.
+ *
+ * Der World-Manager legt die Welt sofort an (provisorischer Spawn, keine Chunk-Generierung auf
+ * dem Main-Thread) und sucht den Spawn danach Chunk fuer Chunk ueber Tickets - die eigentliche
+ * Generierung laeuft auf den Worldgen-Threads. Erst wenn der Spawnbereich fertig ist, gilt die
+ * Welt als "bereit" und wartende Teleports werden ausgefuehrt.
+ */
+public final class WorldManager {
+
+    public static final Pattern VALID_NAME = Pattern.compile("[A-Za-z0-9_\\-]{1,64}");
+    private static final int SPAWN_SEARCH_RADIUS = 5; // wie Vanilla: 11x11 Chunks
+    private static final int SPAWN_BATCH = 9; // so viele Kandidaten gleichzeitig generieren
+
+    private static WorldManager instance;
+    /** >0 solange der World-Manager selbst gerade createWorld aufruft (nur Main-Thread). */
+    private static int managerDepth;
+
+    private final Logger logger = Logger.getLogger("Tachyon");
+    private final File configFile;
+    private YamlConfiguration config;
+
+    private final Map<String, LoadState> states = new HashMap<>();
+    private final Set<ServerLevel> provisionalSpawn = Collections.newSetFromMap(new IdentityHashMap<>());
+    private final ConcurrentLinkedQueue<Runnable> mainQueue = new ConcurrentLinkedQueue<>();
+    private final Deque<String> autoloadQueue = new ArrayDeque<>();
+    private final ExecutorService io = Executors.newSingleThreadExecutor(r -> {
+        Thread t = new Thread(r, "Tachyon-World-IO");
+        t.setDaemon(true);
+        return t;
+    });
+
+    private static final boolean AOT_TRAINING = Boolean.getBoolean("tachyon.aotTraining");
+    private boolean started;
+    private int ticks;
+    private int trainingTicks;
+    private int liveTicks;
+    private int pausedTicks;
+
