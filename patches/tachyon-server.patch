+    private boolean fastForPlugins;
+    private boolean fastStartup;
+    private int preloadRadius;
+    private int autoloadInterval;
+    private int pregenParallel;
+    private int unloadIdleMinutes;
+    /** Welt -> Zeitpunkt, an dem zuletzt ein Spieler darin war (fuer das automatische Auslagern). */
+    private final Map<String, Long> lastOccupied = new HashMap<>();
+    private final Set<String> sleeping = new TreeSet<>();
+
